[sub_resource type="Shader" id="Shader_j8n6d"]
code = "shader_type spatial;\nrender_mode blend_mix, unshaded, cull_disabled, depth_prepass_alpha;\n\nuniform vec4 base_color : source_color = vec4(0.02, 0.04, 0.08, 0.08);\nuniform vec4 minor_line_color : source_color = vec4(0.20, 0.78, 1.00, 0.22);\nuniform vec4 major_line_color : source_color = vec4(0.82, 0.98, 1.00, 0.62);\nuniform float minor_cells = 90.0;\nuniform float major_every = 6.0;\nuniform float minor_width = 1.0;\nuniform float major_width = 2.2;\nuniform float emission_strength = 0.65;\n\nfloat grid_line_mask(vec2 uv, float cells, float line_width) {\n\tvec2 scaled_uv = uv * max(cells, 1.0);\n\tvec2 grid = abs(fract(scaled_uv - 0.5) - 0.5) / fwidth(scaled_uv);\n\tfloat line = min(grid.x, grid.y);\n\treturn 1.0 - clamp(line / line_width, 0.0, 1.0);\n}\n\nvoid fragment() {\n\tfloat minor_mask = grid_line_mask(UV, minor_cells, minor_width);\n\tfloat major_mask = grid_line_mask(UV, minor_cells / max(major_every, 1.0), major_width);\n\tfloat line_mask = clamp(max(minor_mask * 0.7, major_mask), 0.0, 1.0);\n\n\tvec3 color = mix(base_color.rgb, minor_line_color.rgb, minor_mask * 0.65);\n\tcolor = mix(color, major_line_color.rgb, major_mask);\n\n\tALBEDO = color;\n\tEMISSION = mix(minor_line_color.rgb, major_line_color.rgb, major_mask) * line_mask * emission_strength;\n\tALPHA = clamp(base_color.a + minor_mask * minor_line_color.a + major_mask * major_line_color.a, 0.0, 0.9);\n}"

