[sub_resource type="GDScript" id="GDScript_init"]
script/source = "extends Node

# Initialize the grid when the scene loads

func _ready():
	await get_tree().process_frame

	var grid_root = get_node('../GridRoot')
	var grid_structure = grid_root.get_node('GridStructure')
	var base_cube = grid_root.get_node('BaseCube')

	# Initialize the grid structure component
	var settings = {
		'cube_size': 1.0,
		'gutter': 0.1
	}
	grid_structure.initialize(grid_root, base_cube, settings)

	# Create a simple test grid structure
	var structure_data = create_test_structure()
	var dimensions = Vector3i(11, 3, 11)

	grid_structure.generate_structure(structure_data, dimensions)
	print('Grid initialized with %d cubes' % grid_structure.get_cube_count())

func create_test_structure():
	# Create an 11x11 grid pattern
	var layout = []
	for z in range(11):
		var row = []
		for x in range(11):
			# Create a simple pattern: height varies by position
			var height = 1 + int((x + z) % 3)
			row.append(height)
		layout.append(row)

	return {
		'layout_data': layout
	}
"
