class_name ModularComposite
extends Node3D
## The modular class system's one artifact: a thing built from an expression.
##
## 2026-10-23, Palle: "build a modular class system for everything … and the
## reason for this is also to sculpt out the tutorial path." Every term in
## commons/modular/terms.json is an expression over primitives (point, mesh,
## collider, body, grabbable, label, light) and other terms, joined by operators
## (compose, associate, times, array, assemblage, engine, transform). This node
## reads a term name — from its `term` export, from the registry's default_params
## (`config_term` meta / apply_grid_config), or from its lookup name `mod_<term>` —
## and builds the expression with ModularBuilder at ready. The same terms.json is
## read by the web tree (/knowledge-tree) and by tools/modular_path.py, which turns
## the derivation order into the tutorial path. One source, three renderers.
##
## Registry tokens are `mod_<term>` (commons/artifacts/registry/modular.json,
## generated by tools/build_modular_registry.py), so the Void's builder, the grid
## maps and the wrist spawn menu can place any term without a scene per term.

const TERMS_PATH := "res://commons/modular/terms.json"
const Builder := preload("res://commons/modular/builder.gd")

static var _terms_cache: Dictionary = {}

@export var term: String = ""
## A JSON expression, used instead of `term` when not empty (an unnamed thing).
@export_multiline var expression: String = ""
## Keep the scaffold (the parents a thing was built from and no longer needs: the
## line inside a tape). Off: only the intended thing stands, as Palle asked.
@export var show_construction: bool = false

var built: Node3D = null


static func terms() -> Dictionary:
	if _terms_cache.is_empty():
		if FileAccess.file_exists(TERMS_PATH):
			var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(TERMS_PATH))
			if parsed is Dictionary:
				_terms_cache = (parsed as Dictionary).get("terms", {})
		if _terms_cache.is_empty():
			push_error("modular: no terms at " + TERMS_PATH)
	return _terms_cache


static func term_names() -> Array:
	return terms().keys()


## The grid / Void configuration channel: `#term:tape` on a map token, or the
## registry's default_params {term}. Rebuilds when already in the tree.
## The scaffold is a leak: what the construction removes when it is done (the line inside the
## tape). Named on the LeakData bus — kind "scaffold", the removed parts' local positions —
## and never counted, as that bus insists. Silent when the bus is not running (a probe).
func _spill_scaffold(scaffold: Array) -> void:
	if scaffold.is_empty():
		return
	var bus: Node = get_node_or_null("/root/LeakData")
	if bus == null or not bus.has_method("spill"):
		return
	var points: Array = []
	for sc in scaffold:
		if sc is Node3D:
			points.append((sc as Node3D).position)
			for c in (sc as Node).get_children():
				if c is Node3D:
					points.append((sc as Node3D).position + (c as Node3D).position)
	var room: String = str(get_meta("map_name", "")) if has_meta("map_name") else ""
	bus.call("spill", room, "composite.scaffold:" + (term if expression.is_empty() else "expression"), "scaffold", points)


func apply_grid_config(config: Dictionary) -> void:
	if config.has("term"):
		term = str(config["term"])
	if config.has("expression"):
		expression = str(config["expression"])
	if config.has("show_construction"):
		show_construction = bool(config["show_construction"])
	if is_inside_tree():
		rebuild()


func _ready() -> void:
	if term == "" and expression == "":
		if has_meta("config_term"):
			term = str(get_meta("config_term"))
		elif has_meta("artifact_lookup_name"):
			term = str(get_meta("artifact_lookup_name")).trim_prefix("mod_")
	if built == null:
		rebuild()


func rebuild() -> void:
	if built != null and is_instance_valid(built):
		built.queue_free()
		built = null
	var expr: Dictionary = {}
	if expression != "":
		var parsed: Variant = JSON.parse_string(expression)
		if parsed is Dictionary:
			expr = parsed
		else:
			push_error("modular: expression is not a JSON object")
	elif term != "":
		expr = {"t": term}
	if expr.is_empty():
		return
	built = Builder.build(expr, terms())
	built.name = "Built"
	if not show_construction:
		var scaffold: Array = Builder.scaffold_of(built)
		_spill_scaffold(scaffold)
		for sc in scaffold:
			(sc as Node).free()
	add_child(built)
	set_meta("modular_term", term)


## What this thing is made of, for the panel, the probe and the scanner.
func describe() -> Dictionary:
	var meshes := 0
	var colliders := 0
	var bodies := 0
	var labels := 0
	var terms_used: Array = []
	if built != null:
		for n in _all(built):
			if n is MeshInstance3D:
				meshes += 1
			elif n is CollisionShape3D:
				colliders += 1
			elif n is PhysicsBody3D or n is Area3D:
				bodies += 1
			elif n is Label3D:
				labels += 1
			if n.has_meta("term") and not (str(n.get_meta("term")) in terms_used):
				terms_used.append(str(n.get_meta("term")))
	return {"term": term, "meshes": meshes, "colliders": colliders, "bodies": bodies, "labels": labels, "terms": terms_used}


func _all(n: Node) -> Array:
	var out: Array = [n]
	for c in n.get_children():
		out.append_array(_all(c))
	return out
