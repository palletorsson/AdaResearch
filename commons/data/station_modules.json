  "_note": "R-018: meetings as a curated layer. Treatments applied automatically wherever two classes touch \u2014 the joint is the generator of form.",
  "artifact_on_footing": {
   "treatment": "reveal",
   "cap_inset": 0.1,
   "_why": "the shadow gap \u2014 the exhibit ends 10cm before its cap edge"
  },
  "wall_on_floor": {
   "treatment": "skirting",
   "piece": "station_floorline",
   "style": "threshold",
   "_why": "the skirting line \u2014 the wall's ending read at the floor"
  },
  "station_on_aisle": {
   "treatment": "zone_edge",
   "piece": "station_floorline",
   "style": "line",
   "z": 2.8,
   "_why": "the lit line where the station ENDS before it stops existing"
  },
  "wall_on_wall": {
   "treatment": "seam_pillar",
   "piece": "station_pillar",
   "_why": "the reveal between plates"
  },
  "body_on_cell": {
   "treatment": "center",
   "_why": "R-019: artifacts seat by measured BODY centre, not code origin \u2014 the meet is between the thing you SEE and the cap it stands on"
  },
  "pole_on_floor": {
   "treatment": "foot",
   "_why": "R-019: no pole enters the floor bare \u2014 a foot articulates the meet, and it must READ above stage lips and plinth bases"
  }
