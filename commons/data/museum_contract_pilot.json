{
  "schema": "adaresearch.museum_contract_pilot.v1",
  "title": "Endless Museum Contract Pilot",
  "description": "Twelve featured artifacts negotiated against one-metre floor and wall modules. Hard safety rules win; preferences are optimized and every compromise is reported.",
  "units": "metres",
  "grid": {
    "tile_m": 1,
    "base_width_cells": 15,
    "minimum_through_route_cells": 3,
    "wall_height_m": 4,
    "section_gap_cells": 2,
    "maximum_width_cells": 25
  },
  "layer_contracts": {
    "artifact": {
      "goal": "Give every object enough physical, interaction, and viewing space in both island and wall postures.",
      "owns": ["body envelope", "sweep envelope", "directional clearance", "allowed postures"],
      "hard_rules": ["body remains inside the room", "required interaction sides stay reachable", "sweep never enters the through-route"],
      "offers": ["preferred posture", "viewing distance", "rear overlap allowance"]
    },
    "order": {
      "goal": "Keep one readable main sequence while exposing lineage and DNA relations.",
      "owns": ["main index", "relation to prior artifact", "DNA axes"],
      "hard_rules": ["main indices are unique", "a relation target precedes its child"],
      "offers": ["side-by-side pairing", "same-side continuity"]
    },
    "floorplan": {
      "goal": "Preserve a continuous accessible route and expand only when artifact contracts require it.",
      "owns": ["one-metre grid", "walls", "through-route", "section bounds"],
      "hard_rules": ["route is at least three cells wide", "spawn connects to exit", "walls stay on the one-metre grid"],
      "offers": ["room width", "section depth", "left or right bay"]
    },
    "props": {
      "goal": "Reserve the wall centre for map text and feature imagery while placing support props at usable heights.",
      "owns": ["wall elevation bands", "feature field", "side rails"],
      "hard_rules": ["feature field remains unobstructed", "interactive controls stay between 0.75 and 1.35 metres"],
      "offers": ["left rail", "right rail", "upper band"]
    },
    "museum": {
      "goal": "Compile tested modules into a confident, repeatable endless museum segment.",
      "owns": ["module boundaries", "entry and exit interfaces", "validation gates"],
      "hard_rules": ["all hard gates pass before release", "module entry and exit align to the through-route"],
      "offers": ["bay repetition", "material and lighting treatment"]
    },
    "book": {
      "goal": "Let the visitor's written account and the current map content inhabit the same exhibition.",
      "owns": ["chapter order", "monitor content", "visitor voice"],
      "hard_rules": ["monitor content names the current artifact and relation", "text does not replace interaction space"],
      "offers": ["caption length", "monitor size", "chapter pacing"]
    }
  },
  "negotiation": {
    "priority": ["safety", "reachability", "route continuity", "lineage order", "view quality", "compactness"],
    "determinism": "Same contracts and solver version always produce the same plan.",
    "failure_policy": "Never silently squeeze an artifact. Expand, change an offered posture, or fail with a named gate."
  },
  "wall_system": {
    "feature_field": {"horizontal_percent": [20, 80], "vertical_m": [1.1, 2.3]},
    "prop_rails": {"horizontal_percent": [[0, 18], [82, 100]], "vertical_m": [0.75, 2.3]},
    "low_band_m": [0, 1.1],
    "eye_band_m": [1.1, 2.3],
    "upper_band_m": [2.3, 4]
  },
  "artifacts": [
