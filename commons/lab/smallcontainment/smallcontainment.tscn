[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node3D
# OPTIMIZED: Replaced 7 OmniLights with emissive materials
# Uses single _process for all animations instead of multiple tweens

@onready var containment_walls = [$CubeStructure/BackWall, $CubeStructure/LeftWall, $CubeStructure/RightWall, $CubeStructure/TopWall, $CubeStructure/StaticBody3D/BottomWall]
@onready var contained_specimen = $CubeStructure/ContainedSpecimen
@onready var energy_field = $CubeStructure/EnergyField
@onready var status_visuals: Array[MeshInstance3D] = [$CubeStructure/StatusVisual1, $CubeStructure/StatusVisual2, $CubeStructure/StatusVisual3]
@onready var projector_visuals: Array[MeshInstance3D] = [$CubeStructure/ProjectorVisual1, $CubeStructure/ProjectorVisual2, $CubeStructure/ProjectorVisual3, $CubeStructure/ProjectorVisual4]

# Cached materials for performance
var status_materials: Array[StandardMaterial3D] = []
var projector_materials: Array[StandardMaterial3D] = []
var energy_field_material: StandardMaterial3D
var specimen_material: StandardMaterial3D

var containment_active = true
var specimen_type = 'anomalous_sample'
var field_strength = 100.0
var containment_breach_risk = 0.0

# Animation state
var time_accumulator: float = 0.0
var specimen_float_phase: float = 0.0
var monitor_timer: float = 0.0
const MONITOR_INTERVAL: float = 2.0

signal containment_stabilized
signal breach_warning
signal specimen_contained
signal field_fluctuation

func _ready():
	cache_materials()
	setup_containment_cube()

func cache_materials():
	# Cache all materials once at startup
	for visual in status_visuals:
		if visual and visual.material_override:
			status_materials.append(visual.material_override as StandardMaterial3D)
	
	for visual in projector_visuals:
		if visual and visual.material_override:
			projector_materials.append(visual.material_override as StandardMaterial3D)
	
	if energy_field and energy_field.material_override:
		energy_field_material = energy_field.material_override as StandardMaterial3D
	
	if contained_specimen and contained_specimen.material_override:
		specimen_material = contained_specimen.material_override as StandardMaterial3D

func setup_containment_cube():
	add_to_group('desk_equipment')
	add_to_group('containment_devices')
	add_to_group('specimen_storage')

func _process(delta: float):
	time_accumulator += delta
	
	# Animate field projectors (emissive pulsing)
	for i in range(projector_materials.size()):
		var phase_offset = i * (PI / 2.0)
		var intensity = sin(time_accumulator * 2.0 + phase_offset) * 0.5 + 1.5
		projector_materials[i].emission_energy_multiplier = intensity * (field_strength / 100.0)
	
	# Animate specimen float
	if contained_specimen.visible:
		specimen_float_phase += delta * 0.5
		contained_specimen.position.y = sin(specimen_float_phase) * 0.02
		contained_specimen.rotation.y += delta * 0.5
	
	# Monitor containment (replaces Timer)
	monitor_timer += delta
	if monitor_timer >= MONITOR_INTERVAL:
		monitor_timer = 0.0
		monitor_containment_integrity()

func monitor_containment_integrity():
	field_strength += randf_range(-5.0, 2.0)
	field_strength = clamp(field_strength, 60.0, 100.0)
	containment_breach_risk = (100.0 - field_strength) / 100.0
	
	update_energy_field_visuals()
	
	if field_strength < 75.0:
		trigger_breach_warning()
	elif field_strength < 85.0:
		emit_signal('field_fluctuation', field_strength)

func update_energy_field_visuals():
	if not energy_field_material:
		return
	
	var field_alpha = (field_strength / 100.0) * 0.4
	energy_field_material.albedo_color.a = field_alpha
	
	if field_strength > 90.0:
		energy_field_material.emission = Color.CYAN
	elif field_strength > 75.0:
		energy_field_material.emission = Color.YELLOW
	else:
		energy_field_material.emission = Color.RED
	
	energy_field_material.emission_energy_multiplier = 1.5 if field_strength >= 80.0 else 2.5

func trigger_breach_warning():
	emit_signal('breach_warning', containment_breach_risk)
	
	# Flash status indicators via emission
	for mat in status_materials:
		mat.emission = Color.RED if fmod(time_accumulator, 0.4) < 0.2 else Color.BLUE

func analyze_contained_specimen():
	print('🔍 CONTAINMENT CUBE: Analyzing specimen properties...')
	print('  Specimen Type: %s' % specimen_type)
	print('  Field Strength: %.1f%%' % field_strength)
	print('  Breach Risk: %.1f%%' % (containment_breach_risk * 100))
	print('  Containment Status: %s' % ('STABLE' if field_strength > 85.0 else 'UNSTABLE'))

func reinforce_containment_field():
	field_strength = 100.0
	containment_breach_risk = 0.0
	emit_signal('containment_stabilized')

func emergency_containment_protocol():
	field_strength = 100.0
	for mat in projector_materials:
		mat.emission = Color.WHITE
		mat.emission_energy_multiplier = 3.0

func change_specimen(new_specimen_type: String, specimen_color: Color):
	specimen_type = new_specimen_type
	if specimen_material:
		specimen_material.emission = specimen_color
		specimen_material.albedo_color = specimen_color
	emit_signal('specimen_contained', specimen_type)

func toggle_containment_access():
	if containment_active:
		field_strength *= 0.7
	else:
		field_strength = 100.0
	containment_active = not containment_active
"

