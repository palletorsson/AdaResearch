{
	"rack_info": {
		"name": "Basic Synth Rack",
		"description": "Simple synthesizer control interface with frequency, amplitude, and duration controls",
		"version": "1.0",
		"sound_type": "basic_sine_wave"
	},
	"layout": {
		"col_spacing": 0.22,
		"row_spacing": 0.1,
		"hide_selection": true,
		"hide_buttons": true
	},
	"grid": [
		[
			"sl_1", "slider_pan"
		]
	],
	"control_definitions": {
		"sl_1": {
			"type": "slider",
			"label": "Frequency",
			"parameter": "freq",
			"min": 200.0,
			"max": 1000.0,
			"default": 440.0
		},
		"slider_pan": {
			"row": 0,
			"col": 1,
			"type": "slider_horizontal",
			"label": "Pan",
			"parameter": "pan",
			"min": -1.0,
			"max": 1.0,
			"default": 0.0
		}
	}
}
