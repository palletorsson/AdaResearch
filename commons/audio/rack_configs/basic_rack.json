{
	"rack_info": {
		"name": "Basic Synth Rack",
		"description": "Simple synthesizer control interface with frequency, amplitude, and duration controls",
		"version": "1.0",
		"sound_type": "basic_sine_wave"
	},
	"layout": {
		"col_spacing": 0.22,
		"row_spacing": 0.1
	},
	"grid": [
		["sl_1", "nb_1"],
		["sl_2", ""]
	],
	"control_definitions": {
		"sl_1": {
			"type": "slider",
			"label": "Frequency",
			"parameter": "freq",
			"min": 20.0,
			"max": 2000.0,
			"default": 440.0
		},
		"nb_1": {
			"type": "knob",
			"label": "Amplitude",
			"parameter": "amp",
			"min": 0.0,
			"max": 1.0,
			"default": 0.5
		},
		"sl_2": {
			"type": "slider",
			"label": "Duration",
			"parameter": "duration",
			"min": 0.1,
			"max": 5.0,
			"default": 1.0
		}
	}
}
