{
    "description": "Space Station Isolation with lo-fi beats - deep space vibes with subtle 808 bass and hi-hats",
    "category": "sci_fi_lofi_beats",
    "continuous_layers": [
        {
            "sound_id": "techno_noir.drone",
            "volume_db": -20,
            "bus": "Ambient",
            "parameters": {
                "base_freq": 30.0
            }
        },
        {
            "sound_id": "techno_noir.city_ambience",
            "volume_db": -26,
            "bus": "Ambient",
            "parameters": {
                "traffic_density": 0.1
            }
        },
        {
            "sound_id": "AudioSynthesizer.DARK_808_SUB_BASS",
            "volume_db": -18,
            "bus": "Bass"
        }
    ],
    "random_events": [
        {
            "sound_pool": [
                "house_drums.909_kick"
            ],
            "interval_range": [
                2.0,
                5.0
            ],
            "volume_range": [
                -20,
                -14
            ],
            "bus": "Kicks"
        },
        {
            "sound_pool": [
                "house_drums.909_hihat_closed"
            ],
            "interval_range": [
                0.8,
                2.0
            ],
            "volume_range": [
                -26,
                -20
            ],
            "bus": "HiHats"
        },
        {
            "sound_pool": [
                "techno_noir.static_burst",
                "techno_noir.mechanical_whir"
            ],
            "interval_range": [
                15.0,
                45.0
            ],
            "volume_range": [
                -28,
                -20
            ],
            "bus": "Effects"
        }
    ],
    "buses": {
        "Ambient": {
            "effects": [
                {
                    "type": "Reverb",
                    "room_size": 1.0,
                    "wet": 0.7
                },
                {
                    "type": "LowPassFilter",
                    "cutoff_hz": 800
                }
            ]
        },
        "Bass": {
            "effects": [
                {
                    "type": "LowPassFilter",
                    "cutoff_hz": 100
                }
            ]
        },
        "Kicks": {
            "effects": [
                {
                    "type": "Distortion",
                    "mode": 0,
                    "drive": 0.1
                }
            ]
        },
        "HiHats": {
            "effects": [
                {
                    "type": "HighPassFilter",
                    "cutoff_hz": 3000
                }
            ]
        },
        "Effects": {
            "effects": [
                {
                    "type": "Delay",
                    "dry": 0.7,
                    "tap1_delay_ms": 1200,
                    "tap1_level_db": -6.0
                },
                {
                    "type": "Reverb",
                    "room_size": 0.9,
                    "wet": 0.5
                }
            ]
        }
    }
}