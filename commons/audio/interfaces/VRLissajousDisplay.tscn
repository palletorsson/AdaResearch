[sub_resource type="GDScript" id="GDScript_controller"]
script/source = "extends Node3D

## VR Lissajous Display - 3D wrapper for Lissajous figure visualization
## Shows parametric XY plot of two frequency components

@export var display_name: String = \"LISSAJOUS\"

@onready var viewport: SubViewport = $LissajousViewport
@onready var screen_mesh: MeshInstance3D = $ScreenMesh
@onready var lissajous_display: Control = $LissajousViewport/LissajousDisplay

var _parent_controller = null

func _ready():
	# Connect viewport texture to screen mesh
	if viewport and screen_mesh:
		var material = screen_mesh.material_override as StandardMaterial3D
		if material:
			material.albedo_texture = viewport.get_texture()
			material.emission_texture = viewport.get_texture()
	
	# Set name label
	var label = get_node_or_null(\"Chassis/LabelName\")
	if label:
		label.text = display_name

func set_frequency_x(freq: float):
	\"\"\"Set X-axis frequency (e.g., start_freq)\"\"\"
	if lissajous_display and lissajous_display.has_method(\"set_frequency_x\"):
		lissajous_display.set_frequency_x(freq)

func set_frequency_y(freq: float):
	\"\"\"Set Y-axis frequency (e.g., end_freq)\"\"\"
	if lissajous_display and lissajous_display.has_method(\"set_frequency_y\"):
		lissajous_display.set_frequency_y(freq)

func set_frequencies(freq1: float, freq2: float):
	\"\"\"Set both frequencies at once\"\"\"
	if lissajous_display and lissajous_display.has_method(\"set_frequencies\"):
		lissajous_display.set_frequencies(freq1, freq2)

func set_param_name(text: String):
	\"\"\"Set the display label\"\"\"
	display_name = text
	var label = get_node_or_null(\"Chassis/LabelName\")
	if label:
		label.text = text

func connect_to_controller(controller):
	\"\"\"Connect to UVAC for parameter updates\"\"\"
	_parent_controller = controller
"

