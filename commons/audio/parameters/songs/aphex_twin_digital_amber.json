                "dynamics": 0.45,
                "progression": "system_awakening",
                "techniques": ["element_addition", "rhythmic_emergence"]
            },
            "complex_a": {
                "bars": 24,
                "time_range": "1:20-2:20",
                "description": "Full consciousness. Breakbeats slice and reform. Acid bass squelches. Lead melody appears - beautiful and slightly wrong.",
                "instruments": ["kick", "snare", "hihat", "breakbeat", "bass_acid", "pad_warm", "lead_detuned", "texture_noise"],
                "dynamics": 0.7,
                "progression": "memory_loop",
                "techniques": ["polyrhythmic_layering", "filter_sweeps", "micro_edits"]
            },
            "breakdown": {
                "bars": 16,
                "time_range": "2:20-3:00",
                "description": "The machine pauses. Remembers. Piano solo over granular pads. Ghostly vocal samples. The heart exposed.",
                "instruments": ["piano_prepared", "pad_granular", "vocal_ghostly", "strings_processed", "texture_field"],
                "dynamics": 0.35,
                "progression": "digital_amber_main",
                "techniques": ["beat_drop", "reverb_swell", "intimate_space"]
            },
            "complex_b": {
                "bars": 32,
                "time_range": "3:00-4:20",
                "description": "Evolution. The beat returns transformed. New patterns, denser textures. The melody develops, counterpoint emerges.",
                "instruments": ["kick", "snare", "hihat", "breakbeat_evolved", "bass_melodic", "pad_choir", "lead_bell", "arpeggio", "sequence"],
                "dynamics": 0.8,
                "progression": ["memory_loop", "transcendence"],
                "techniques": ["metric_modulation", "timbral_evolution", "call_and_response"]
            },
            "peak": {
                "bars": 16,
                "time_range": "4:20-5:00",
                "description": "Transcendence. Everything playing. Maximum emotional density. The moment where data becomes feeling. Then... release.",
                "instruments": ["all"],
                "dynamics": 0.95,
                "progression": "transcendence",
                "techniques": ["full_density", "harmonic_climax", "rhythmic_intensification", "sudden_strip"]
            },
            "outro": {
                "bars": 24,
                "time_range": "5:00-6:00",
                "description": "Saving state. Elements fade one by one. The melody echoes, processed beyond recognition. Tape hiss returns. Silence approaches. The amber hardens.",
                "instruments": ["pad_warm_filtered", "texture_tape_hiss", "strings_processed", "piano_distant", "texture_vinyl"],
                "dynamics": 0.2,
                "progression": "saving_state",
                "techniques": ["filter_closing", "element_subtraction", "reverb_tail", "tape_stop"]
            }
        }
    },

