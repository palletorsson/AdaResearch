    "technical_notes": {
        "performance_hints": [
            "Use tempo drift during ambient sections for organic feel",
            "Automate filter cutoffs continuously - never static",
            "Ghost notes should be felt more than heard",
            "Breakbeats need micro-timing variations, not just swing",
            "Layer reverbs: short room + long hall for depth",
            "Detuning should be random per note, not static",
            "Granular sections benefit from modulated grain size"
        ],
        "authenticity_checks": [
            "Does it sound like it was made on equipment that loves you?",
            "Can you hear the person behind the machine?",
            "Is there beauty hiding in the complexity?",
            "Would RDJ nod approvingly or smirk at the attempt?",
            "Does it make you feel something unexpected?"
