    "_metadata": {
        "sound_type": "aphex_twin_digital_amber",
        "display_name": "Digital Amber",
        "description": "Capturing moments in silicon - the warmth of Selected Ambient Works meets the complexity of Syro. A meditation on memory, impermanence, and the ghost in the machine.",
        "category": "songs",
        "tags": ["aphex_twin", "idm", "ambient", "breakbeat", "emotional", "complex", "full_song", "interactive", "masterpiece"],
        "is_interactive_song": true,
        "reference_artists": ["Aphex Twin", "Boards of Canada", "Autechre", "u-ziq"],
        "reference_tracks": ["Xtal", "Avril 14th", "Alberto Balsalm", "minipops 67", "Stone In Focus", "CIRCLONT6A", "Aisatsana"],
        "concept": "A digital consciousness reflecting on the moments it has preserved - each section a different facet of synthetic memory"
    },

    "identity": {
        "emotion": "melancholic_wonder",
        "era": "timeless_rdj",
        "character": ["warm", "complex", "intimate", "transcendent", "slightly_unsettling"],
        "narrative": {
            "intro": "Waking from a digital sleep, fragments of memory coalescing",
            "build": "The system comes online, routines initializing one by one",
            "complex": "Full consciousness - processing multiple streams, beautiful chaos",
            "breakdown": "A moment of vulnerability - the machine remembers being human",
            "peak": "Transcendence - when data becomes feeling",
            "outro": "Saving state... the amber hardens around the moment"
        }
    },

