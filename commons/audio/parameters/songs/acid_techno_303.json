            "distortion": {
                "enabled": true,
                "type": "tape_saturation",
                "amount": 0.2,
                "target": "master",
                "notes": "glue everything together"
            }
        }
    },
    "pro_acidline_formula": {
        "description": "The secret to pro acidlines - it's all about accent and slide placement",
        "rules": {
            "rule_1": {
                "name": "accent_on_downbeats",
                "description": "Place accents on beats 1 and 3 (steps 1, 9) for driving feel"
            },
            "rule_2": {
                "name": "slide_into_accents",
                "description": "Slide INTO accented notes from the previous step - creates the pull"
            },
            "rule_3": {
                "name": "octave_jumps_on_accents",
                "description": "Accented notes often jump up an octave - instant energy"
            },
            "rule_4": {
                "name": "rests_create_tension",
                "description": "Strategic rests (ties) before accented notes build anticipation"
            },
            "rule_5": {
                "name": "root_fifth_relationship",
                "description": "Patterns often alternate between root and fifth for harmonic movement"
            },
            "rule_6": {
                "name": "filter_follows_accent",
                "description": "Accent boosts filter envelope - accented notes are brighter/squelchier"
            }
        },
        "golden_pattern": {
            "description": "The classic techno acid pattern structure",
            "principle": "Accent + Slide + Octave jump = SQUELCH",
            "example": "Note low, slide up into accented high note = maximum acid"
        }
    },
    "pattern_templates": {
        "hardfloor_classic": {
            "description": "The Acperience-style rolling pattern - relentless 16ths, octave jumps",
            "steps": 16,
            "notes":   ["A1", "A1", "A2", "A1", "A1", "E1", "A2", "A1", "A1", "A1", "A2", "E1", "A1", "E1", "A2", "A1"],
            "slides":  [false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false],
            "accents": [true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false],
            "notes_text": "constant 16ths, accent every other beat, slide into octave jumps"
        },
        "driving_minimal": {
            "description": "Sparse pattern with maximum impact - less is more",
            "steps": 16,
            "notes":   ["A1", "--", "--", "A1", "A2", "--", "--", "A1", "--", "--", "A1", "--", "A2", "--", "A1", "--"],
            "slides":  [false, false, false, false, true, false, false, false, false, false, false, false, true, false, false, false],
            "accents": [true, false, false, false, true, false, false, false, false, false, true, false, true, false, false, false],
            "notes_text": "rests create tension, accents punch through"
        },
        "squelch_machine": {
            "description": "Maximum filter workout - the filter IS the melody",
            "steps": 16,
            "notes":   ["A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1", "A1"],
            "slides":  [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false],
            "accents": [true, false, false, true, false, false, true, false, true, false, false, true, false, false, true, false],
            "notes_text": "single note, accents do ALL the work - pure filter manipulation"
        },
        "counter_rhythm": {
            "description": "For the second 303 - syncopated against main line",
            "steps": 16,
            "notes":   ["--", "E1", "--", "E1", "--", "--", "A1", "--", "--", "E1", "--", "E1", "--", "--", "A1", "E1"],
            "slides":  [false, false, false, false, false, false, true, false, false, false, false, false, false, false, true, false],
            "accents": [false, false, false, true, false, false, true, false, false, false, false, true, false, false, true, false],
            "notes_text": "fills the gaps, creates call-and-response"
        },
        "emmanuel_top_style": {
            "description": "Turkish Bazar-inspired - melodic acid with Eastern flavor",
            "steps": 16,
            "notes":   ["A1", "--", "B1", "C2", "--", "B1", "A1", "--", "G#1","--", "A1", "B1", "--", "A1", "G#1","A1"],
            "slides":  [false, false, true, false, false, true, false, false, false, false, true, false, false, true, false, false],
            "accents": [true, false, false, true, false, false, true, false, true, false, false, true, false, false, true, false],
            "notes_text": "minor scale movement, slides create the Eastern feel"
        }
    },
