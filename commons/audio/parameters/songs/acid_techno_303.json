                "notes": "light drive for presence"
            }
        },
        "acid_bass_2": {
            "enabled": true,
            "type": "tb303",
            "role": "counter_line",
            "waveform": "square",
            "filter": {
                "type": "lowpass_18db",
                "cutoff_hz": { "min": 200, "max": 800, "value": 400 },
                "resonance": { "min": 0.65, "max": 0.85, "value": 0.75 },
                "env_mod": { "min": 0.5, "max": 0.8, "value": 0.65 },
                "decay_ms": { "min": 100, "max": 250, "value": 180 }
            },
            "accent": {
                "enabled": true,
                "amount": 0.5
            },
            "slide": {
                "enabled": true,
                "speed": 0.18
            },
            "octave_offset": -1,
            "notes": "secondary 303 plays counter-rhythm, square wave for different texture"
        },
        "drums": {
            "machine": "TR-909",
            "kick": {
                "style": "four_on_floor",
                "punch_hz": 80,
                "decay_ms": 250,
                "drive": 0.4,
                "character": "punchy_hard",
                "notes": "hard 909 kick, slight drive, short decay for clarity"
            },
            "clap": {
                "style": "909_clap",
                "position": "2_and_4",
                "tight": true,
                "reverb": 0.1
