{
    "_metadata": {
        "sound_type": "acid_techno_303_song",
        "display_name": "Acid Techno 303",
        "description": "Hard techno acid - the pro acidline formula. Multiple 303s, aggressive resonance, relentless 909, slides on the strong beats, accents driving the groove. Filter IS the instrument.",
        "reference_artists": ["Hardfloor", "Emmanuel Top", "Plastikman", "Umek", "Dave Clarke", "Chris Liebing", "Joey Beltram"],
        "reference_tracks": ["Acperience 1 - Hardfloor", "Turkish Bazar - Hardfloor", "Acid Storm - Emmanuel Top", "Spastik - Plastikman", "Energy Flash - Joey Beltram"]
    },
    "identity": {
        "emotion": "relentless_squelch",
        "era": "european_techno_1992",
        "character": ["hard", "driving", "hypnotic", "aggressive", "acidic", "machine"]
    },
    "parameters": {
        "bpm": { "min": 130, "max": 145, "value": 138 },
        "key": { "options": ["F", "Eb", "Gm", "Cm"], "value": "F" },
        "time_signature": "4/4"
    },
    "sound_design": {
