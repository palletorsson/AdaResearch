            "hihat_closed": {
                "style": "16th_notes",
                "velocity_variation": 0.15,
                "accent_offbeat": true,
                "notes": "constant 16ths, accent on offbeats for drive"
            },
            "hihat_open": {
                "style": "upbeats",
                "decay_ms": 100,
                "notes": "short open hats on upbeats"
            },
            "ride": {
                "enabled": true,
                "style": "8th_notes",
                "velocity": 0.4,
                "notes": "ride adds relentless texture"
