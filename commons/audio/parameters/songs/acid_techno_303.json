    "arrangement": {
        "structure": "techno_build_release",
        "sections": {
            "intro": {
                "bars": 16,
                "elements": ["kick", "ride"],
                "acid_filter": "closed",
                "notes": "kick only, ride enters bar 9"
            },
            "acid_entry": {
                "bars": 16,
                "elements": ["kick", "ride", "acid_bass_1"],
                "acid_filter": "closed_sweeping",
                "pattern": "squelch_machine",
