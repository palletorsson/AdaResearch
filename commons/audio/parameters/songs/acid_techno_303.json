            "accent": {
                "enabled": true,
                "amount": 0.7,
                "boosts_resonance": true,
                "boosts_env_mod": true,
                "notes": "accent increases filter env depth AND resonance - the secret sauce"
            },
            "slide": {
                "enabled": true,
                "speed": 0.12,
                "notes": "slides on STRONG beats (1, 5, 9, 13) create the hypnotic pull"
