[gd_scene load_steps=2 format=3 uid="uid://cny5bw7dcvmfi"]

[ext_resource type="Script" uid="uid://brv1xsxou2vb3" path="res://commons/audio/PopInteractiveMusic.gd" id="1_script"]

[node name="PopMusicDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MusicController" type="Node" parent="."]
script = ExtResource("1_script")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -100.0
offset_top = -100.0
offset_right = 100.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Interactive Pop Music Demo"
horizontal_alignment = 1

[node name="IntroButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Play Intro"

[node name="VerseButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Play Verse"

[node name="ChorusButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Play Chorus"

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="GenerateButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Generate New Song 🎲"

[connection signal="pressed" from="VBoxContainer/IntroButton" to="MusicController" method="play_intro"]
[connection signal="pressed" from="VBoxContainer/VerseButton" to="MusicController" method="play_verse"]
[connection signal="pressed" from="VBoxContainer/ChorusButton" to="MusicController" method="play_chorus"]
[connection signal="pressed" from="VBoxContainer/GenerateButton" to="MusicController" method="_generate_new_song"]
