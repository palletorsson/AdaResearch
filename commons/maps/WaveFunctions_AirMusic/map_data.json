{
  "map_info": {
	"name": "AirMusic",
	"title": "After the strike",
	"lookup_name": "WaveFunctions_AirMusic",
	"description": "What continues after the hand has left. A void basin fills the middle of the hall with a single pillar in it; the walkable ring runs round it. On the south side the primary, resonating_metallophone, stands at (5,9) on a table at hand height, its row of eight bars cut to the pentatonic scale, a cradle at the left end holding the striker front-to-back, the Hz labels on the table's front, a 12 ms scope of generated audio samples with a voices/playback-age readout above the row; a visitor stands on row 10 with the south wall behind. The display case at (3,9), the pipes at (7,8), the drone rack at (1,8), the glass racks and lab tables on the north side stay where they were. Structure recovered 2026-09-10: interior 2 = 1 m platform, perimeter w, wall_height 3, gate at the doorway; museum.sculpture_clear_rects keeps dealt plinths off the playing strip.",
	"version": "1.0",
	"format": "json",
