	  "difficulty": "beginner",
	  "category": "algorithms",
	  "estimated_time": "5 minutes",
	  "learning_objectives": [
		"Distinguish a triggering contact from a continuing response",
		"Compare restarting one voice with overlapping separate voices",
		"Trace a sampled sine, its decay and finite ending",
        "Read a short sum of source samples without mistaking it for the complete listening event"
	  ]
	},
