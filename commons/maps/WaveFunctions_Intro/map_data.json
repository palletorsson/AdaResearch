 "documentation": {
  "summary": "WaveFunctions Intro - Returning differently",
  "layout": "13x22 hall on the recovered one-metre platforms (museum.wall_height 3): the pendulum at (2,11) on the floor beside the raised strip at x=4 that carries the pick-up cubes; the prescribed-motion cubes near the entrance; the driven cube and the time trace behind the pendulum",
  "objective": "Release a pendulum and tell two visits to the same place apart by their direction; then set the integrated swing beside cubes that merely follow sin(t)",
  "key_elements": [ "control_pendulum#reference:plumb#evidence:trace - the primary: a grabbable bob, a plumb line and a ring at the rest point that lights at each centre crossing, the label reading the angle and the signed angular velocity, and the predicted theta(t) drawn behind the swing", "pickup_cube_static / transformation_cube / y_oscillation_cube - stationary and prescribed sin(t) motions kept as the comparison: told where to be, not integrated", "rotating_cube / rotating_cube_demo - constant angular velocity, no return", "oscillation_controlled_cube - driven by the pendulum's oscillation_updated signal: one integrated signal, three transformations", "mario_cube_time_trace - a trail of its own child cube's prescribed sin(t) motion along +z: the history of a motion told where to be, not of the swing; the handoff to the Pendulum room", "SphericalHarmonics, science_screen#mode:wave - secondary" ],
  "progression": "Release → two centre crossings, opposite directions → the integration excerpt → a second, larger release troubles the small-angle period → the record (next room)"
 },
