{
	"sequences": {
		"physicssimulation": {
			"name": "Physics Simulation: The Engine Behind Reality",
			"truth": "Reality is continuous. Simulation is discrete. The art of physics simulation is making the discrete feel continuous \u00e2\u20ac\u201d and knowing where the illusion breaks.",
			"qfep_term": "dynamics",
			"qfep_connection": "Physics simulation is the computational engine of emergence (\u00cf\u2020). Forces (F) create order, entropy (E) dissolves it, and the simulation timestep (dt) is the hidden \u00ce\u00bb \u00e2\u20ac\u201d the parameter that determines whether the system behaves or explodes. Numerical stability is the edge of chaos.",
			"formula": "x(t+dt) = 2x(t) - x(t-dt) + a(t)\u00c2\u00b7dt\u00c2\u00b2",
			"demonstration": "Feel Newton's laws pull you. Watch rigid bodies collide and scatter. Stretch springs until they oscillate. See force fields push particles into orbits. Pour fluid into a simulated world.",
			"description": "From F=ma to fluid dynamics. Five maps covering the full stack of physics simulation: the mathematical foundations (integration methods), rigid body dynamics (collisions and constraints), elastic systems (springs and cloth), force fields (particles and n-body), and continuous matter (fluids and soft bodies). Each map adds a layer of complexity \u00e2\u20ac\u201d and a new way the simulation can break.",
			"layer": "dynamics",
			"prerequisites": [
				"forces"
			],
			"unlocks": [
				"softbodies",
				"swarmintelligence"
			],
			"ambient_preset": "ambient_drone",
			"difficulty": "advanced",
			"estimated_time": "40-50 minutes",
			"learning_objectives": [
				"Numerical integration: Euler, Verlet, RK4 \u00e2\u20ac\u201d and why the method matters",
				"Rigid body dynamics: rotation, angular momentum, inertia tensors",
				"Collision detection: broad phase (spatial hashing) and narrow phase (GJK/SAT)",
				"Constraints: joints, hinges, and how physics engines solve them",
				"Spring-mass systems: Hooke's law, damping, and emergent cloth behavior",
				"Force fields and vector fields: invisible forces made visible",
				"N-body simulation: gravitational democracy and the three-body problem",
				"SPH fluid simulation: discretizing continuous matter into particles",
				"Finite Element Method: engineering simulation for deformable bodies",
				"Soft body physics: the compromise between rigid and fluid"
			],
			"content": [
				"PhysicsSim_Foundations: Newton's laws \u00e2\u2020\u2019 numerical integration \u00e2\u2020\u2019 Verlet. The math that makes simulation possible.",
				"PhysicsSim_Bodies: Rigid bodies \u00e2\u2020\u2019 collision detection \u00e2\u2020\u2019 constraints \u00e2\u2020\u2019 bouncing ball. Solid things interacting.",
				"PhysicsSim_Springs: Mass-spring-damper \u00e2\u2020\u2019 spring networks \u00e2\u2020\u2019 cloth. Elastic connections and emergent softness.",
				"PhysicsSim_Fields: Force fields \u00e2\u2020\u2019 vector fields \u00e2\u2020\u2019 particles \u00e2\u2020\u2019 n-body \u00e2\u2020\u2019 three-body problem. Invisible forces, visible chaos.",
				"PhysicsSim_Continuum: Fluid (SPH) \u00e2\u2020\u2019 FEM \u00e2\u2020\u2019 soft bodies \u00e2\u2020\u2019 magnetic fields \u00e2\u2020\u2019 kinetic sculpture. Continuous matter, discrete approximation."
			],
