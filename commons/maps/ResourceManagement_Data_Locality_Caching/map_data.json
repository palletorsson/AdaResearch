    "name": "ResourceManagement_Data_Locality_Caching",
    "lookup_name": "ResourceManagement_Data_Locality_Caching",
    "title": "Data Locality & Caching",
    "description": "Resource Management II — caching. A memory ladder stacked by log-latency: registers, L1/L2/L3, RAM, disk. A probe climbs to fetch — a HIT when the data is near, a ruinous MISS when it is far."
  },
  "subtitles": {
    "intro": {
      "text": "Climb the ladder. The gap from RAM to disk is a chasm because the latency is — where a byte lives is the whole price of using it.",
      "speaker": "Data Locality & Caching",
      "level": 1
    },
    "truth_cache": {
      "text": "Where a thing IS costs more than what it is. The same byte is a nanosecond away or ten million — distance is the price, not value.",
      "speaker": "Data Locality & Caching",
      "level": 1
    }
  },
