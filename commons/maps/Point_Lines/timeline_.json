{
  "version": "1.0",
  "description": "Point_Lines: darkness, a single line glows, walk toward it, more lines reveal in stages, measuring and network artifacts emerge, perspective zone opens, teleporter last.",
  "initial_state": {
    "hidden_artifacts": [
      "modulor_man_demo",
      "line_builder_3d",
      "plus_line_puzzle",
      "parallel_line_puzzle",
      "cube_scene",
      "line",
      "laser_measure",
      "laser_exploding_sphere",
      "perspective_lines",
      "scale_lines",
      "lightrod",
      "dgrid"
    ],
    "hidden_utilities": ["t", "3t:lines", "sub:line_measures"],
    "lighting": {
      "ambient_energy": 0.0,
      "directional_energy": 0.0
    }
  },
  "events": [
    {
      "id": "line_demo_glow",
      "trigger": { "type": "delay", "delay": 1.5 },
      "actions": [
        { "type": "reveal", "target": "line_demo", "animation": "fade_in", "duration": 2.0 },
        { "type": "lighting", "ambient_energy": 0.05, "directional_energy": 0.0, "duration": 2.0 },
        { "type": "text", "text": "a line connects two points", "position": [3, 2.5, 3] }
      ]
    },
    {
      "id": "player_reaches_line",
      "trigger": { "type": "zone", "position": [3, 3], "radius": 2.0 },
      "actions": [
        { "type": "reveal", "target": "modulor_man_demo", "animation": "fade_in", "duration": 1.0 },
        { "type": "reveal", "target": "line_builder_3d", "animation": "fade_in", "duration": 1.2 },
        { "type": "lighting", "ambient_energy": 0.2, "directional_energy": 0.3, "duration": 2.5 },
        { "type": "text", "text": "the body measures, the line constructs", "position": [3, 2.5, 4] }
      ]
    },
    {
      "id": "puzzles_appear",
      "trigger": { "type": "zone", "position": [3, 8], "radius": 2.5 },
      "actions": [
        { "type": "reveal", "target": "plus_line_puzzle", "animation": "scale_up", "duration": 1.0 },
        { "type": "reveal", "target": "parallel_line_puzzle", "animation": "scale_up", "duration": 1.0 },
        { "type": "reveal", "target": "cube_scene", "animation": "fade_in", "duration": 0.8 },
        { "type": "lighting", "ambient_energy": 0.35, "directional_energy": 0.5, "duration": 2.0 }
      ]
    },
    {
      "id": "measurement_zone",
      "trigger": { "type": "zone", "position": [3, 13], "radius": 2.0 },
      "actions": [
        { "type": "reveal", "target": "line", "animation": "fade_in", "duration": 0.8 },
        { "type": "reveal", "target": "laser_measure", "animation": "fade_in", "duration": 1.0 },
        { "type": "reveal", "target": "laser_exploding_sphere", "animation": "scale_up", "duration": 1.2 },
        { "type": "lighting", "ambient_energy": 0.45, "directional_energy": 0.7, "duration": 2.0 },
        { "type": "activate", "target": "sub:line_measures" },
        { "type": "reveal", "target": "sub:line_measures" }
      ]
    },
    {
      "id": "perspective_zone",
      "trigger": { "type": "zone", "position": [3, 20], "radius": 3.0 },
      "actions": [
        { "type": "reveal", "target": "perspective_lines", "animation": "fade_in", "duration": 1.5 },
        { "type": "reveal", "target": "scale_lines", "animation": "fade_in", "duration": 1.5 },
        { "type": "reveal", "target": "lightrod", "animation": "fade_in", "duration": 1.0 },
        { "type": "reveal", "target": "dgrid", "animation": "scale_up", "duration": 1.2 },
        { "type": "lighting", "ambient_energy": 0.6, "directional_energy": 1.2, "duration": 3.0 },
        { "type": "text", "text": "lines multiply into networks, measure into space", "position": [3, 2.5, 23] }
      ]
    },
    {
      "id": "show_exit",
      "trigger": { "type": "after", "event": "perspective_zone", "delay": 3.0 },
      "actions": [
        { "type": "activate", "target": "t" },
        { "type": "reveal", "target": "t", "animation": "fade_in", "duration": 1.0 },
        { "type": "activate", "target": "3t:lines" },
        { "type": "reveal", "target": "3t:lines", "animation": "fade_in", "duration": 1.0 }
      ]
    }
  ]
}
