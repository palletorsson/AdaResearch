{
  "map_info": {
    "name": "Vectors_Act5_ForceAsPlace",
    "lookup_name": "Vectors_Act5_ForceAsPlace",
    "title": "Force as Place",
    "description": "Act V of the Vector & Forces field — force as place. A chasm with no floor. On the near platform a vector machine lets you dial a force field that hovers over the void; throw a cube in to see where the field takes it, then dial it up-and-across and step in yourself to be carried over. Point it down and you fall. Falling isn't a property of the void; it's a property of the field over it — and the field is a vector you can turn. The teleporter on the far side returns to Act I: the field is a circle.",
    "version": "vf-field-act5",
    "format": "json",
    "dimensions": {
      "width": 16,
      "depth": 24,
      "max_height": 2
    },
    "metadata": {
      "difficulty": "advanced",
      "category": "vectors_forces_field",
      "estimated_time": "6-10 minutes",
      "act": "V — force as place",
      "learning_objectives": ["Force field as place","Dialing a field vector","Field replaces gravity"]
    }
  },
  "subtitles": {
    "intro": {
      "text": "You must cross a void. Dial the field on the machine, throw a cube to test, then step in yourself.",
      "speaker": "Act V",
      "level": 1
    },
    "truth_machine": {
      "text": "The machine posts one vector into the field over the void. Down, and things fall; up-and-across, and they're carried over.",
      "speaker": "Vector machine",
      "level": 1
    },
    "truth_void": {
      "text": "Falling isn't a property of the void; it's a property of the field over it — and the field is a vector you can turn.",
      "speaker": "The void",
      "level": 1
    },
    "truth_complete": {
      "text": "You crossed on a field you set. The whole field of forces was this: vectors you can read, and turn.",
      "speaker": "Reflection",
      "level": 1
    }
  },
