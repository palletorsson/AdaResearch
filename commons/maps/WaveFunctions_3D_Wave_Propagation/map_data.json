	"map_info": {
		"name": "Wave Propagation: The Medium is the Message",
		"description": "A wave is not an object\u2014it's a disturbance traveling through a medium. Watch waves emanate from sources, diminishing by inverse square law. Learn distance fields, phase propagation (sin(time - dist)), attenuation, and interference. Discover that identity is permeable: you are not a static entity, but a point of intersection for the world's noise.",
		"version": "1.0",
		"format": "json",
		"dimensions": {
			"width": 13,
			"depth": 14,
			"max_height": 5
		},
		"metadata": {
			"difficulty": "intermediate",
			"category": "wavefunctions",
			"estimated_time": "5-7 minutes",
			"learning_objectives": ["Distance fields: calculating propagation from source to every point", "Wave function: sin(time * speed - dist * frequency)", "Attenuation: inverse square law (energy = 1 / (1 + dist\u00b2))", "Interference: wave summation creates peaks and cancellation", "Critical: Identity is permeable\u2014to exist in a medium is to be distorted by it"]
		}
	},
