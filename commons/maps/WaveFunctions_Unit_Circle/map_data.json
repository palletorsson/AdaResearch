{
  "map_info": {
    "name": "Unit Circle: Rotation Becomes Oscillation",
    "title": "Rotation Becomes Oscillation",
    "lookup_name": "WaveFunctions_Unit_Circle",
    "description": "Walk into a deep amphitheater where the unit circle reveals the origin of all oscillation. A point rotating on a circle projects its shadow as a sine wave. Elevated ramparts frame the void where the unit circle animator floats, while oscillating bridges at the base make the wave physical—the ground moves under your feet. Rotation is the hidden engine behind every sine and cosine.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 14,
      "depth": 17,
      "max_height": 4
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "wavefunctions",
      "estimated_time": "5-7 minutes",
      "learning_objectives": [
        "Rotation creates oscillation",
        "Angular motion fundamentals",
        "Unit circle → sine/cosine projection",
        "Oscillating bridges as embodied wave experience"
      ]
    }
  },
