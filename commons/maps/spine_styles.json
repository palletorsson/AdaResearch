{
  "_doc": "Per-sequence style contracts for the spine corridor generator. Each sequence declares a structure recipe (from tools/structure_recipes.py), optional recipe params, lighting preset, ambient color, and biome density. The generator consumes this alongside the sequence's artifact list to build each map's corridor.",
  "version": 1,

  "corridor_blacklist": [
    "_doc: Tokens that are always skipped in corridor mode, regardless of spine_hints().",
    "_doc: Use this for artifacts without a root GDScript or ones that spawn entire galleries.",
    "library_rack",
    "durer_scene",
    "diamondtoruscollection",
    "combine_portals",
    "combine_capsule",
    "pyramid_edit",
    "snap_pyramid_puzzle",
    "rhizomatic_maze_space",
    "gyroid_cheese_vr",
    "entropy_morphogenesis_vr",
    "non_euclidean_space_demo",
    "terrain_demo"
  ],

  "defaults": {
    "structure_recipe": "flat_corridor",
    "structure_params": {},
    "lighting_preset":  "neutral",
    "ambient_color":    [0.55, 0.58, 0.66],
    "biome_density":    0.0,
    "fog_density":      0.0
  },

  "sequences": {
    "primitives": {
      "structure_recipe": "flat_corridor",
      "lighting_preset":  "lab_sterile",
      "ambient_color":    [0.68, 0.70, 0.74],
      "biome_density":    0.0,
      "fog_density":      0.01,
      "_doc_gallery": "Gallery-style sequence: every artifact lives in a void envelope — the empty space around each piece reads as design, not gap. Rule-miner masks cells around placements; the TypeScript scorer zeros structural-reachability weights for this sequence. Replaces the earlier `default_artifact_tags: ['floats_in_void']` mechanism (step 2a consolidation).",
      "gallery": true,
      "per_map_overrides": {
        "Chamber_Primitives": {
          "structure_recipe": "amphitheater",
          "structure_params": {"center_row": 9, "radius": 3.0, "depth": 1}
        },
        "Primitives_Melencolia": {
          "structure_recipe": "split_level",
          "structure_params": {"split_row": 10, "upper_height": 2}
        },
        "Primitives_Portals": {
          "structure_recipe": "island_chain",
          "structure_params": {"count": 4, "island_size": 3}
        }
      }
    },

    "transformation": {
      "structure_recipe": "split_level",
      "structure_params": {"split_row": 8, "upper_height": 2},
      "lighting_preset":  "lab_neutral",
