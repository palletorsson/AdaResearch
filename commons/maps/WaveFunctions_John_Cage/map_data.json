{
  "map_info": {
	"name": "John Cage",
	"title": "Silence Between Waves",
	"lookup_name": "WaveFunctions_John_Cage",
	"description": "Chance schedules playback within a prepared vocabulary of synthesized clips over drone and city-ambience layers. Luminous forms respond to sound activity. The Cage reference opens a question about authorship and listening; this artifact does not perform a particular Cage score.",
	"version": "1.0",
	"format": "json",
	"dimensions": {
	  "width": 13,
	  "depth": 14,
	  "max_height": 6
	},
	"metadata": {
	  "difficulty": "advanced",
	  "category": "wavefunctions",
	  "estimated_time": "5-7 minutes",
	  "learning_objectives": [
		"Separate continuous layers from intermittent events by listening over time",
		"Distinguish uncertain ordering from an open-ended sound vocabulary",
		"Compare the envelope and texture of recurring prepared variations",
		"Recognize that the luminous forms do not expose every scheduling choice or spatialize the audio",
        "Ask what the composer has already decided before leaving event order to chance"
	  ]
	},
