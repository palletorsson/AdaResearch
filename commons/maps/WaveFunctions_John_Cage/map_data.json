{
  "map_info": {
	"name": "John Cage",
	"title": "Silence Between Waves",
	"lookup_name": "WaveFunctions_John_Cage",
	"description": "In 1952, John Cage presented four minutes and thirty-three seconds of 'silence.' But it wasn't silent—the audience coughed, rain fell, chairs creaked. Silence is not absence of sound, but presence of unintended noise. Explore aleatoric algorithms (chance as life), noise floor (thermal noise, blood in ear), and ambient computation (simulating the uneventful). Cage reframed silence as space of infinite potential. The algorithm is running, but not 'working.' It is just breathing.",
	"version": "1.0",
	"format": "json",
	"dimensions": {
	  "width": 13,
	  "depth": 14,
	  "max_height": 6
	},
	"metadata": {
	  "difficulty": "advanced",
	  "category": "wavefunctions",
	  "estimated_time": "5-7 minutes",
	  "learning_objectives": [
		"Aleatoric algorithms: chance operations via randf() as life, not chaos",
		"Noise floor: you cannot have signal of 0, thermal noise in circuit",
		"Ambient computation: simulating the uneventful, code that does nothing beautifully",
		"Drift without destination: noise.get_noise_1d() for wandering",
		"Queer silence: reframing silence as space of infinite potential",
        "Critical: Do not look for the puzzle. Just listen. The algorithm is just breathing."
	  ]
	}
  },
  "documentation": {
	"summary": "WaveFunctions John Cage Installation",
	"layout": "13x14 experimental sound space dotted with double helix sculptures and dual display pylons.",
	"objective": "Blend John Cage-inspired soundscapes while monitoring dual displays and helix visuals.",
	"key_elements": [
	  "Spawn `s` on the northern threshold",
	  "`john_cage_tech_noir` controller at the arena center",
	  "Companion interactables: `doublehelix` and `dual_display_test`",
      "`dark_sphere` ambience and teleporter `t` toward the exit"
	]
  },
