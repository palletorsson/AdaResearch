{
  "map_info": {
    "name": "ResourceManagement_Version_Control",
    "lookup_name": "ResourceManagement_Version_Control",
    "title": "Version Control",
    "description": "Resource Management IV — history as shape. A commit DAG: a main branch and a feature branch that peels off and merges back, with HEAD advancing commit by commit. Checking out is moving the ring."
  },
  "subtitles": {
    "intro": {
      "text": "Stand in the history. The line you remember is a story told afterward; the truth is a graph that branches and rejoins.",
      "speaker": "Version Control",
      "level": 1
    },
    "truth_vcs": {
      "text": "History is not a line. It branches where work diverges and merges where it rejoins — HEAD is your foot on one node of the shape.",
      "speaker": "Version Control",
      "level": 1
    }
  },
