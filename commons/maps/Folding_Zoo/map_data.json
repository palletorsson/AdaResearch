  "tutorial_text": {
	"fold_principle": {
	  "title": "THE FOLD PRINCIPLE",
	  "text": "Same vertices, same faces, only positions change. Folding doesn't create or destroy material — it rearranges what's already there. Every exhibit here proves it."
	},
	"fold_deltahedra": {
	  "title": "DELTAHEDRON NETS",
	  "text": "Triangles can't deform. A closed convex deltahedron can't flex. The net IS the genome — tetrahedron (4f), octahedron (8f), icosahedron (20f)."
	},
	"fold_helices": {
	  "title": "HELIX STRUCTURES",
	  "text": "Sin and cos fold flat ribbons into spirals. The helix ribbon coils into DNA springs. The helix cylinder wraps a grid into a pineapple tube."
	},
	"fold_snake": {
	  "title": "FIBONACCI SNAKE",
	  "text": "Phi encodes rest. Sin encodes motion. A golden spiral unfurls into a slithering sine wave. The transition is the creature's lifecycle."
	},
	"fold_bird": {
	  "title": "ORIGAMI BIRD",
	  "text": "13 bone segments with Transformer-style activation windows. Legs deploy first, then neck, then wings, then head — a cascading reveal."
	},
	"fold_zoo_full": {
	  "title": "THE FULL ZOO",
	  "text": "Six zones: bone fold, chain fold, shell fold, state parade, misfold, spring tension. Debug overlays show live fold_amount, tension, energy, and misfold."
	}
  },
