{
  "version": "1.0",
  "description": "Point_One: total darkness, only the point glows, walk to it, world lights up.",
  "initial_state": {
    "hidden_artifacts": ["CoordinateSystem3M", "static_point", "frame_counter_display", "folding_past", "origin", "script_runner"],
    "hidden_utilities": ["t"],
    "lighting": {
      "ambient_energy": 0.0,
      "directional_energy": 0.0
    }
  },
  "events": [
    {
      "id": "player_reaches_point",
      "trigger": { "type": "zone", "position": [1, 1], "radius": 1.5 },
      "actions": [
        { "type": "reveal", "target": "origin", "animation": "fade_in", "duration": 1.0 },
        { "type": "reveal", "target": "CoordinateSystem3M", "animation": "scale_up", "duration": 0.8 },
        { "type": "lighting", "ambient_energy": 0.5, "directional_energy": 0.8, "duration": 3.0 },
        { "type": "text", "text": "position without extension", "position": [1, 2.5, 3] },
        { "type": "reveal", "target": "script_runner", "animation": "fade_in", "duration": 1.0 }
      ]
    },
    {
      "id": "show_more",
      "trigger": { "type": "after", "event": "player_reaches_point", "delay": 2.0 },
      "actions": [
        { "type": "reveal", "target": "static_point", "animation": "fade_in", "duration": 1.0 },
        { "type": "reveal", "target": "folding_past", "animation": "fade_in", "duration": 1.5 }
      ]
    },
    {
      "id": "show_exit",
      "trigger": { "type": "after", "event": "show_more", "delay": 2.0 },
      "actions": [
        { "type": "activate", "target": "t" },
        { "type": "reveal", "target": "t", "animation": "fade_in", "duration": 1.0 }
      ]
    }
  ]
}
