{
	"map_info": {
		"name": "Vectors_Act4b_Oscillation",
		"lookup_name": "Vectors_Act4b_Oscillation",
		"title": "Oscillation & Balance",
		"description": "Act IV (part b) of the Vector & Forces field \u2014 the forces that keep time and hold the beam level. A park around a central Calder mobile (the lever law, drifting): a tall pendulum and a tall spring tower bracket it, a Newton's cradle hands momentum across, a bounce well taxes each fall, a weather vane bends to wind \u221d v\u00b2, and a balance beam trades force for distance. Where Act IV-a's forces edit a path, these keep a rhythm. Teleporter onward to Act V \u2014 force as place.\n\n[Placement applied humanoid_walker engine \u2014 constraint 0.974\u21920.897, walkability 0.514\u21920.942]",
		"version": "placed-humanoid_walker",
		"format": "json",
		"dimensions": {
			"width": 30,
			"depth": 30,
			"max_height": 2
		},
		"metadata": {
			"difficulty": "intermediate",
			"category": "vectors_forces_field",
			"estimated_time": "10-14 minutes",
			"act": "IV-b \u2014 oscillation and balance",
			"learning_objectives": [
				"Spring / Hooke (F = \u2212kx)",
				"Pendulum (T = 2\u03c0\u221a(L/g))",
				"Momentum / collision",
				"Restitution / bounce",
				"Lever / balance (\u03c4 = F\u00b7d)",
				"Wind / drag \u221d v\u00b2"
			]
		}
	},
	"subtitles": {
		"intro": {
			"text": "Oscillation and balance \u2014 the forces that keep time and hold the beam level.",
			"speaker": "Act IV",
			"level": 1
		},
		"truth_spring": {
			"text": "A spring is honest \u2014 it returns exactly what it's given, which is why it keeps time.",
			"speaker": "Spring",
			"level": 1
		},
		"truth_pendulum": {
			"text": "A pendulum keeps time because the pull back is proportional to how far it's pulled.",
			"speaker": "Pendulum",
			"level": 1
		},
		"truth_momentum": {
			"text": "Momentum is motion that refuses to be destroyed, only handed on.",
			"speaker": "Momentum",
			"level": 1
		},
		"truth_restitution": {
			"text": "Every bounce is a tax on a fall \u2014 h' = e\u00b7h.",
			"speaker": "Restitution",
			"level": 1
		},
		"truth_lever": {
			"text": "A lever trades force for distance and never gets something for nothing \u2014 F\u2081d\u2081 = F\u2082d\u2082.",
			"speaker": "Lever",
			"level": 1
		},
		"truth_wind": {
			"text": "Wind is air with somewhere to be; the force is in the speed, squared.",
			"speaker": "Wind",
			"level": 1
		},
		"truth_oscillation": {
			"text": "Spring, pendulum, cradle, bounce, lever, wind \u2014 forces that repeat, conserve, and balance. These keep a rhythm.",
			"speaker": "Reflection",
			"level": 1
		}
	},
