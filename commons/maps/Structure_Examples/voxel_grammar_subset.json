{
	"schema": "adaresearch.voxel_grammar_subset.v2",
	"source_map": "Structure_Examples",
	"description": "Between/beyond voxel grammar modules for grid composition. V2 adds dynamic utility pieces (bridges, transport, ramps) with structure-utility co-dependencies.",
	"assumptions": {
		"grid_cell_meters": 1,
		"supports_multi_level": true,
		"tables_are_walkable_platforms": true,
		"default_structure_height_legend": {
			"0": "void or hole",
			"1": "floor",
			"2": "platform or plinth",
			"3": "wall or pillar",
			"4": "accent wall or buttress"
		},
		"utility_codes": {
			"br": "bridge_path — transparent green grid bridge spanning voids (br:LENGTH:AXIS)",
			"tc": "transport_cube — moving platform that carries players (tc:DIST:AXIS[:auto])",
			"wp": "walkpath — ramp connecting height levels (wp:ANGLE_DEG)",
			"s": "spawn_point — player start position",
			"t": "teleporter — exit to next map in sequence"
		}
	},
	"naming_scheme": {
		"pattern": "[Role]_[Primitive]_[Operator]_[Size]_[Variant]",
