{
  "map_info": {
	"name": "Harmonic Builder: The Architecture of Timbre",
	"lookup_name": "WaveFunctions_MathObjects",
	"description": "Any complex repeating wave can be built by summing simple sine waves at integer multiples of a fundamental frequency. Construct square, sawtooth, and triangle waves by manually adjusting harmonic amplitudes. Act as a Fourier Synthesizer and discover that complexity is reducible—the strangest waveform is just a choir of sines singing in perfect ratios.",
	"version": "1.0",
