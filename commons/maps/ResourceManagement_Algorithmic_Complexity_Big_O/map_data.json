    "name": "ResourceManagement_Algorithmic_Complexity_Big_O",
    "lookup_name": "ResourceManagement_Algorithmic_Complexity_Big_O",
    "title": "Algorithmic Complexity",
    "description": "Resource Management I — Big O. A bar per complexity class grows as the input size n sweeps up; at small n they stand level, at large n the quadratic and exponential peg the ceiling. Watch scale decide whether the thing runs at all."
  },
  "subtitles": {
    "intro": {
      "text": "Same problem, six solutions. Walk to the chart and watch the input size grow — the bars that stay low are the algorithms you can afford.",
      "speaker": "Algorithmic Complexity",
      "level": 1
    },
    "truth_bigo": {
      "text": "An algorithm is not one thing — it is a curve. Two solutions that agree on every small case can disagree about whether the universe has enough time.",
      "speaker": "Algorithmic Complexity",
      "level": 1
    }
  },
