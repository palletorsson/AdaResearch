    "lookup_name": "Vectors_Act1_WhatAVectorIs",
    "title": "What a Vector Is",
    "description": "Act I of the Vector & Forces field — what a vector IS. A processional hall: stand inside the coordinate frame, grab a free vector, stretch it to read its magnitude, then normalise it to pure direction. Four ideas, one arrow. The teleporter at the end leads to Act II — vector arithmetic.\n\n[Placement applied humanoid_walker engine — constraint 0.909→0.984, walkability 0.454→0.455]",
    "version": "placed-humanoid_walker",
    "format": "json",
    "dimensions": {
      "width": 14,
      "depth": 22,
      "max_height": 2
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "vectors_forces_field",
      "estimated_time": "5-8 minutes",
      "act": "I — what a vector is",
      "learning_objectives": ["Coordinate systems","Vector basics (direction + length)","Magnitude / length","Unit vector / normalize"]
    }
  },
  "subtitles": {
    "intro": {
      "text": "What a vector is. Walk the four ideas in order — the diagram is on the wall; the arrow is in your hands.",
      "speaker": "Act I",
      "level": 1
    },
    "truth_coord": {
      "text": "Space is a promise three numbers keep.",
      "speaker": "Coordinates",
      "level": 1
    },
    "truth_basics": {
      "text": "A vector is a journey with no starting address.",
      "speaker": "Vector",
      "level": 1
    },
    "truth_length": {
      "text": "Magnitude is how far the arrow would carry you if you walked it.",
      "speaker": "Magnitude",
      "level": 1
    },
    "truth_normalize": {
      "text": "To normalise is to ask 'which way?' and refuse 'how far?'",
      "speaker": "Unit vector",
      "level": 1
    },
    "truth_field": {
      "text": "Four facts, one arrow: a where, a which-way, a how-far — and a how-far refused, leaving pure direction.",
      "speaker": "Reflection",
      "level": 1
    }
  },
