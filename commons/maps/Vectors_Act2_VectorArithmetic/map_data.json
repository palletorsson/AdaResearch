  "map_info": {
    "name": "Vectors_Act2_VectorArithmetic",
    "lookup_name": "Vectors_Act2_VectorArithmetic",
    "title": "Vector Arithmetic",
    "description": "Act II of the Vector & Forces field — vector arithmetic. A wide gallery where each operation appears twice: once as a toy in your hand, once at the size of a room you step into. Add by walking, subtract the gap, scale a direction, then the products — dot (agreement), projection (shadow on a line), cross (the turn left over). Teleporter at the end leads to Act III — fields and motion.",
    "version": "vf-field-act2",
    "format": "json",
    "dimensions": {
      "width": 20,
      "depth": 38,
      "max_height": 2
    },
    "metadata": {
      "difficulty": "intermediate",
      "category": "vectors_forces_field",
      "estimated_time": "10-14 minutes",
      "act": "II — vector arithmetic",
      "learning_objectives": ["Addition (head to tail)","Subtraction (the gap)","Scalar multiplication","Dot product (agreement)","Projection / reflection","Cross product / torque"]
    }
  },
  "subtitles": {
    "intro": {
      "text": "Vector arithmetic. Each idea twice — once in your hand, once at the size of a room.",
      "speaker": "Act II",
      "level": 1
    },
    "truth_add": {
      "text": "Forces add by walking, not by counting — a + b is where you arrive if you walk a, then b.",
      "speaker": "Addition",
      "level": 1
    },
    "truth_sub": {
      "text": "Subtraction is the direction of the gap — the arrow from b's tip back to a's.",
      "speaker": "Subtraction",
      "level": 1
    },
    "truth_scale": {
      "text": "A scalar is a volume knob for a direction — it keeps the line and changes the length.",
      "speaker": "Scaling",
      "level": 1
    },
    "truth_dot": {
      "text": "The dot product is how much two directions agree — a·b = |a||b|cos θ.",
      "speaker": "Dot product",
      "level": 1
    },
    "truth_proj": {
      "text": "Projection is the part of you that lives along someone else's line.",
      "speaker": "Projection",
      "level": 1
    },
    "truth_cross": {
      "text": "The cross product is the turn left over when two directions refuse to align.",
      "speaker": "Cross product",
      "level": 1
    },
    "truth_arithmetic": {
      "text": "To add is to walk; to dot is to agree; to cross is to turn. Arithmetic is what vectors do to each other.",
      "speaker": "Reflection",
      "level": 1
    }
  },
