{
  "map_info": {
    "name": "Sine Space: The Eternal Return",
    "title": "Walking Through Sine",
    "lookup_name": "WaveFunctions_Sine_Space",
    "description": "A physical sine tray in the entrance forecourt lets visitors change relief or sphere size and count passage at a deadline. Beyond it, two noncolliding sine walls form a seven-metre corridor with AMP, PHASE, FREEZE and RESET. The original bridge and sine-space basin remain beyond the corridor. A sine can direct a body through contact or suggest a route through appearance; each construction declares which it does.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 14,
      "depth": 36,
      "max_height": 8
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "wavefunctions",
      "estimated_time": "6-8 minutes",
      "learning_objectives": [
        "Sine wave fundamentals: sin(t) oscillation",
        "Simple harmonic motion (SHM)",
        "Amplitude and frequency parameters",
        "Multiple oscillators and phase relationships",
        "Spatial phase offset creating wave propagation"
      ]
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0,
      "sculpture_clear_rects": [
        [
          1,
          1,
          11,
          12
        ]
      ],
      "artifact_placement": "map",
      "research_forecourt_rows": 6
    }
  },
