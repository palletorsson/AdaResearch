    "t": {
      "type": "teleporter",
      "name": "Next Lesson",
      "description": "Continue to the next algorithm demonstration",
      "properties": {
        "action": "next_in_sequence"
      }
    },
    "s": {
      "properties": {
        "height": 5.5
      }
    }
  },
  "documentation": {
    "summary": "Sine Space: a stationary contact surface and a moving visible passage",
    "layout": "14x36. Six new entrance rows hold a sine tray with side console; original corridor, nook, bridge, basin and exit shifted together by six rows.",
    "objective": "Predict a sphere departure, release, change only body size or relief, then compare the colliding tray with the corridor walls that permit crossing. Keep the counter and the measured x-gap explicit.",
    "key_elements": [
      "sine_flow_tray at (3,4), rotated 180; side console faces the central entry route",
      "sine_wall_corridor at (6,10), rotated 90; west/east mouths and original approach preserved",
      "sine_wall_explanation at (1,7), dark_sphere at (9,20), sine_space at (9,22)",
      "existing bridge at x=10 and exit shifted six rows without changing their shape"
    ]
  },
