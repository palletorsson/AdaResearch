  "subtitles": {
    "intro": {
      "text": "The forces, at the size of your body. Walk among them — each one a force bending a path.",
      "speaker": "Act IV",
      "level": 1
    },
    "truth_work": {
      "text": "The world only feels the part of a force that goes its way — W = F d cos θ.",
      "speaker": "Work",
      "level": 1
    },
    "truth_drag": {
      "text": "Drag is the world charging you rent on speed — pay in honey, glide free in air.",
      "speaker": "Drag",
      "level": 1
    },
    "truth_projectile": {
      "text": "A launch is a velocity you're given; gravity writes the rest.",
      "speaker": "Projectile",
      "level": 1
    },
    "truth_centripetal": {
      "text": "Going in a circle is constant acceleration toward a centre you never reach.",
      "speaker": "Centripetal",
      "level": 1
    },
    "truth_gravity": {
      "text": "An orbit is two things falling toward each other and missing, around a centre that belongs to neither.",
      "speaker": "Gravity",
      "level": 1
    },
    "truth_kinetic": {
      "text": "Work, drag, launch, turn, fall — every one is a force bending a path. Forces are what edit motion.",
      "speaker": "Reflection",
      "level": 1
    }
  },
