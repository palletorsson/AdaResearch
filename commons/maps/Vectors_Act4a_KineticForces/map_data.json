{
	"map_info": {
		"name": "Vectors_Act4a_KineticForces",
		"lookup_name": "Vectors_Act4a_KineticForces",
		"title": "Kinetic Forces",
		"description": "Act IV (part a) of the Vector & Forces field \u2014 the kinetic forces, at the size of your body. A park of five walk-in installations: push the mower and watch work fall as the handle rises (W = F d cos \u03b8); walk air \u2192 water \u2192 honey and feel drag bill you for speed; step on the pad and be launched; stand inside the centrifuge ring and feel the inward pull grow with v\u00b2/r; stand at a barycenter while two bodies wheel around you. This is the act that closes at body scale. Teleporter onward to Act IV-b \u2014 oscillation and balance.\n\n[Placement applied humanoid_walker engine \u2014 constraint 0.960\u21920.899, walkability 0.553\u21920.963]",
		"version": "placed-humanoid_walker",
		"format": "json",
		"dimensions": {
			"width": 30,
			"depth": 30,
			"max_height": 2
		},
		"metadata": {
			"difficulty": "intermediate",
			"category": "vectors_forces_field",
			"estimated_time": "10-14 minutes",
			"act": "IV-a \u2014 kinetic forces",
			"learning_objectives": [
				"Work (F\u00b7d cos \u03b8)",
				"Drag (F = \u2212b\u00b7v)",
				"Projectile launch",
				"Centripetal (a = v\u00b2/r)",
				"Gravity / orbit"
			]
		}
	},
	"subtitles": {
		"intro": {
			"text": "The forces, at the size of your body. Walk among them \u2014 each one a force bending a path.",
			"speaker": "Act IV",
			"level": 1
		},
		"truth_work": {
			"text": "The world only feels the part of a force that goes its way \u2014 W = F d cos \u03b8.",
			"speaker": "Work",
			"level": 1
		},
		"truth_drag": {
			"text": "Drag is the world charging you rent on speed \u2014 pay in honey, glide free in air.",
			"speaker": "Drag",
			"level": 1
		},
		"truth_projectile": {
			"text": "A launch is a velocity you're given; gravity writes the rest.",
			"speaker": "Projectile",
			"level": 1
		},
		"truth_centripetal": {
			"text": "Going in a circle is constant acceleration toward a centre you never reach.",
			"speaker": "Centripetal",
			"level": 1
		},
		"truth_gravity": {
			"text": "An orbit is two things falling toward each other and missing, around a centre that belongs to neither.",
			"speaker": "Gravity",
			"level": 1
		},
		"truth_kinetic": {
			"text": "Work, drag, launch, turn, fall \u2014 every one is a force bending a path. Forces are what edit motion.",
			"speaker": "Reflection",
			"level": 1
		}
	},
