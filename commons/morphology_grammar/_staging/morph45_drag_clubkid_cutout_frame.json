      "selector": "up",
      "op": "move_panel",
      "params": {
        "normal_offset": 0.14,
        "tangent_offset": 0.26,
        "bitangent_offset": -0.04
      },
      "child_role": "ornament",
      "budget_factor": 0.0
    }
  ],
  "render_mode": "wireframe"
