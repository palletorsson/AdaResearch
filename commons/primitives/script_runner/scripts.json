{
	"scripts": {
		"point": {
			"name": "Point Tutorial",
			"description": "A point is just a Vector3 position - with real code execution!",
			"lines": [
				{"text": "# The Point as Data", "action": "none", "duration": 2.0},
				{"text": "var point = Vector3(1.0, 0.5, 0.0)", "action": "eval", "params": {"code": "var point = Vector3(1.0, 0.5, 0.0)"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Access the x component", "action": "none", "duration": 1.5},
				{"text": "print(point.x)", "action": "eval", "params": {"code": "print(point.x)"}, "duration": 2.0},
				{"text": "print(point.y)", "action": "eval", "params": {"code": "print(point.y)"}, "duration": 2.0},
				{"text": "print(point.z)", "action": "eval", "params": {"code": "print(point.z)"}, "duration": 2.0},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Move the point", "action": "none", "duration": 1.5},
				{"text": "point = Vector3(0.0, 1.5, 0.5)", "action": "eval", "params": {"code": "point = Vector3(0.0, 1.5, 0.5)"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Add two vectors", "action": "none", "duration": 1.5},
				{"text": "var offset = Vector3(0.5, 0.0, 0.0)", "action": "eval", "params": {"code": "var offset = Vector3(0.5, 0.0, 0.0)"}, "duration": 2.0},
				{"text": "point = point + offset", "action": "eval", "params": {"code": "point = point + offset"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# The point has no size", "action": "none", "duration": 2.0},
				{"text": "# It's just numbers in memory", "action": "none", "duration": 2.0},
				{"text": "", "action": "clear_all", "duration": 1.0}
			]
		},
		"vector_math": {
			"name": "Vector Math",
			"description": "Vector operations with real evaluation",
			"lines": [
				{"text": "# Vector3 Operations", "action": "none", "duration": 2.0},
				{"text": "var a = Vector3(1.0, 0.0, 0.0)", "action": "eval", "params": {"code": "var a = Vector3(1.0, 0.0, 0.0)"}, "duration": 2.0},
				{"text": "var b = Vector3(0.0, 1.0, 0.0)", "action": "eval", "params": {"code": "var b = Vector3(0.0, 1.0, 0.0)"}, "duration": 2.0},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Addition", "action": "none", "duration": 1.0},
				{"text": "var sum = a + b", "action": "eval", "params": {"code": "var sum = a + b"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Scalar multiplication", "action": "none", "duration": 1.0},
				{"text": "var scaled = a * 2.0", "action": "eval", "params": {"code": "var scaled = a * 2.0"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Length (magnitude)", "action": "none", "duration": 1.0},
				{"text": "print(sum.length())", "action": "eval", "params": {"code": "print(sum.length())"}, "duration": 2.5},
				{"text": "", "action": "clear_all", "duration": 1.0}
			]
		},
		"array": {
			"name": "Array Tutorial",
			"description": "Visual grid indexing with grid[row][col]",
			"lines": [
				{"text": "# 2D Array as Grid", "action": "none", "duration": 1.5},
				{"text": "var grid = Array(4, 4)", "action": "init_grid", "params": {"size": 4}, "duration": 2.0},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Set individual cells", "action": "none", "duration": 1.0},
				{"text": "grid[0][0] = RED", "action": "set_cell", "params": {"row": 0, "col": 0, "color": "red"}, "duration": 1.5},
				{"text": "grid[0][1] = BLUE", "action": "set_cell", "params": {"row": 0, "col": 1, "color": "blue"}, "duration": 1.5},
				{"text": "grid[1][0] = GREEN", "action": "set_cell", "params": {"row": 1, "col": 0, "color": "green"}, "duration": 1.5},
				{"text": "grid[1][1] = YELLOW", "action": "set_cell", "params": {"row": 1, "col": 1, "color": "yellow"}, "duration": 1.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Bottom right corner", "action": "none", "duration": 1.0},
				{"text": "grid[3][3] = PURPLE", "action": "set_cell", "params": {"row": 3, "col": 3, "color": "purple"}, "duration": 1.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Loop: the diagonal", "action": "none", "duration": 1.0},
				{"text": "for i in range(4):", "action": "none", "duration": 1.0},
				{"text": "    grid[i][i] = WHITE", "action": "set_diagonal", "params": {"color": "white"}, "duration": 2.5},
				{"text": "", "action": "none", "duration": 1.0},
				{"text": "# grid[row][col] = value", "action": "none", "duration": 2.0},
				{"text": "", "action": "clear_all", "duration": 1.0}
			]
		},
		"pattern": {
			"name": "Pattern Tutorial",
			"description": "Checkerboard with (row+col)%2",
			"lines": [
				{"text": "# Checkerboard Pattern", "action": "none", "duration": 1.5},
				{"text": "var grid = Array(4, 4)", "action": "init_grid", "params": {"size": 4}, "duration": 2.0},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Row 0: even columns white", "action": "none", "duration": 1.0},
				{"text": "grid[0][0] = WHITE", "action": "set_cell", "params": {"row": 0, "col": 0, "color": "white"}, "duration": 0.8},
				{"text": "grid[0][1] = BLACK", "action": "set_cell", "params": {"row": 0, "col": 1, "color": "black"}, "duration": 0.8},
				{"text": "grid[0][2] = WHITE", "action": "set_cell", "params": {"row": 0, "col": 2, "color": "white"}, "duration": 0.8},
				{"text": "grid[0][3] = BLACK", "action": "set_cell", "params": {"row": 0, "col": 3, "color": "black"}, "duration": 0.8},
				{"text": "", "action": "none", "duration": 0.3},
				{"text": "# Row 1: odd columns white", "action": "none", "duration": 1.0},
				{"text": "grid[1][0] = BLACK", "action": "set_cell", "params": {"row": 1, "col": 0, "color": "black"}, "duration": 0.8},
				{"text": "grid[1][1] = WHITE", "action": "set_cell", "params": {"row": 1, "col": 1, "color": "white"}, "duration": 0.8},
				{"text": "grid[1][2] = BLACK", "action": "set_cell", "params": {"row": 1, "col": 2, "color": "black"}, "duration": 0.8},
				{"text": "grid[1][3] = WHITE", "action": "set_cell", "params": {"row": 1, "col": 3, "color": "white"}, "duration": 0.8},
				{"text": "", "action": "none", "duration": 0.3},
				{"text": "# Row 2: (row+col) % 2", "action": "none", "duration": 1.0},
				{"text": "grid[2][0] = WHITE", "action": "set_cell", "params": {"row": 2, "col": 0, "color": "white"}, "duration": 0.8},
				{"text": "grid[2][1] = BLACK", "action": "set_cell", "params": {"row": 2, "col": 1, "color": "black"}, "duration": 0.8},
				{"text": "grid[2][2] = WHITE", "action": "set_cell", "params": {"row": 2, "col": 2, "color": "white"}, "duration": 0.8},
				{"text": "grid[2][3] = BLACK", "action": "set_cell", "params": {"row": 2, "col": 3, "color": "black"}, "duration": 0.8},
				{"text": "", "action": "none", "duration": 0.3},
				{"text": "# Row 3: pattern continues", "action": "none", "duration": 1.0},
				{"text": "grid[3][0] = BLACK", "action": "set_cell", "params": {"row": 3, "col": 0, "color": "black"}, "duration": 0.8},
				{"text": "grid[3][1] = WHITE", "action": "set_cell", "params": {"row": 3, "col": 1, "color": "white"}, "duration": 0.8},
				{"text": "grid[3][2] = BLACK", "action": "set_cell", "params": {"row": 3, "col": 2, "color": "black"}, "duration": 0.8},
				{"text": "grid[3][3] = WHITE", "action": "set_cell", "params": {"row": 3, "col": 3, "color": "white"}, "duration": 0.8},
				{"text": "", "action": "none", "duration": 1.0},
				{"text": "# (row + col) % 2 == 0 -> WHITE", "action": "none", "duration": 2.0},
				{"text": "", "action": "clear_all", "duration": 1.0}
			]
		},
		"loop": {
			"name": "Loop Tutorial",
			"description": "For loops iterate through row indices",
			"lines": [
				{"text": "# For Loop: Highlight Each Row", "action": "none", "duration": 1.5},
				{"text": "var grid = Array(4, 4)", "action": "init_grid", "params": {"size": 4}, "duration": 2.0},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "for row in range(4):", "action": "none", "duration": 1.5},
				{"text": "    # row = 0", "action": "highlight_row", "params": {"row": 0, "color": "cyan"}, "duration": 1.5},
				{"text": "    # row = 1", "action": "highlight_row", "params": {"row": 1, "color": "cyan"}, "duration": 1.5},
				{"text": "    # row = 2", "action": "highlight_row", "params": {"row": 2, "color": "cyan"}, "duration": 1.5},
				{"text": "    # row = 3", "action": "highlight_row", "params": {"row": 3, "color": "cyan"}, "duration": 1.5},
				{"text": "", "action": "none", "duration": 0.5},
				{"text": "# Loop complete!", "action": "none", "duration": 1.5},
				{"text": "# Each iteration: row index", "action": "none", "duration": 2.0},
				{"text": "", "action": "clear_all", "duration": 1.0}
			]
		}
	}
}
