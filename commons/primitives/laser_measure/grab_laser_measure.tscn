[ext_resource type="PackedScene" uid="uid://bnfmsrmelyuhq" path="res://commons/primitives/cubes/grab_stick.tscn" id="1_grab_stick"]
[ext_resource type="Script" path="res://commons/primitives/laser_measure/laser_measure.gd" id="2_laser_measure"]

; The body geometry (cylinder handle + copper guard + LCD screen) is now
; built in laser_measure.gd via build_body_in_code=true. The legacy BoxMesh
; body / lens / ring sub-resources were removed 2026-05-19. The grab_stick
; base provides pickup + collision; the LaserMeasure node runs the .gd which
; assembles the new visual + functional geometry on _ready().

[node name="GrabLaserMeasure" instance=ExtResource("1_grab_stick")]
freeze = true
ranged_grab_method = 1
second_hand_grab = 0

[node name="LaserMeasure" type="Node3D" parent="." index="1"]
script = ExtResource("2_laser_measure")
max_range = 50.0
scan_frequency = 30.0
unit = "m"
decimal_places = 2
show_laser = true
laser_color = Color(1, 0.1, 0.1, 0.9)
laser_hit_color = Color(0.1, 1, 0.3, 0.9)
laser_thickness = 0.008
show_hit_dot = true
hit_dot_size = 0.035
build_body_in_code = true
build_lcd_screen = true

[node name="RayCast3D" type="RayCast3D" parent="LaserMeasure" index="0"]
target_position = Vector3(0, 0, -50)

[node name="HighlightRing" parent="." index="2"]
transform = Transform3D(-4.37114e-08, -1, 0, 1, -4.37114e-08, 0, 0, 0, 1, 0, 0, 0.08)

[node name="GrabPointHandLeft" parent="." index="3"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.02, 0, 0.04)
visible = true

[node name="GrabPointHandRight" parent="." index="4"]
