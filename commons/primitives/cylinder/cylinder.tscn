[ext_resource type="Script" path="res://commons/primitives/cylinder/cylinder_radials_rings.gd" id="1_script"]

; cylinder.tscn — consolidated onto cylinder_radials_rings.gd. Was previously
; a hardcoded scene with a 4-radial-segment CylinderMesh + basic_grid.gdshader.
; Now a thin-wrapper Node3D that scripts the same primitive used by the
; configurable cylinder, with backward-compat defaults: 4 radial segments
; (the old "faceted" look) so existing maps still render the same shape.
; UID preserved so all registry / map / shapes_test.gd references resolve.

[node name="cylinder" type="Node3D"]
script = ExtResource("1_script")
radial_segments = 4
rings = 1
height = 1.0
radius = 0.5
base_color = Color(0.6, 0.0, 0.6, 1.0)
