[ext_resource type="Script" uid="uid://do2bmofxjwte" path="res://commons/primitives/line/coordinate_line.gd" id="1_script"]

; arrow.tscn — directional arrow primitive, now built on the CoordinateLine
; primitive. Consolidates with coordinate_line.gd (previously two separate
; implementations: this one was a hardcoded .tscn with 4-segment cone +
; chunky proportions; coordinate_line.gd was the better-engineered version
; used by CoordinateSystem3M). Now arrow.tscn is a thin wrapper that just
; overrides defaults: bright yellow, prominent arrowhead, no tick marks
; (it's a directional indicator, not a ruler), shaft centered at origin.

[node name="arrow" type="Node3D"]
script = ExtResource("1_script")
length = 1.2
thickness = 0.025
color = Color(1.0, 1.0, 0.25, 1.0)
arrow_size = 0.18
show_ticks = false
