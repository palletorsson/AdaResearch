## LIVE PORT — generated by tools/port_wcn_probes_live.py from probe_wcn_effect_sound.gd. Do not edit;
## edit the SceneTree probe and regenerate. Runs under project startup (probe_live.tscn
## with --probe=effect_sound), so the project's autoloads exist and XR Tools pickables compile.
## Outputs carry a _live suffix.
extends Node
## WaveFunctions_Effect_Sound, batch W2 (doc/research/waves-chance-noise, 2026-09-10,
## Astra's runtime follow-up): can one oscillation be heard changing another, one
## parameter at a time, from a baseline a visitor can return to?
##
## Stands up the ACTUAL museum hall with its artifacts (the pattern of
## probe_wcn_pendulum.gd), hands the museum the REAL necklace hand file, finds the
## DualBallFMController staged on its desks, and measures: the staging (reach, the
## readout, the scope, the note's reach), the two real mapper paths (the balls moved
## through ValueMapper3D, not by setting parameters), the baseline and one-parameter
## changes as SAMPLES (index 0 is the bare carrier; index 4 differs at the beginning
## of the note and not at its tail), retriggers on movement and their rate limit,
## synthesis time, clipping, the AUDITION panel (BASELINE / HOLD / PLAY / COMPARE)
## through its signals, the quiet zone, the two repaired artifacts (AudioContr racks
## and MelodyChaser3D configured before entry), walks, and museum streaming.
## Buttons are pressed by EMITTING the push button's own signal — no tracked hand;
## the live port adds the project's desktop rig pressing them through its pointer.
##
##   godot --rendering-method gl_compatibility --path . --xr-mode off --script res://commons/testing/probe_wcn_effect_sound.gd -- --capture
##   godot --headless --path . --xr-mode off --script res://commons/testing/probe_wcn_effect_sound.gd
##
## Writes res://ada_run/waves_chance_noise/WaveFunctions_Effect_Sound/probe_effect_sound.json
## (and probe_effect_sound*.png under --capture). Exit code 1 on any failed check.
var checks := 0
var failures: Array[String] = []
var measurements: Dictionary = {}
const MAP := "WaveFunctions_Effect_Sound"
const OUT := "res://ada_run/waves_chance_noise/WaveFunctions_Effect_Sound/"
const MAP_CELL := Vector2i(8, 11)
const SR := 44100.0

func _ready() -> void: run.call_deferred()

## True under the live harness (probe_live.tscn, project startup with autoloads);
## false under --script, where the desktop rig cannot compile.
func _live() -> bool:
	return str(get_script().resource_path).ends_with("_live.gd")

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)
	print("[wcn-effect-sound] ", "PASS " if ok else "FAIL ", message)

func run() -> void:
	if "--capture" in OS.get_cmdline_user_args() and DisplayServer.get_name() == "headless":
		check(false, "PNG capture requires a rendered window; omit --headless, or omit --capture for logic only")
		_finish(); return
	var buses_before: int = AudioServer.bus_count
	var em: Node3D = load("res://commons/scenes/endless_museum.tscn").instantiate()
	var ctl := "res://ada_run/waves_chance_noise/wcn-probe-control.json"
	em.set("EM_CONTROL", ctl); em.set("_overrides_path", ctl + ".unused")
	em.set("_hand_path", "res://ada_run/necklace_hand.json")   # the REAL hand, on purpose
	em.set("start_chapter", "wavefunctions"); em.set("start_map", MAP)
	var layout: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://commons/data/em_layout.json"))
	layout.get_or_add("stream", {})["bodies"] = 1
	em.set("_layout", layout)
	var f := FileAccess.open(ctl, FileAccess.WRITE)
	f.store_string(JSON.stringify({"first_chapter": "wavefunctions", "dollhouse": 0, "grid_pack": 1})); f.close()
	get_tree().root.add_child(em); get_tree().current_scene = em
	await get_tree().create_timer(1.0).timeout
	em.set_process(false); em.call("flush_stamps")
	var player: Node = em.get("_player")
	if player != null: player.set_process(false); player.set_physics_process(false)
	var seg: Node3D
	for rec: Dictionary in em.get("_segments"):
		if rec.node.get_meta("em_map", "") == MAP: seg = rec.node; break
	check(seg != null, "the hall exists in the active museum")
	if seg == null:
		_finish(); return
	for i in range(30): await get_tree().process_frame
	var vest: int = int(em.get("VESTIBULE_H"))
	measurements["buses_before_build"] = buses_before
	measurements["buses_after_build"] = AudioServer.bus_count
	measurements["bus_names_after_build"] = _bus_names()

	# ── 1. built where the map put it, turned to the visitor ─────────────────
	var rig: Node3D
	var rig_cell: Array = []
	for record: Dictionary in em.get("_edit_records"):
		var node: Node = record.get("node")
		if node != null and seg.is_ancestor_of(node) and node.get_script() != null and str(node.get_script().resource_path).ends_with("DualBallFMController.gd"):
			rig = node; rig_cell = record.get("tile_cell", [])
	if rig == null:
		for n in seg.find_children("*", "Node3D", true, false):
			if n.get_script() != null and str(n.get_script().resource_path).ends_with("DualBallFMController.gd"): rig = n; break
	check(rig != null, "DualBallFMController is built in the hall")
	if rig == null:
		_finish(); return
	if rig_cell.size() >= 2:
		check(int(rig_cell[0]) == MAP_CELL.x and int(rig_cell[1]) == MAP_CELL.y,
			"built at the map's cell (8,11), the quiet south-east quarter, not the bench row (got %s)" % str(rig_cell))
	var local_origin: Vector3 = seg.to_local(rig.global_position)
	measurements["origin_local"] = [local_origin.x, local_origin.y, local_origin.z - vest]
	check(absf(local_origin.x - 8.5) < 0.6 and absf(local_origin.z - (11.5 + vest)) < 0.6, "the installation stands on its cell (%.1f, %.1f)" % [local_origin.x, local_origin.z - vest])
	check(absf(local_origin.y) < 0.05, "the deck is the origin: the rig stands ON the floor, not lifted or sunk (y %.2f)" % local_origin.y)
	var front: Vector3 = seg.global_transform.basis.inverse() * (rig.global_transform.basis * Vector3(0, 0, 1))
	measurements["front_local"] = [snappedf(front.x, 0.01), snappedf(front.z, 0.01)]
	check(front.z < -0.9, "the visitor's side (+z of the rig) faces north, toward the bench row and the door (rotation 180)")
	check(str(rig.get("stand")) == "desks", "the token's #stand:desks reached the artifact (stand = %s)" % str(rig.get("stand")))
	check(str(rig.get("evidence")) == "longhand", "the token's #evidence:longhand reached the artifact (evidence = %s)" % str(rig.get("evidence")))
	check(rig.scale.is_equal_approx(Vector3.ONE), "the subject's scale is what the map asked (1)")

	# ── 2. the staging: desks at hand height, panel, readout, scope, the note's reach ──
	var staging: Node = rig.get_node_or_null("Staging")
	check(staging != null, "the staging exists (Staging)")
	for d in ["CarrierDesk", "ModulatorDesk", "Shelf"]:
		var desk: Node = rig.get_node_or_null("Staging/" + d)
		check(desk != null and desk is StaticBody3D and desk.get_node_or_null("Top") != null, "%s is a solid support (StaticBody3D with a top)" % d)
	var cm: Node3D = rig.get_node_or_null("Ball1_Carrier")
	var mm: Node3D = rig.get_node_or_null("Ball2_Modulator")
	check(cm != null and mm != null, "both mapper cages exist")
	if cm == null or mm == null:
		_finish(); return
	var cage_floor_c: float = seg.to_local(cm.global_position).y
	var cage_floor_m: float = seg.to_local(mm.global_position).y
	measurements["cage_floor_heights"] = [cage_floor_c, cage_floor_m]
	check(absf(cage_floor_c - 0.92) < 0.03 and absf(cage_floor_m - 0.92) < 0.03, "both cages stand on their desks, floor at 0.92 m (%.2f, %.2f)" % [cage_floor_c, cage_floor_m])
	var cpt: Node3D = cm.get_node_or_null("SpacePoint")
	var mpt: Node3D = mm.get_node_or_null("SpacePoint")
	check(cpt != null and mpt != null, "both balls (SpacePoint) exist")
	if cpt == null or mpt == null:
		_finish(); return
	var ball_c_y: float = seg.to_local(cpt.global_position).y
	var ball_m_y: float = seg.to_local(mpt.global_position).y
	measurements["ball_heights"] = [ball_c_y, ball_m_y]
	check(ball_c_y > 1.0 and ball_c_y < 1.45 and ball_m_y > 1.0 and ball_m_y < 1.45, "both balls hang at hand height (%.2f m, %.2f m)" % [ball_c_y, ball_m_y])
	var gap_x: float = absf(seg.to_local(cpt.global_position).x - seg.to_local(mpt.global_position).x)
	measurements["ball_gap_x"] = gap_x
	check(gap_x > 0.8 and gap_x < 1.3, "the two balls are a metre apart, each on its own desk (%.2f m)" % gap_x)
	var panel: Node = rig.get_node_or_null("Staging/Panel")
	check(panel != null, "the AUDITION panel exists")
	check(panel != null and panel.get_meta("em_local_instrument", false), "the panel is marked a local instrument (its button areas are not the installation's footprint)")
	for b in ["Btn_0", "Btn_1", "Btn_2", "Btn_3"]:
		check(panel != null and panel.find_child(b, true, false) != null, "the panel carries %s" % b)
	if panel != null:
		var ph: float = seg.to_local((panel as Node3D).global_position).y
		var pz: float = seg.to_local((panel as Node3D).global_position).z - vest
		measurements["panel_local"] = [seg.to_local((panel as Node3D).global_position).x, ph, pz]
		check(ph > 0.5 and ph < 0.9, "the panel leans low in front of the modulator desk, below the hand space (%.2f m)" % ph)
		check(pz < 11.0, "the panel stands on the visitor's (north) side of the desks (z %.2f)" % pz)
	var readout: Label3D = rig.get_node_or_null("Staging/ReadoutCase/Readout")
	check(readout != null, "the cased readout exists")
	if readout != null:
		var rh: float = seg.to_local(readout.global_position).y
		measurements["readout_height"] = rh
		check(rh > 0.5 and rh < 0.9, "the readout leans low in front of the carrier desk, below the hand space (%.2f m above the deck)" % rh)
		var rxl: float = rig.to_local(readout.global_position).x
		measurements["readout_rig_x"] = rxl
		check(rxl < 0.0, "the readout is on the carrier's side, not between the balls (rig x %.2f)" % rxl)
		if panel != null:
			var pxl: float = rig.to_local((panel as Node3D).global_position).x
			measurements["panel_rig_x"] = pxl
			check(pxl > 0.5, "the panel is on the modulator's side (rig x %.2f)" % pxl)
		var between: Array = []
		var staging_n: Node = rig.get_node_or_null("Staging")
		if staging_n != null:
			for c in staging_n.get_children():
				if not (c is Node3D) or str(c.name) in ["CarrierDesk", "ModulatorDesk", "Shelf"]: continue
				var cl: Vector3 = rig.to_local((c as Node3D).global_position)
				if cl.x > -0.1 and cl.x < 0.6 and cl.y > 1.0 and cl.y < 1.7: between.append([c.name, snappedf(cl.x, 0.01), snappedf(cl.y, 0.01)])
		measurements["staging_between_the_balls"] = between
		check(between.is_empty(), "nothing of the staging stands between the balls at hand height (%s)" % str(between))
		check(readout.text.begins_with("now  fc"), "the readout prints the six values (%s)" % readout.text.get_slice("\n", 0))
	var scope: Node3D = rig.get_node_or_null("Evidence")
	check(scope != null, "the evidence scope exists (longhand)")
	if scope != null:
		var lanes: Array[String] = []
		for l in ["Lane_modulator", "Lane_carrier", "Lane_rule", "Lane_output"]:
			if scope.get_node_or_null(l) != null: lanes.append(l)
		measurements["scope_lanes"] = lanes
		check(lanes.size() == 4, "the scope shows four lanes: modulator, carrier, the rule, output (%s)" % str(lanes))
		var plate: MeshInstance3D = scope.get_node_or_null("ScopePlate")
		if plate != null:
			var plate_bottom: float = seg.to_local(plate.global_position).y - (plate.mesh as BoxMesh).size.y * 0.5
			measurements["scope_bottom"] = plate_bottom
			check(plate_bottom > 1.42, "the scope hangs above the cages, not through them (bottom %.2f m)" % plate_bottom)
		var cap_out: Label3D = scope.get_node_or_null("Cap_output")
		check(cap_out != null and cap_out.text.begins_with("out(t) = sin(2π · fc · t + m(t))"), "the output lane is captioned with the phase-modulation expression the generator computes")
	var ap: AudioStreamPlayer3D = rig.get_node_or_null("AudioStreamPlayer3D")
	check(ap != null, "the rig's player exists")
	if ap != null:
		measurements["player_reach"] = [ap.unit_size, ap.max_distance]
		check(ap.max_distance <= 20.0, "the note is kept to this hall: max_distance %.0f m (shipped 40)" % ap.max_distance)

	# ── 3. the baseline through the real mapper path ────────────────────────
	rig.call("set_baseline")
	for i in range(3): await get_tree().process_frame
	var p: Dictionary = rig.call("get_current_params")
	measurements["baseline_params"] = p
	check(absf(float(p.carrier_freq) - 440.0) < 1.0 and absf(float(p.mod_index)) < 0.01 and absf(float(p.mod_ratio) - 2.0) < 0.01,
		"BASELINE deals the pure tone: 440 Hz, ratio 2, index 0 (got fc %.0f, R %.2f, I %.2f)" % [p.carrier_freq, p.mod_ratio, p.mod_index])
	check(str(rig.get("last_note_tag")) == "baseline" and int(rig.get("notes_played")) >= 1, "BASELINE plays its note")
	var base: PackedFloat32Array = rig.call("render_samples", 0.0)
	# the notes themselves, for a person to listen to later (the probe cannot)
	var wav_a: AudioStreamWAV = rig.call("_generate_fm_sound", 0.0)
	wav_a.save_to_wav(OUT + "audio_A_baseline_unmodulated.wav")
	measurements["baseline_samples"] = base.size()
	measurements["baseline_seconds"] = float(base.size()) / SR
	check(absf(float(base.size()) / SR - 1.8) < 0.01, "the baseline note lasts decay × 1.2 = 1.8 s (%.2f s, %d samples at 44100 Hz)" % [float(base.size()) / SR, base.size()])
	var peak: float = 0.0
	for v in base: peak = maxf(peak, absf(v))
	measurements["baseline_peak"] = peak
	check(peak <= 0.5 + 0.001, "no clipping: the generator's tanh(0.8·x)·0.5 keeps every sample within ±0.5 (peak %.3f)" % peak)
	var worst: float = 0.0
	for tt in [0.05, 0.25, 0.6, 1.0]:
		var i: int = int(tt * SR)
		var env: float = exp(-(tt - float(p.attack_time)) / float(p.decay_time))
		var expected: float = tanh(sin(2.0 * PI * 440.0 * (float(i) / SR)) * env * 0.8) * 0.5
		worst = maxf(worst, absf(base[i] - expected))
	measurements["baseline_vs_bare_carrier_max_err"] = worst
	check(worst < 0.002, "with index 0 the modulator term is zero: the note IS the bare carrier under its envelope (max error %.4f)" % worst)

	# ── 4. one axis, one parameter: the modulator ball's y is the index ─────
	var notes_before: int = int(rig.get("notes_played"))
	var space: Vector3 = mm.get("space_size")
	mpt.position.y = space.y * 0.4          # index 0..10 over the cage's height → 4.0
	for i in range(4): await get_tree().process_frame
	p = rig.call("get_current_params")
	measurements["after_index_move"] = p
	check(absf(float(p.mod_index) - 4.0) < 0.05, "moving the orange ball up through the mapper sets Mod Index 4.0 (got %.2f)" % float(p.mod_index))
	check(absf(float(p.mod_ratio) - 2.0) < 0.01 and absf(float(p.mod_decay) - 0.5) < 0.01 and absf(float(p.carrier_freq) - 440.0) < 1.0, "…and leaves ratio, mod decay and the carrier alone")
	check(int(rig.get("notes_played")) > notes_before and str(rig.get("last_note_tag")) == "drag", "the movement retriggers a note (tag drag)")
	measurements["synth_ms_index4"] = float(rig.get("last_synth_ms"))
	check(float(rig.get("last_synth_ms")) < 600.0, "a 1.8 s note is synthesised in under 600 ms on the main thread (%.0f ms)" % float(rig.get("last_synth_ms")))
	var mod4: PackedFloat32Array = rig.call("render_samples", 0.0)
	var wav_b: AudioStreamWAV = rig.call("_generate_fm_sound", 0.0)
	wav_b.save_to_wav(OUT + "audio_B_index4_moddecay0.5.wav")
	var head_diff: float = _mean_abs_diff(base, mod4, 0, int(0.10 * SR))
	var tail_diff: float = _mean_abs_diff(base, mod4, int(1.45 * SR), int(1.75 * SR))
	measurements["index4_vs_baseline_head_diff"] = head_diff
	measurements["index4_vs_baseline_tail_diff"] = tail_diff
	check(head_diff > 0.02, "index 4 changes the samples at the beginning of the note (mean |Δ| %.3f over the first 0.1 s)" % head_diff)
	check(tail_diff < head_diff * 0.5, "…and with a 0.5 s modulator decay the tail is nearly the baseline again (mean |Δ| %.4f over 1.45–1.75 s)" % tail_diff)
	# a peak of the modulated note stays within the headroom too
	var peak4: float = 0.0
	for v in mod4: peak4 = maxf(peak4, absf(v))
	check(peak4 <= 0.5 + 0.001, "no clipping at index 4 either (peak %.3f)" % peak4)
	# then Mod Decay alone: the ball's z
	mpt.position.z = space.z * (inverse_lerp(0.1, 2.0, 1.5))
	for i in range(4): await get_tree().process_frame
	p = rig.call("get_current_params")
	check(absf(float(p.mod_decay) - 1.5) < 0.05 and absf(float(p.mod_index) - 4.0) < 0.05, "moving the orange ball along z sets Mod Decay 1.5 s and keeps the index (τ %.2f, I %.2f)" % [p.mod_decay, p.mod_index])
	var mod4_slow: PackedFloat32Array = rig.call("render_samples", 0.0)
	var wav_b2: AudioStreamWAV = rig.call("_generate_fm_sound", 0.0)
	wav_b2.save_to_wav(OUT + "audio_B_index4_moddecay1.5.wav")
	measurements["audio_files"] = ["audio_A_baseline_unmodulated.wav", "audio_B_index4_moddecay0.5.wav", "audio_B_index4_moddecay1.5.wav"]
	var tail_diff_slow: float = _mean_abs_diff(base, mod4_slow, int(1.45 * SR), int(1.75 * SR))
	measurements["index4_decay1.5_tail_diff"] = tail_diff_slow
	check(tail_diff_slow > tail_diff * 2.0, "a slower modulator decay keeps the difference alive into the tail (mean |Δ| %.4f vs %.4f)" % [tail_diff_slow, tail_diff])
	# and the carrier ball's x is the frequency
	var cspace: Vector3 = cm.get("space_size")
	cpt.position.x = cspace.x * inverse_lerp(100.0, 2000.0, 880.0)
	for i in range(4): await get_tree().process_frame
	p = rig.call("get_current_params")
	check(absf(float(p.carrier_freq) - 880.0) < 5.0 and absf(float(p.mod_index) - 4.0) < 0.05, "moving the blue ball along x sets the carrier to 880 Hz and leaves the modulator alone (fc %.0f, I %.2f)" % [p.carrier_freq, p.mod_index])

	# ── 5. retriggers are rate-limited while a ball is dragged ──────────────
	rig.call("set_baseline")
	for i in range(3): await get_tree().process_frame
	var drags_before: int = int(rig.get("drag_notes_played"))
	var synth_total: float = 0.0
	var t_drag0: int = Time.get_ticks_msec()
	for k in range(20):
		cpt.position.x = clampf(cpt.position.x + 0.012 * (1 if k % 2 == 0 else -1) * 1.5, 0.02, cspace.x - 0.02)
		await get_tree().create_timer(0.05).timeout
		synth_total += 0.0
	for i in range(3): await get_tree().process_frame
	var elapsed: float = float(Time.get_ticks_msec() - t_drag0) / 1000.0
	var drags: int = int(rig.get("drag_notes_played")) - drags_before
	measurements["drag_test"] = {"moves": 20, "elapsed_s": elapsed, "drag_notes": drags, "last_synth_ms": float(rig.get("last_synth_ms"))}
	check(drags >= 2 and drags <= int(ceil(elapsed / 0.3)) + 1, "twenty moves in %.1f s trigger %d notes: one per 0.3 s at most (the shipped rate limit)" % [elapsed, drags])

	# ── 6. the audition panel through its signals ───────────────────────────
	check(_press(panel, "Btn_0"), "BASELINE pressed through its signal")
	for i in range(3): await get_tree().process_frame
	p = rig.call("get_current_params")
	check(absf(float(p.mod_index)) < 0.01 and absf(float(p.carrier_freq) - 440.0) < 1.0, "the balls returned to the baseline (I %.2f, fc %.0f)" % [p.mod_index, p.carrier_freq])
	check(_press(panel, "Btn_1"), "HOLD pressed through its signal")
	for i in range(3): await get_tree().process_frame
	check(bool(rig.call("has_reference")), "HOLD keeps the note as the reference A")
	var refp: Dictionary = rig.call("get_reference")
	check(absf(float(refp.get("mod_index", 1.0))) < 0.01, "the reference is the pure tone (I %.2f)" % float(refp.get("mod_index", 1.0)))
	check(str(rig.get("last_note_tag")) == "A", "HOLD plays A once (tag A)")
	if readout != null:
		check(readout.text.contains("ref  fc 440"), "the readout prints the held reference")
	mpt.position.y = space.y * 0.4
	for i in range(4): await get_tree().process_frame
	var diffs: Array = rig.call("differences_from_reference")
	measurements["differs_after_index_move"] = diffs
	check(diffs.size() == 1 and str(diffs[0]).begins_with("I 0.00→4.00"), "after the one move the readout names ONE difference from A: %s" % str(diffs))
	if readout != null:
		check(readout.text.contains("differs: I 0.00→4.00"), "…on its third line")
	var n_before_cmp: int = int(rig.get("notes_played"))
	check(_press(panel, "Btn_3"), "COMPARE pressed through its signal")
	await get_tree().process_frame
	check(str(rig.get("last_note_tag")) == "A" and bool(rig.get("audio_player").playing), "COMPARE plays A first")
	var ref_s: float = float(rig.call("get_audition_state").get("reference_seconds", 0.0))
	measurements["reference_seconds"] = ref_s
	await get_tree().create_timer(ref_s + 0.45).timeout
	check(str(rig.get("last_note_tag")) == "B" and int(rig.get("notes_played")) == n_before_cmp + 2, "…then B, the current note, after A and a quarter second (tag %s)" % str(rig.get("last_note_tag")))
	var n_before_play: int = int(rig.get("notes_played"))
	check(_press(panel, "Btn_2"), "PLAY pressed through its signal")
	await get_tree().process_frame
	check(int(rig.get("notes_played")) == n_before_play + 1 and str(rig.get("last_note_tag")) == "B", "PLAY re-plays the current note without a move")
	if readout != null:
		check(readout.text.get_slice("\n", 3).begins_with("▶ B"), "the readout's last line says what is sounding (%s)" % readout.text.get_slice("\n", 3))
	measurements["audition_state"] = rig.call("get_audition_state")

	# ── 7. the quiet zone: what else sounds within reach, at rest ───────────
	await get_tree().create_timer(2.2).timeout
	var near: Array = []
	var far_playing: Array = []
	for n in seg.find_children("*", "AudioStreamPlayer3D", true, false):
		var pl: AudioStreamPlayer3D = n
		if rig.is_ancestor_of(pl) or not pl.playing: continue
		var dist: float = pl.global_position.distance_to(rig.global_position)
		var entry := [str(pl.get_path()).right(60), snappedf(dist, 0.1)]
		if dist < 5.0: near.append(entry)
		else: far_playing.append(entry)
	measurements["players_playing_within_5m"] = near
	measurements["players_playing_beyond_5m"] = far_playing
	check(near.is_empty(), "no other player sounds within 5 m of the desks at rest — a count, not a listening (%s)" % str(near))
	check(not bool(rig.get("audio_player").playing), "the rig itself is silent when nothing moves (no drone)")
	# the timbre sculptor (9,8), 3.3 m off, hums continuously as shipped; this placement's
	# #sound:near lets it sound only while the listener is within 3 m. The listener is the
	# viewport's camera: bring one close, then take it away.
	var sculptor: Node3D
	for n in seg.find_children("*", "Node3D", true, false):
		if n.get_script() != null and str(n.get_script().resource_path).ends_with("timbre_sculptor.gd"): sculptor = n; break
	check(sculptor != null, "the timbre sculptor is built")
	if sculptor != null:
		var sp: AudioStreamPlayer3D = sculptor.get("_audio_player")
		check(bool(sculptor.get("near_only")), "the sculptor's token #sound:near reached it (near_only)")
		check(sp != null and not sp.playing, "at rest, with the listener at the doorway, the sculptor is silent")
		# the listener is the current camera, and the museum walker's 1 s guard reclaims the
		# view for its own camera ("the view drifted to another camera — reclaimed for the
		# walker" preceded the one failure of this check, Astra's isolated rerun of 12
		# September): stop the guard's timers before the listener moves, and give the wake
		# a few more frames
		var guard_stopped: int = 0
		var wcam: Camera3D = em.get("_cam")
		if wcam != null and is_instance_valid(wcam):
			for c in wcam.get_children():
				if c is Timer: (c as Timer).stop(); guard_stopped += 1
		measurements["sculptor_listener_guard_timers_stopped"] = guard_stopped
		var tc := Camera3D.new(); em.add_child(tc)
		tc.global_position = sculptor.global_position + Vector3(0.0, 1.5, 1.5)
		for i in range(4): tc.make_current(); await get_tree().process_frame
		var woke: bool = sp != null and sp.playing
		for i in range(6):
			if woke: break
			tc.make_current(); await get_tree().process_frame
			woke = sp != null and sp.playing
		check(woke, "a listener within 3 m wakes the sculptor's tone (current camera %s)" % (str(get_viewport().get_camera_3d().get_path()).right(30) if get_viewport().get_camera_3d() != null else "none"))
		tc.global_position = rig.global_position + Vector3(0.0, 1.6, 0.0)
		for i in range(4): tc.make_current(); await get_tree().process_frame
		measurements["sculptor_distance_from_desks"] = sculptor.global_position.distance_to(rig.global_position)
		check(sp != null and not sp.playing, "a listener at the desks (%.1f m from the sculptor) leaves it silent" % sculptor.global_position.distance_to(rig.global_position))
		tc.queue_free()
		await get_tree().process_frame

	# ── 8. the two repaired artifacts, configured before entry ───────────────
	var racks: Array = []
	for n in seg.find_children("*", "Node3D", true, false):
		if n.get_script() != null and str(n.get_script().resource_path).ends_with("UniversalVRAudioController.gd"):
			var grid: Node = n.get_node_or_null("ParameterGrid")
			racks.append([n.name, grid.get_child_count() if grid != null else -1, (n.get("_pending_grid_config") as Dictionary).is_empty()])
	measurements["audio_controllers"] = racks
	check(racks.size() >= 4, "the four AudioContr placements are built (%d)" % racks.size())
	var racks_ok := true
	for r in racks:
		if int(r[1]) <= 0 or not bool(r[2]): racks_ok = false
	check(racks_ok, "every AudioContr built its rack from the token's preset/config, none holds a pending config (%s)" % str(racks))
	var chaser: Node
	for n in seg.find_children("*", "Node3D", true, false):
		if n.get_script() != null and str(n.get_script().resource_path).ends_with("MelodyChaser3D.gd"): chaser = n; break
	check(chaser != null, "MelodyChaser3D is built")
	if chaser != null:
		var markers: Dictionary = chaser.get("note_markers")
		measurements["melody_chaser"] = {"scale": str(chaser.get("scale_type")), "beat_interval": float(chaser.get("beat_interval")), "markers": markers.size()}
		check(str(chaser.get("scale_type")) == "fifths_circle" and markers.size() == 13, "the chaser built the circle of fifths from its token (scale %s, %d markers)" % [str(chaser.get("scale_type")), markers.size()])
		check(absf(float(chaser.get("beat_interval")) - 1.0) < 0.001, "…at tempo 60 (beat %.2f s)" % float(chaser.get("beat_interval")))

	# the museum's dealt sculpture plinths, by map cell (the rects keep them off the aisles)
	var plinths: Array = []
	for n in seg.find_children("ArtPlinth*", "", true, false):
		var pl: Vector3 = seg.to_local((n as Node3D).global_position)
		plinths.append([n.name, int(floor(pl.x)), int(floor(pl.z)) - vest])
	measurements["plinths"] = plinths
	# ── 9. walks: the approach from the bench row, the audition floor, the exit ──
	var pspace := seg.get_world_3d().direct_space_state
	var capsule := CapsuleShape3D.new(); capsule.radius = 0.22; capsule.height = 1.6
	var wq := PhysicsShapeQueryParameters3D.new(); wq.shape = capsule
	for route in [["west aisle past the bench row", Vector3(3.5, 0.81, 5.0), Vector3(0, 0, 2.5)],
			["row 7 east to the audition quarter", Vector3(3.5, 0.81, 7.5), Vector3(5.0, 0, 0)],
			["down to the desks' front", Vector3(8.5, 0.81, 7.5), Vector3(0, 0, 2.2)],
			["the audition floor west of the desks", Vector3(6.9, 0.81, 9.7), Vector3(0, 0, 3.2)],
			["to the south door", Vector3(6.9, 0.81, 12.9), Vector3(0.6, 0, 1.8)]]:
		wq.transform = Transform3D(Basis.IDENTITY, seg.to_global(Vector3(route[1].x, route[1].y, route[1].z + vest)))
		wq.motion = route[2]
		var frac: float = pspace.cast_motion(wq)[0]
		measurements["walk_" + str(route[0]).replace(" ", "_").replace("'", "")] = frac
		check(frac > 0.99, "a body walks %s (%.2f of the way)" % [route[0], frac])
	# the desks stop a body: walking into them from the front
	wq.transform = Transform3D(Basis.IDENTITY, seg.to_global(Vector3(8.5, 0.81, 9.7 + vest)))
	wq.motion = Vector3(0, 0, 1.6)
	var into: float = pspace.cast_motion(wq)[0]
	measurements["walk_into_the_desks"] = into
	check(into < 0.9, "the desks are solid: a body walking into them is stopped (%.2f of 1.6 m)" % into)
	# the museum's own verdict on this body: not a severing seal
	var severed: Array = em.get("_seg_severed") if em.get("_seg_severed") != null else []
	var sev_tokens: Array = []
	for s2 in severed: sev_tokens.append(str((s2 as Dictionary).get("token", "")))
	measurements["museum_severed_tokens"] = sev_tokens
	measurements["museum_severed"] = severed
	# the museum's own door-to-door verdict: _walk_severed lists halls whose walk died and
	# nothing reopened it (local pockets behind partitions are reported in `severed` but
	# do not cut the route)
	var walk_sev: Array = em.get("_walk_severed") if em.get("_walk_severed") != null else []
	var mine_sev: Array = []
	for e in walk_sev:
		if str((e as Dictionary).get("hall", "")).contains(MAP): mine_sev.append(e)
	measurements["museum_walk_severed"] = mine_sev
	measurements["museum_walk_reopened"] = em.get("_walk_reopened") if em.get("_walk_reopened") != null else []
	check(mine_sev.is_empty(), "the museum walks this hall door to door (its walk map is not severed; local seals: %s)" % str(sev_tokens))
	var rows: Array = em.get("_built") if em.get("_built") != null else []
	var mine: Dictionary = {}
	for r in rows:
		if str((r as Dictionary).get("map", "")) == MAP: mine = r
	if mine.is_empty() and not rows.is_empty(): mine = rows[rows.size() - 1]
	if not mine.is_empty():
		measurements["built_seals"] = mine.get("seals", [])
		measurements["built_severed"] = mine.get("severed", [])
		measurements["built_refused"] = mine.get("refused", [])
		var toks: Array = []
		for b in mine.get("bodies", []):
			toks.append([str((b as Dictionary).get("token", "")), (b as Dictionary).get("tile_cell", [])])
		measurements["built_bodies"] = toks

	# ── ACTUAL DESKTOP INPUT (live harness only) ─────────────────────────────
	if _live():
		var drv: Node = load("res://commons/testing/wcn_desktop_driver.gd").new()
		get_tree().root.add_child(drv)   # a SceneTree has no add_child; the port maps root. to get_tree().root.
		var facing: Vector3 = (rig.global_transform.basis * Vector3(0, 0, 1)).normalized()
		var panel_world: Vector3 = (panel as Node3D).global_position
		var stand: Vector3 = panel_world + facing * 0.9
		stand.y = seg.to_global(Vector3(0, 0, 0)).y
		drv.call("spawn", stand, em)
		await get_tree().create_timer(0.5).timeout
		var b0: Node = panel.find_child("Btn_0", true, false)
		var rec0: Dictionary = await drv.call("press", b0, stand) if b0 != null else {}
		await get_tree().process_frame
		measurements["desktop_input"] = {"baseline": rec0, "tag_after_baseline": str(rig.get("last_note_tag"))}
		check(str(rec0.get("hover", "")).contains("Btn_0") or str(rec0.get("hover", "")).contains("InteractableAreaButton"), "the desktop pointer had BASELINE under the crosshair (%s)" % str(rec0.get("hover", "")))
		check(str(rig.get("last_note_tag")) == "baseline", "a left click through the input pipeline dealt the baseline: actual desktop input, not an emitted signal")
		var b1: Node = panel.find_child("Btn_1", true, false)
		var rec1: Dictionary = await drv.call("press", b1, stand) if b1 != null else {}
		await get_tree().process_frame
		measurements["desktop_input"]["hold"] = rec1
		check(str(rig.get("last_note_tag")) == "A", "a click on HOLD held the note as A")
		var b3: Node = panel.find_child("Btn_3", true, false)
		var n0: int = int(rig.get("notes_played"))
		var rec3: Dictionary = await drv.call("press", b3, stand) if b3 != null else {}
		await get_tree().create_timer(float(rig.call("get_audition_state").get("reference_seconds", 1.8)) + 0.45).timeout
		measurements["desktop_input"]["compare"] = rec3
		check(int(rig.get("notes_played")) == n0 + 2 and str(rig.get("last_note_tag")) == "B", "a click on COMPARE played A then B")
		if "--capture" in OS.get_cmdline_user_args():
			drv.call("aim_at", rig.to_global(Vector3(0.25, 1.15, 0.3)))
			for i in range(12): await get_tree().process_frame
			await get_tree().create_timer(0.3, true, false, true).timeout
			get_viewport().get_texture().get_image().save_png(OUT + "probe_effect_sound_desktop_front_live.png")
			measurements["desktop_input"]["front_capture_pose"] = drv.call("pose")
		# walking into the desks from the front: they stop the rig
		drv.get("rig").global_position = seg.to_global(Vector3(8.5, 0.05, 7.6 + vest))
		await get_tree().physics_frame
		drv.call("aim_at", seg.to_global(Vector3(8.5, 1.1, 12.0 + vest)))
		var moved: Vector3 = await drv.call("walk", "ui_up", 45)
		var moved_local: Vector3 = seg.global_transform.basis.inverse() * moved
		measurements["desktop_input"]["walk_to_the_desks"] = [snappedf(moved_local.x, 0.01), snappedf(moved_local.z, 0.01)]
		check(moved_local.z > 1.5 and moved_local.z < 3.5, "the rig walks up to the desks on ui_up and is stopped by them (%.2f m of a possible 3.75)" % moved_local.z)
		await drv.call("teardown")
		measurements["desktop_input"]["log"] = drv.get("log")
		measurements["desktop_input"]["walker_cam_guard_stopped"] = drv.get("walker_cam_guard_stopped")
		await get_tree().process_frame

	# ── captures ─────────────────────────────────────────────────────────────
	if "--capture" in OS.get_cmdline_user_args():
		# the walker's one-second camera guard would reclaim the view mid-capture (the
		# bare lane spawns no driver to stop it): stop it here, for these cameras
		var wc: Camera3D = em.get("_cam")
		if wc != null and is_instance_valid(wc):
			for c in wc.get_children():
				if c is Timer: (c as Timer).stop()
		var cam := Camera3D.new(); em.add_child(cam); cam.fov = 62
		# from the visitor's spot north of the desks: both balls, the panel, the readout, the scope
		cam.global_position = seg.to_global(Vector3(8.6, 1.55, 9.2 + vest)); cam.look_at(seg.to_global(Vector3(8.4, 1.15, 11.3 + vest)))
		for i in range(30): cam.make_current(); await get_tree().process_frame
		await get_tree().create_timer(0.3, true, false, true).timeout
		get_viewport().get_texture().get_image().save_png(OUT + "probe_effect_sound_live.png")
		measurements["captures"] = {"primary": _cam_pose(cam)}
		# the readout from reading distance
		if readout != null:
			cam.global_position = readout.global_position + seg.global_transform.basis * Vector3(0.0, 0.02, -0.95)
			cam.look_at(readout.global_position)
			for i in range(20): cam.make_current(); await get_tree().process_frame
			await get_tree().create_timer(0.3, true, false, true).timeout
			get_viewport().get_texture().get_image().save_png(OUT + "probe_effect_sound_readout_live.png")
			measurements["captures"]["readout"] = _cam_pose(cam)
		# the scope: the four lanes and their captions
		if scope != null:
			cam.global_position = rig.to_global(Vector3(0.25, 1.55, 1.55)); cam.look_at(rig.to_global(Vector3(0.25, 1.45, 0.0)))
			for i in range(20): cam.make_current(); await get_tree().process_frame
			await get_tree().create_timer(0.3, true, false, true).timeout
			get_viewport().get_texture().get_image().save_png(OUT + "probe_effect_sound_scope_live.png")
			measurements["captures"]["scope"] = _cam_pose(cam)
		# from the north door: the bench row, then the audition quarter beyond
		cam.global_position = seg.to_global(Vector3(6.5, 2.3, 0.8 + vest)); cam.look_at(seg.to_global(Vector3(8.0, 0.9, 11.0 + vest)))
		for i in range(20): cam.make_current(); await get_tree().process_frame
		await get_tree().create_timer(0.3, true, false, true).timeout
		get_viewport().get_texture().get_image().save_png(OUT + "probe_effect_sound_overview_live.png")
		measurements["captures"]["overview"] = _cam_pose(cam)
		cam.queue_free()

	# ── MUSEUM STREAMING: free this hall through the museum's own streamer, rebuild it ──
	var seg_i: int = -1
	var segs: Array = em.get("_segments")
	for i in range(segs.size()):
		if (segs[i] as Dictionary).get("node") == seg: seg_i = i
	if seg_i >= 0 and em.has_method("_stream_free"):
		var z0: float = seg.global_position.z
		var rig_ref: WeakRef = weakref(rig)
		var player_ref: WeakRef = weakref(ap)
		em.call("_stream_free", seg_i, "south")
		for i in range(5): await get_tree().process_frame
		var freed: bool = rig_ref.get_ref() == null and player_ref.get_ref() == null
		check(freed, "the museum's streamer frees the hall, its rig and its player with it")
		measurements["buses_after_free"] = AudioServer.bus_count
		measurements["bus_names_after_free"] = _bus_names()
		var rack_buses_left: int = 0
		for bn in _bus_names():
			if str(bn).begins_with("RackBus_"): rack_buses_left += 1
		measurements["rack_buses_left_after_free"] = rack_buses_left
		check(rack_buses_left == 0, "every UniversalVRAudioController bus (RackBus_*) is removed with the hall (%d left; %d buses before the build, %d after, %d after the free)" % [rack_buses_left, buses_before, int(measurements["buses_after_build"]), AudioServer.bus_count])
		var rec: Dictionary = {}
		for r in em.get("_freed"):
			if absf(float((r as Dictionary).get("z0", -1e9)) - z0) < 0.01: rec = r
		if rec.is_empty():
			for r in em.get("_freed"):
				rec = r
		measurements["streaming"] = {"freed": freed, "rebuildable": rec.has("snap")}
		if rec.has("snap"):
			em.call("_stream_rebuild", rec)
			await get_tree().create_timer(1.0).timeout
			var seg2: Node3D
			for rec2: Dictionary in em.get("_segments"):
				if rec2.node.get_meta("em_map", "") == MAP: seg2 = rec2.node
			var rig2: Node3D
			if seg2 != null:
				for n in seg2.find_children("*", "Node3D", true, false):
					if n.get_script() != null and str(n.get_script().resource_path).ends_with("DualBallFMController.gd"): rig2 = n; break
			check(rig2 != null and rig2.get_node_or_null("Staging/Panel") != null and rig2.get_node_or_null("Staging/ReadoutCase/Readout") != null and rig2.get_node_or_null("Evidence") != null,
				"the rebuilt hall has its rig again, staged, with panel, readout and scope")
			if rig2 != null:
				rig2.call("set_baseline")
				for i in range(3): await get_tree().process_frame
				check(int(rig2.get("notes_played")) >= 1, "the rebuilt rig sounds (one note played)")
		else:
			measurements["streaming"]["note"] = "the streamer's record carried no cursor snapshot; rebuild not attempted"
	_finish()

func _bus_names() -> Array:
	var out: Array = []
	for i in AudioServer.bus_count: out.append(AudioServer.get_bus_name(i))
	return out

func _mean_abs_diff(a: PackedFloat32Array, b: PackedFloat32Array, from: int, to: int) -> float:
	var n: int = mini(mini(a.size(), b.size()), to) - from
	if n <= 0: return 0.0
	var acc: float = 0.0
	for i in range(from, from + n): acc += absf(a[i] - b[i])
	return acc / float(n)

func _press(panel: Node, btn_name: String) -> bool:
	if panel == null: return false
	var btn: Node = panel.find_child(btn_name, true, false)
	var area: Node = btn.get_node_or_null("InteractableAreaButton") if btn != null else null
	if area == null or not area.has_signal("button_pressed"): return false
	area.emit_signal("button_pressed", area)
	return true

## Which camera the viewport draws from at a capture, and where it stands and looks.
func _cam_pose(cam: Camera3D) -> Dictionary:
	var cur: Camera3D = get_viewport().get_camera_3d()
	var fwd: Vector3 = -cam.global_transform.basis.z
	return {"current_camera": str(cur.get_path()).right(50) if cur != null else "none", "is_ours": cur == cam,
		"at": [snappedf(cam.global_position.x, 0.01), snappedf(cam.global_position.y, 0.01), snappedf(cam.global_position.z, 0.01)],
		"forward": [snappedf(fwd.x, 0.01), snappedf(fwd.y, 0.01), snappedf(fwd.z, 0.01)]}

func _finish() -> void:
	var report := {"map": MAP, "checks": checks, "failures": failures, "measurements": measurements,
		"control_path": "button_pressed emitted programmatically on the AUDITION panel; the balls moved by setting the mapper points' positions (the mapper's own values_changed path); no tracked hand",
		"hand_file": "ada_run/necklace_hand.json (real)", "headset_verified": false, "heard_by_a_person": false,
		"engine": Engine.get_version_info().string, "physics_fps": Engine.physics_ticks_per_second}
	var f := FileAccess.open(OUT + "probe_effect_sound_live.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(report, "  ")); f.close()
	print("[wcn-effect-sound] ", checks, " checks; ", failures.size(), " failures")
	get_tree().quit(0 if failures.is_empty() else 1)
