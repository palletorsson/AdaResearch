			"overall_scale_base": 1.5,
			"overall_scale_per_intensity": 0.20
		},
		"tree": {
			"segments_base": 2.0,
			"segments_per_intensity": 0.8,
			"scale_base": 0.6,
			"scale_per_intensity": 0.20,
			"leaf_density_base": 0.4,
			"leaf_density_per_intensity": 0.03,
			"branch_angle_base": 18.0,
			"branch_angle_jitter": 16.0
		},
		"fungus": {
