# Two ripple sources create interference
func interference_pattern(x: float, y: float, time: float) -> float:
    # Source 1 at (-1, 0)
    var d1 = sqrt((x + 1.0)**2 + y**2)
    var wave1 = sin(5.0 * d1 - 2.0 * time)

    # Source 2 at (1, 0)
    var d2 = sqrt((x - 1.0)**2 + y**2)
    var wave2 = sin(5.0 * d2 - 2.0 * time)

    # Superposition
    return wave1 + wave2

# Creates constructive/destructive interference
# Regions of reinforcement (antinodes)
# Regions of cancellation (nodes)
[/code]

