# Epicycloid: point on circle rolling around outside of another circle
func epicycloid(t: float, R: float, r: float) -> Vector2:
    var ratio = R / r
    var x = (R + r) * cos(t) - r * cos((ratio + 1) * t)
    var y = (R + r) * sin(t) - r * sin((ratio + 1) * t)

    return Vector2(x, y)

# Ptolemaic epicycles (ancient astronomy)
# Spirograph toy patterns
# Gear tooth profiles
[/code]

**Wheels rotating at different rates = complex curves from simple waves.**

