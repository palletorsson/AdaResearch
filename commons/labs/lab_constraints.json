  "global_rules": [
    {
      "id": "emergency_button_visible_from_spawn",
      "description": "At least one emergency_button must be present in any lab containing a hazardous artifact, and ideally raycast-visible from the spawn point.",
      "severity": "warning",
      "cite": "MIT T10 § 3.1 Electrical"
    },
    {
      "id": "safety_shower_required_for_chemicals",
      "description": "If any chemical-class artifact is present (bunsen_burner, chemistry_flask, fume_hood, gas_canister, autoclave), a safety_shower OR sink-eyewash must be present and within ~16 m unobstructed travel.",
      "severity": "error",
      "cite": "ANSI/ISEA Z358.1; MIT T10 § 7.1"
    },
    {
      "id": "ventilation_above_thermal",
      "description": "autoclave and bunsen_burner artifacts should have a ceiling_vent within 2 m horizontally.",
      "severity": "warning",
      "cite": "MIT T10 § 7.4; NFPA 91"
    },
    {
      "id": "wall_mountable_must_be_on_wall",
      "description": "Any artifact whose metric surface is 'wall' must be placed adjacent to a wall (within 0.2 m of room boundary).",
      "severity": "error",
      "cite": "structural rule"
    },
    {
      "id": "no_blockage_of_egress",
      "description": "Within 1.5 m of any door cell, no floor-mounted artifact may be placed.",
      "severity": "error",
      "cite": "MIT T10 § 2.1; NFPA 101"
    }
  ]
