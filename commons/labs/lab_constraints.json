  "_doc_": {
    "rel_chart": "Muther REL ratings between artifact pairs. A=absolutely necessary adjacent (+4), E=especially important (+3), I=important (+2), O=ordinary OK (+1), U=unimportant (0), X=undesirable / must be apart (-1). Keys are 'name_a|name_b' with the two names alphabetically sorted, so each unordered pair has exactly one entry.",
    "ideal_distance": "Per-rating threshold in metres for an A/E pair to count as 'honoured' (i.e. close enough). Rating X uses the per-artifact min_clearance instead.",
    "artifact_metrics": "Per-artifact spatial and hazard data extracted from the source documents above. footprint = [x, z] in metres; clearance_radius = free space around the artifact when in use; surface = where this artifact mounts; hazard_class = nullable {fire, chemical, gas, hv, cryo, biohazard}.",
    "global_rules": "Constraints that apply to the whole lab, not a single pair."
  },
  "ideal_distance": {
    "A": 1.5,
    "E": 2.5,
    "I": 4.0,
    "O": 8.0,
    "U": null,
    "X": null
  },
