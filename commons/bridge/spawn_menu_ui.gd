extends Control
## The spawn menu's panel: Garry's Mod's spawnmenu, read from the spine.
##
## Left: a search box and the tree of what the sequences built (sequence → map).
## Right: the thumbnail grid of the selected node (artifact-gallery captures),
## "Remove last", and a status line where the bridge's answer and this game's
## own ack are printed. Data: res://commons/data/void_spawnlists.json (in the pck;
## generated by tools/build_void_spawnlists.py), else GET 127.0.0.1:8772/spawnlists.
## Thumbnails: ada_encyclopedia/public next to the repo when it is there (desktop),
## else GET 127.0.0.1:8772/thumb/<token>/<angle>.png (the headset, over adb reverse).
## Built in code so the whole menu is one scene with one script.

signal spawn_requested(token: String, is_prop: bool)
signal remove_last_requested()
signal close_requested()

const SPAWNLISTS := "res://commons/data/void_spawnlists.json"
const BRIDGE := "http://127.0.0.1:8772"
const COLS := 4
const TILE := Vector2(180, 150)
const FONT := 18
const MAX_SEARCH := 48

var _data: Dictionary = {}
var _items: Dictionary = {}
var _tree: Tree
var _search: LineEdit
var _title: Label
var _grid: GridContainer
var _status: Label
var _scroll: ScrollContainer
var _thumbs: Dictionary = {}        # url -> Texture2D
var _thumb_queue: Array = []        # [url, button]
var _http: HTTPRequest = null
var _http_busy := false
var _public_dir := ""


func _ready() -> void:
	_public_dir = ProjectSettings.globalize_path("res://").path_join("../ada_encyclopedia/public")
	if not DirAccess.dir_exists_absolute(_public_dir):
		_public_dir = ""
	_build()
	_load_data()


## ————————————————————————————————————————————————————————————————————
## Layout
## ————————————————————————————————————————————————————————————————————

func _build() -> void:
	var bg := PanelContainer.new()
	bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.11, 0.11, 0.13, 0.96)
	style.set_corner_radius_all(8)
	style.set_content_margin_all(10)
	bg.add_theme_stylebox_override("panel", style)
	add_child(bg)
	var h := HBoxContainer.new()
	h.add_theme_constant_override("separation", 12)
	bg.add_child(h)

	var left := VBoxContainer.new()
	left.custom_minimum_size = Vector2(300, 0)
	left.size_flags_vertical = Control.SIZE_EXPAND_FILL
	h.add_child(left)
	_search = LineEdit.new()
	_search.placeholder_text = "Search…"
	_search.add_theme_font_size_override("font_size", FONT)
	_search.text_changed.connect(_on_search)
	left.add_child(_search)
	_tree = Tree.new()
	_tree.hide_root = true
	_tree.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_tree.add_theme_font_size_override("font_size", FONT)
	_tree.item_selected.connect(_on_tree_selected)
	left.add_child(_tree)

	var right := VBoxContainer.new()
	right.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	right.size_flags_vertical = Control.SIZE_EXPAND_FILL
	h.add_child(right)
	var top := HBoxContainer.new()
	right.add_child(top)
	_title = Label.new()
	_title.text = "Built in the sequences"
	_title.add_theme_font_size_override("font_size", FONT + 4)
	_title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	top.add_child(_title)
	var close := Button.new()
	close.text = "✕"
	close.add_theme_font_size_override("font_size", FONT)
	close.pressed.connect(func() -> void: close_requested.emit())
	top.add_child(close)
	_scroll = ScrollContainer.new()
	_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	right.add_child(_scroll)
	_grid = GridContainer.new()
	_grid.columns = COLS
	_grid.add_theme_constant_override("h_separation", 8)
	_grid.add_theme_constant_override("v_separation", 8)
	_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_scroll.add_child(_grid)
	var bottom := HBoxContainer.new()
	right.add_child(bottom)
	var remove := Button.new()
	remove.text = "Remove last"
	remove.add_theme_font_size_override("font_size", FONT)
	remove.pressed.connect(func() -> void: remove_last_requested.emit())
	bottom.add_child(remove)
	_status = Label.new()
	_status.text = "loading the spine…"
	_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_status.add_theme_font_size_override("font_size", FONT - 2)
	_status.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bottom.add_child(_status)


func set_status(text: String) -> void:
	if _status != null:
		_status.text = text


## ————————————————————————————————————————————————————————————————————
## Data
## ————————————————————————————————————————————————————————————————————

func _load_data() -> void:
	if FileAccess.file_exists(SPAWNLISTS):
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(SPAWNLISTS))
		if parsed is Dictionary:
			_take_data(parsed)
			return
	# the headset without the file in its pck: the bridge serves it
	var req := HTTPRequest.new()
	add_child(req)
	req.request_completed.connect(func(_r: int, code: int, _h: PackedStringArray, body: PackedByteArray) -> void:
		req.queue_free()
		if code == 200:
			var parsed: Variant = JSON.parse_string(body.get_string_from_utf8())
			if parsed is Dictionary:
				_take_data(parsed)
				return
		set_status("no spawnlists: run python tools/build_void_spawnlists.py (and the bridge)"))
	if req.request(BRIDGE + "/spawnlists") != OK:
		set_status("no spawnlists file and no bridge")


func _take_data(d: Dictionary) -> void:
	_data = d
	_items = d.get("items", {})
	_tree.clear()
	var root: TreeItem = _tree.create_item()
	var trees: Array = d.get("trees", [])
	for t_v in trees:
		var t: Dictionary = t_v
		for s_v in t.get("children", []):
			var s: Dictionary = s_v
			var si: TreeItem = _tree.create_item(root)
			si.set_text(0, "%s  (%d)" % [String(s.get("title", s.get("id", ""))), (s.get("items", []) as Array).size()])
			si.set_metadata(0, {"items": s.get("items", []), "title": String(s.get("title", s.get("id", "")))})
			si.collapsed = true
			for m_v in s.get("children", []):
				var m: Dictionary = m_v
				var mi: TreeItem = _tree.create_item(si)
				mi.set_text(0, "%s  (%d)" % [String(m.get("label", m.get("id", ""))), (m.get("items", []) as Array).size()])
				mi.set_metadata(0, {"items": m.get("items", []), "title": String(m.get("label", m.get("id", "")))})
	var sm: Dictionary = d.get("summary", {})
	set_status("%d works in %d maps of %d sequences — pick a sequence or search" % [int(sm.get("items", _items.size())), int(sm.get("maps", 0)), int(sm.get("sequences", 0))])
	print("[spawn-menu] spawnlists: %s" % JSON.stringify(sm))
	# open on the first sequence
	var first: TreeItem = root.get_first_child()
	if first != null:
		first.select(0)


func _on_tree_selected() -> void:
	var it: TreeItem = _tree.get_selected()
	if it == null:
		return
	var meta: Variant = it.get_metadata(0)
	if meta is Dictionary:
		_show_items((meta as Dictionary).get("items", []), String((meta as Dictionary).get("title", "")))


func _on_search(text: String) -> void:
	var q: String = text.strip_edges().to_lower()
	if q == "":
		_on_tree_selected()
		return
	var hits: Array = []
	for token in _items:
		var it: Dictionary = _items[token]
		if String(token).to_lower().contains(q) or String(it.get("label", "")).to_lower().contains(q) \
				or String(it.get("description", "")).to_lower().contains(q):
			hits.append(token)
			if hits.size() >= MAX_SEARCH:
				break
	_show_items(hits, "search: %s (%d)" % [text, hits.size()])


## ————————————————————————————————————————————————————————————————————
## The grid
## ————————————————————————————————————————————————————————————————————

func _show_items(tokens: Array, title: String) -> void:
	_title.text = title
	for c in _grid.get_children():
		c.queue_free()
	_thumb_queue.clear()
	for token_v in tokens:
		var token: String = String(token_v)
		var it: Dictionary = _items.get(token, {})
		var b := Button.new()
		b.custom_minimum_size = TILE
		b.text = String(it.get("label", token))
		b.clip_text = true
		b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
		b.vertical_icon_alignment = VERTICAL_ALIGNMENT_TOP
		b.expand_icon = true
		b.add_theme_font_size_override("font_size", FONT - 3)
		b.tooltip_text = "%s\n%s\nin: %s" % [token, String(it.get("description", "")), ", ".join(it.get("maps", []))]
		if not bool(it.get("map_ready", true)):
			b.modulate = Color(1, 1, 1, 0.55)
			b.tooltip_text += "\n(not map_ready)"
		b.pressed.connect(func() -> void: spawn_requested.emit(token, false))
		_grid.add_child(b)
		var url: String = String(it.get("thumbnail", ""))
		if url != "":
			_want_thumb(url, b)
	_scroll.scroll_vertical = 0


func _want_thumb(url: String, b: Button) -> void:
	if _thumbs.has(url):
		b.icon = _thumbs[url]
		return
	if _public_dir != "":
		var path: String = _public_dir.path_join(url.lstrip("/"))
		if FileAccess.file_exists(path):
			var img := Image.load_from_file(path)
			if img != null:
				img.resize(160, int(160.0 * float(img.get_height()) / maxf(1.0, float(img.get_width()))))
				var tex := ImageTexture.create_from_image(img)
				_thumbs[url] = tex
				b.icon = tex
				return
	_thumb_queue.append([url, b])
	_pump_thumbs()


func _pump_thumbs() -> void:
	if _http_busy or _thumb_queue.is_empty():
		return
	if _http == null:
		_http = HTTPRequest.new()
		add_child(_http)
		_http.request_completed.connect(_on_thumb)
	var job: Array = _thumb_queue.pop_front()
	var url: String = job[0]
	# /artifact-gallery/captures/<token>/<angle>.png -> /thumb/<token>/<angle>.png
	var parts: PackedStringArray = url.split("/")
	if parts.size() < 2:
		_pump_thumbs()
		return
	var token: String = parts[parts.size() - 2]
	var file: String = parts[parts.size() - 1]
	_http.set_meta("job", job)
	_http_busy = _http.request("%s/thumb/%s/%s" % [BRIDGE, token, file]) == OK
	if not _http_busy:
		_pump_thumbs()


func _on_thumb(_result: int, code: int, _headers: PackedStringArray, body: PackedByteArray) -> void:
	_http_busy = false
	var job: Variant = _http.get_meta("job", null)
	if code == 200 and job is Array:
		var img := Image.new()
		if img.load_png_from_buffer(body) == OK:
			img.resize(160, int(160.0 * float(img.get_height()) / maxf(1.0, float(img.get_width()))))
			var tex := ImageTexture.create_from_image(img)
			_thumbs[(job as Array)[0]] = tex
			var b: Variant = (job as Array)[1]
			if b is Button and is_instance_valid(b):
				(b as Button).icon = tex
	_pump_thumbs()
