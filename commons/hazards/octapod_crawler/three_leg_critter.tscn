[gd_scene load_steps=3 format=3]

;; ThreeLegCritter — three FABRIK3D legs at 120deg intervals, walks around.
;; Exact beast_demo architecture: body at fixed Y, SpringArm3D finds ground,
;; FABRIK3D bends bone chain from body to foot target, magnet sets knee direction.
;; Leg 0: 0deg (+X), Leg 1: 120deg (back-left), Leg 2: 240deg (back-right).

[ext_resource type="Script" path="res://commons/hazards/octapod_crawler/leg_walker_root.gd" id="9_root"]
[ext_resource type="Script" path="res://commons/hazards/octapod_crawler/three_leg_critter.gd" id="1_script"]

[node name="ThreeLegScene" type="Node3D"]
script = ExtResource("9_root")

;; ── Body ─────────────────────────────────────────────────────────────────
[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
script = ExtResource("1_script")

;; ═══════════════════════════════════════════════════════════════════════════
;; LEG 0 (0deg, +X side)
;; ═══════════════════════════════════════════════════════════════════════════

[node name="IK_leg_0" type="Node3D" parent="Body"]
;; No rotation — leg extends in default +X orientation
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

