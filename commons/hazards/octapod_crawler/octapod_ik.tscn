[gd_scene format=4]

;; Octapod IK rig — 8 legs with FABRIK3D + SpringArm3D ground contact.
;; Pattern: each IK_leg (Skeleton3D + FABRIK3D) targets a SpringArm3D child Marker3D.
;; Built to match the beast_demo.tscn architecture from ik-demo-4.6.
;; Bone chain: 6 bones, spacing 0.12 in +Y. Dual FABRIK chains (magnet + foot).

[node name="OctapodIK" type="Node3D"]

;; ═══════════════════════════════════════════════════════════════════════════
;; LEG 0 — angle 0° (positive X)
;; ═══════════════════════════════════════════════════════════════════════════

[node name="IK_leg_0" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

[node name="Armature" type="Node3D" parent="IK_leg_0"]

