[gd_scene load_steps=2 format=3]

;; OneLeg — single FABRIK3D leg test.
;; Body (MeshInstance3D) at Y=2.2 with ONE leg + SpringArm3D ground contact.
;; Exact beast_demo architecture in smallest possible form.
;; Skinned mesh added by one_leg.gd at runtime.

[ext_resource type="Script" path="res://commons/hazards/octapod_crawler/one_leg.gd" id="1_script"]

[node name="OneLegScene" type="Node3D"]

;; ── Body ─────────────────────────────────────────────────────────────────
[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
script = ExtResource("1_script")

;; ── IK Leg container ─────────────────────────────────────────────────────
;; No Y-rotation (single leg, points in +X)
[node name="IK_leg" type="Node3D" parent="Body"]

[node name="Armature" type="Node3D" parent="Body/IK_leg"]

;; ── Skeleton3D: 6 bones, 1.0 spacing in +Y (identical to beast_demo) ────
[node name="Skeleton3D" type="Skeleton3D" parent="Body/IK_leg/Armature"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.098, 0, 0)
bones/0/name = "Bone"
bones/0/parent = -1
bones/0/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
bones/0/enabled = true
bones/0/position = Vector3(0, 0, 0)
bones/0/rotation = Quaternion(0, 0, 0, 1)
bones/0/scale = Vector3(1, 1, 1)
bones/1/name = "Bone.001"
bones/1/parent = 0
bones/1/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
bones/1/enabled = true
bones/1/position = Vector3(0, 1, 0)
bones/1/rotation = Quaternion(0, 0, 0, 1)
bones/1/scale = Vector3(1, 1, 1)
bones/2/name = "Bone.002"
bones/2/parent = 1
bones/2/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
bones/2/enabled = true
bones/2/position = Vector3(0, 1, 0)
bones/2/rotation = Quaternion(0, 0, 0, 1)
bones/2/scale = Vector3(1, 1, 1)
bones/3/name = "Bone.003"
bones/3/parent = 2
bones/3/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
bones/3/enabled = true
bones/3/position = Vector3(0, 1, 0)
bones/3/rotation = Quaternion(0, 0, 0, 1)
bones/3/scale = Vector3(1, 1, 1)
bones/4/name = "Bone.004"
bones/4/parent = 3
bones/4/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
bones/4/enabled = true
bones/4/position = Vector3(0, 1, 0)
bones/4/rotation = Quaternion(0, 0, 0, 1)
bones/4/scale = Vector3(1, 1, 1)
bones/5/name = "Bone.005"
bones/5/parent = 4
bones/5/rest = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
bones/5/enabled = true
bones/5/position = Vector3(0, 1, 0)
bones/5/rotation = Quaternion(0, 0, 0, 1)
bones/5/scale = Vector3(1, 1, 1)

;; ── FABRIK3D: 2 settings (magnet + foot) ─────────────────────────────────
;; Setting 0: magnet (bones 0-3) → pulls upper leg outward
;; Setting 1: foot (bones 0-5) → reaches SpringArm3D ground target
[node name="FABRIK3D" type="FABRIK3D" parent="Body/IK_leg/Armature/Skeleton3D"]
active = true
angular_delta_limit = 3.141592653589793
deterministic = true
setting_count = 2
settings/0/target_node = NodePath("../../../magnet")
settings/0/root_bone_name = "Bone"
settings/0/root_bone = 0
settings/0/end_bone_name = "Bone.003"
settings/0/end_bone = 3
settings/0/extend_end_bone = false
settings/0/joint_count = 4
settings/0/joints/0/rotation_axis = 3
settings/0/joints/0/limitation = null
settings/0/joints/1/rotation_axis = 3
settings/0/joints/1/limitation = null
settings/0/joints/2/rotation_axis = 3
settings/0/joints/2/limitation = null
settings/0/joints/3/rotation_axis = 3
settings/0/joints/3/limitation = null
settings/1/target_node = NodePath("../../../../SpringArm3D/FootTarget")
settings/1/root_bone_name = "Bone"
settings/1/root_bone = 0
settings/1/end_bone_name = "Bone.005"
settings/1/end_bone = 5
settings/1/extend_end_bone = false
settings/1/joint_count = 6
settings/1/joints/0/rotation_axis = 3
settings/1/joints/0/limitation = null
settings/1/joints/1/rotation_axis = 3
settings/1/joints/1/limitation = null
settings/1/joints/2/rotation_axis = 3
settings/1/joints/2/limitation = null
settings/1/joints/3/rotation_axis = 3
settings/1/joints/3/limitation = null
settings/1/joints/4/rotation_axis = 3
settings/1/joints/4/limitation = null
settings/1/joints/5/rotation_axis = 3
settings/1/joints/5/limitation = null

;; ── Magnet (knee direction) ──────────────────────────────────────────────
[node name="magnet" type="Marker3D" parent="Body/IK_leg"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.75, 1.68, 0)

;; ── SpringArm3D (points down, finds ground, child of Body) ──────────────
;; Rotated -90° on X: basis (1,0,0 / 0,0,-1 / 0,1,0)
;; Position: shoulder offset (2.2 out, -0.14 down from body center)
[node name="SpringArm3D" type="SpringArm3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, -1, 0, 1, -4.371139e-08, 2.2, -0.14, 0)
spring_length = 10.0
collision_mask = 1

;; Foot target — FABRIK3D setting 1 points here
[node name="FootTarget" type="Marker3D" parent="Body/SpringArm3D"]
