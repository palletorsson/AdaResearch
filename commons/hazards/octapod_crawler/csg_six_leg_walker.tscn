[gd_scene load_steps=2 format=3]

;; SixLegCritter — six FABRIK3D legs at 60deg intervals, walks around.
;; Exact beast_demo architecture: body at fixed Y, SpringArm3D finds ground,
;; FABRIK3D bends bone chain from body to foot target, magnet sets knee direction.

[ext_resource type="Script" path="res://commons/hazards/octapod_crawler/csg_walker_six.gd" id="1_script"]

[node name="CSGSixLegWalker" type="Node3D"]

;; ── Body ─────────────────────────────────────────────────────────────────
[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
script = ExtResource("1_script")

