[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://commons/artifacts/chroma_translation/chroma_translation.gd" id="1_chroma_translation"]

; Everything is built in _ready(): the Bauhaus stack and its translated copies, the
; floor rail (or the post for along = y), the plate and one collider box per copy.
; Nothing is authored here, so there is nothing here to drift out of step with the
; script.
;
; THE SCRIPT IS ON THE ROOT. GridInteractablesComponent sets config_* metadata and
; calls apply_grid_config on the ROOT node; a scriptless root with the logic on a
; child makes every map token silently unreachable.
;
; The root is a plain Node3D. The collider is a StaticBody3D child built at run time
; with one BoxShape3D per copy, sized from the same numbers as the meshes.

[node name="ChromaTranslation" type="Node3D"]
script = ExtResource("1_chroma_translation")
