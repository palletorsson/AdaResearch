    "graphtheory": {
      "order": 19,
      "operations": {
        "connect": {
          "description": "Add an edge between two atoms",
          "input": "atom atom",
          "output": "graph",
          "parameters": ["weight"],
          "taught_by": "GT_Foundations"
        },
        "traverse": {
          "description": "Walk edges between nodes",
          "input": "graph",
          "output": "path",
          "parameters": ["strategy"],
          "taught_by": "GT_Pathfinding"
        },
        "layout": {
          "description": "Position graph nodes via force simulation",
          "input": "graph",
          "output": "graph",
          "parameters": [],
          "taught_by": "GT_Layout"
        },
        "flow": {
          "description": "Route maximum capacity through a graph",
          "input": "graph source sink",
          "output": "flow",
          "parameters": [],
          "taught_by": "GT_Flow"
        }
      }
    }
  },
  "composition_rules": {
    "description": "Any operation can compose with any form in its input domain, regardless of which sequence produced that form. A fractal (sequence 10) can be deformed (sequence 13) by a flock (sequence 14) of learning creatures (sequence 15) in non-Euclidean space (sequence 16). The biome is the compositional closure of all unlocked operations.",
    "rules": [
      "Operations compose in the order they are applied; composition is not commutative",
      "An operation can consume any form of its declared input type, regardless of origin sequence",
      "Operations from sequence N are available in all maps of sequences N..19",
      "The biome applies only operations available at the current sequence",
      "Cross-sequence composition is the primary evidence of understanding"
    ]
  }
}
