          "description": "A form that describes itself",
          "input": "any",
          "output": "paradoxical",
          "parameters": [],
          "taught_by": "Godel_Incompleteness"
        },
        "impossible": {
          "description": "Compose locally-valid pieces into a globally-impossible whole",
          "input": "any*",
          "output": "paradoxical",
          "parameters": [],
          "taught_by": "Escher_Impossible"
        }
      }
    },
    "qfeplaboratory": {
      "order": 17,
      "operations": {
        "tune_lambda": {
          "description": "Adjust the entropy drive \u2014 where the system sits between order and chaos",
          "input": "any",
          "output": "tunable",
          "parameters": ["lambda"],
          "taught_by": "QFEP_Lambda_Spectrum"
        },
        "tune_phi": {
          "description": "Adjust sensitivity to entropy change",
          "input": "any",
          "output": "tunable",
          "parameters": ["phi"],
          "taught_by": "QFEP_Phi"
        },
        "dissolve": {
          "description": "Return a form to its parameter state",
          "input": "any",
          "output": "parameters",
          "parameters": [],
          "taught_by": "dissolving_form"
        },
        "re_become": {
          "description": "Generate a form from tuned parameters",
          "input": "parameters",
          "output": "tunable",
