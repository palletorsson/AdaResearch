          "input": "fitness",
          "output": "best_params",
          "parameters": ["particles"],
          "taught_by": "particle_swarm_optimization"
        }
      }
    },
    "machinelearning": {
      "order": 15,
      "operations": {
        "classify": {
          "description": "Assign a category to an input",
          "input": "features",
          "output": "label",
