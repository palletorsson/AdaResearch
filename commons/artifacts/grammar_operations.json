          "input": "latent",
          "output": "generated",
          "parameters": ["model"],
          "taught_by": "ML_Generative"
        }
      }
    },
    "foundationscrisis": {
      "order": 16,
      "operations": {
        "non_euclidean": {
          "description": "Construct geometry that violates the parallel postulate",
