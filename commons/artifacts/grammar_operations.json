        },
        "reaction_diffusion": {
          "description": "Grow patterns via coupled chemistry",
          "input": "surface",
          "output": "pattern",
          "parameters": ["feed", "kill"],
          "taught_by": "turing_pattern_generator"
        }
      }
    },
    "swarmintelligence": {
      "order": 14,
      "operations": {
        "flock": {
          "description": "Many agents, each with local rules, act as one",
          "input": "agent*",
          "output": "swarm",
          "parameters": ["separation", "alignment", "cohesion"],
          "taught_by": "boids_3d"
        },
        "stigmergy": {
          "description": "Agents leave traces others respond to",
