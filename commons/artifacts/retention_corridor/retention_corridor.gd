extends Node3D
class_name RetentionCorridor

## Retention Corridor — a SYNTHESIS artifact. One movement, kept five ways, in a row.
##
## @identity
## essence: Five bays on one shell, each holding the SAME single pass of a point
##   through space under a different regime of keeping — none, trace, lattice,
##   archive, wax. The word eleven artifacts each stand inside one value of,
##   laid out as the corridor it always was.
## desire: To be walked from end to end, and to be walked BACK. The first bay and
##   the last one both present a clean surface. They are not the same claim, and
##   the only way to know is to look under the sheet.
## critical_parameter: `movement` — the pass under the corridor. The five regimes
##   never move and never change their order; only what they are records OF.
## triggers: none. Nothing here animates, nothing here is picked up, nothing here
##   is random. The corridor is the standing record, which is the only part of
##   this family a still photograph was ever able to hold.
## emerges: keeping more is not recovering more. Legibility peaks at the second
##   bay and retention peaks at the fourth, and they are not the same bay. Where
##   the two part company depends on how much the movement wandered.
## needs: one pass computed once [has, _run]; five bays that differ in nothing but
##   the regime [has]; a sheet that is lifted rather than described [has]; no
##   random number anywhere [has]
## relationships: Synthesised from the eleven artifacts that declare `retention` —
##   see the registry block. It replaces none of them.
## truth: "Clear" is the politest word a machine knows for "kept, where you can no
##   longer see it." Freud wrote that down in 1925 about a child's toy; this
##   corridor is the eleven places the project has since said it, standing in a
##   row so the sentence can be checked rather than believed.

# ═══════════════════════════════════════════════════════════════════════════
# SYNTHESIS DNA — `movement`
# ═══════════════════════════════════════════════════════════════════════════
#
# BORN PROMOTED (2026-08-06). This artifact did not exist before the promotion
# batches that produced its sources. It is the argument those batches left in
# registry notes, built as a body.
#
# WHAT IT IS. A shell 3.2 m long with five bays cut into it. Each bay is a box
# you look into — 0.50 wide, 0.60 high, 0.42 deep — and each holds one regime of
# `retention`, in the order ten of the eleven members declare them:
#
#   none      the bay is built and EMPTY. Not a gap in the row: a bay, with its
#             back wall and its sill, holding nothing. "Space keeps nothing you
#             did not just do" is a claim, and a claim needs somewhere to stand
#   trace     one pass, in the ink it was written with, exactly where it went
#   lattice   the bay is ruled — a field of pale nodes on the back wall and on
#             the floor — and the same pass is admitted only at legal positions.
#             A stair, not a diagonal
#   archive   nine passes at once, none dimmed by age, overlapping. Nothing is
#             discarded, so — depending entirely on the movement — nothing may
#             be readable
#   wax       the Wunderblock. A dark slab at the back, the impressions of five
#             passes sunk into it graded by age, and the clearing sheet LIFTED
#             at its hinge so both layers are in one frame at once
#
# ONE PASS, EVALUATED ONCE. `_run()` fills `_pass0` from `_sample()` at build
# time, and trace, lattice, archive's newest and wax's freshest impression all
# read that one array. This is evidence_ladder's rule taken as a construction
# constraint rather than quoted: an exhibit that draws its subject twice is an
# exhibit that will eventually disagree with itself. The older passes at archive
# and wax are the SAME function at earlier phases — which is what "nine throws"
# has always meant in this family — at the phase literals the sources use
# (PHASE0 = 1.31, archive +0.83 per pass, wax +1.70 per pass), kept character for
# character so the corridor and its members draw the same history.
#
# `retention` IS REFUSED AS THIS ARTIFACT'S AXIS, on the record. Every one of the
# eleven members uses the word to stand in ONE regime and forgo the other four;
# on this shell all five are standing at once, and that simultaneity is the whole
# object. An axis whose every value demolishes four fifths of the exhibit is not
# a variation of it. That is evidence_ladder's ruling on `evidence`, and it lands
# here for the same reason and with more force, because there are five bays and
# not four. The word is EXHIBITED — it names the bays, it names the artifact —
# and what turns instead is the pass underneath it.
#
# `movement` IS THE FAMILY'S OWN CENSUS, not an invention. All eleven members
# were read and every one of them makes exactly one kind of mark:
#
#   hand      draw_dot, draw_dot_time_domain, draw_triangle_faces,
#             grab_sphere_point_snap, mystic_writing_pad — a hand writing in a
#             frame. Five of eleven, and the family's plainest case, so it is
#             the default
#   reading   interactive_point_origin_force — a measurement from where you are
#             holding it back to the origin, "drawn while held and hidden the
#             instant you let go". A straight line
#   cycle     oscillation_controlled_cube, y_oscillation_cube,
#             rotating_cube_demo — a driven oscillation. The mark that returns
#             to itself
#   throw     mario_cube_time_trace — a thrown body's history, and the one
#             member that puts TIME on a spatial axis, so this pass recedes into
#             the bay's depth exactly as that artifact's record recedes into +Z
#   walk      player_trace — a body crossing a room. "The same five claims, same
#             order, one storey down", so this pass lies on the bay FLOOR
#
# 5 + 1 + 3 + 1 + 1 = 11. The value list partitions the sources exactly; no mark
# kind is left out and none is invented.
#
# WHY THAT DECLARED ORDER — hand, reading, cycle, throw, walk. build_dna_gallery
# trims value lists from the TAIL. The default goes first, and the rest run in
# DESCENDING separation from it, so a truncated sweep keeps the frames that are
# furthest apart and the weakest pair is the first thing dropped rather than the
# last thing kept. `hand` and `walk` are the two wandering lines on this axis and
# they are the pair most at risk of photographing alike; they sit at opposite
# ends of the list on purpose. This is not the family's habit — see the registry
# note on the two orders `retention` is declared in — and it is a different rule
# for a different job.
#
# THE ARGUMENT THE CORRIDOR MAKES, and no member can: the row is not monotone.
# Read left to right it looks like more and more is kept, and it is. Read for
# what you could RECOVER and it turns twice — `lattice` keeps less than `trace`
# does, because it keeps only what was legal, and `archive` keeps the most of any
# bay and can be read the least. Legibility peaks at bay two, retention at bay
# four, and the distance between them is set by how much the movement wandered.
# `reading` is a straight line and survives all five bays; `hand` is a scribble
# and is mud by the fourth. That is the axis's real content: not five costumes,
# but five different answers to the question of where a mark stops being
# recoverable, asked of one apparatus.
#
# AND THE TWO CLEAN SURFACES. The first bay and the last one both present nothing
# to look at, and that coincidence is Freud's entire essay. `none` is an honest
# whiteboard; `wax` is the surface that says "cleared" over a depth that kept the
# lot. The corridor puts them at the two ENDS so a visitor meets them a walk
# apart, and it lifts the sheet at the fifth bay so the difference is visible in
# one still instead of being asserted in a caption.
#
# THE LIFT IS THE SYNTHESIS'S OWN CONTRIBUTION. mystic_writing_pad performs the
# lift in `_process` — every clear_interval it sinks the current trace and wipes
# the surface — which makes the family's central mechanism a TIME-DOMAIN event
# and therefore invisible to the capture bench that grades everything else here.
# Both `draw_dot` and `mario_cube_time_trace` fell back to a shut sheet with
# strokes behind it, which photographs as `archive` with a lid on. This corridor
# freezes the lift at its hinge: the sheet raised, clean, breaking the plane of
# the corridor, and under it the impressions the lift did not erase.
#
# Fully deterministic. There is not one call to randf, randi or randomize in this
# file, so no seed and no fixture; every build of a given value is the same
# object down to the vertex, and there is no _process at all.
#
# Usage in map_data.json:
#   "retention_corridor"                    — the hand
#   "retention_corridor#movement:reading"
#   "retention_corridor#movement:walk"

## The pass under the corridor. The five regimes are invariant.
@export_enum("hand", "reading", "cycle", "throw", "walk") var movement: String = "hand"

## Allow-list. An unknown word in a map token falls back to the shipped hand
## rather than stranding a placement with five empty bays.
const MOVEMENTS: PackedStringArray = ["hand", "reading", "cycle", "throw", "walk"]

## The five regimes, left to right, in the order 10 of the 11 members declare
## them. Exhibited, never turned — see the header.
const REGIMES: PackedStringArray = ["none", "trace", "lattice", "archive", "wax"]

# ── the shell ────────────────────────────────────────────────────────────
const PITCH: float = 0.62             ## bay to bay
const FIN_W: float = 0.12             ## the pilaster between two bays
const BAY_W: float = 0.50             ## bay interior
const BAY_H: float = 0.60
const BAY_D: float = 0.42
const SILL_Y: float = 0.86            ## bay floor, world
const BAY_CY: float = SILL_Y + BAY_H * 0.5
const BACK_Z: float = -BAY_D * 0.5    ## the bay's back plane
const WALL_T: float = 0.05            ## back wall thickness
const FIN_FRONT: float = 0.28         ## how far the pilasters stand proud
const LINTEL_H: float = 0.10
const CORNICE_H: float = 0.04
const CORNICE_OVER: float = 0.03      ## the cornice's overhang each side

# ── the marks ────────────────────────────────────────────────────────────
## DOT SIZE AND CADENCE ARE ARITHMETIC, not taste, and they are not the sources'.
## draw_dot sampled 54 dots at r = 0.010 for a 0.5 m frame standing ALONE in the
## capture. Here five bays share one frame: at framing 0.55 the camera sits 6.30 m
## out, the visible frame is 3.855 m across, and a 760 px still is therefore about
## 197 px per metre. A source-sized dot lands at 3.9 px and a whole pass sinks into
## the noise floor the bite critic measures against — the documented way an axis
## reads as inert when it is not. At r = 0.017 a bead is 6.7 px.
##
## THE CADENCE WAS MEASURED, not chosen. The five movements have very different
## arc lengths inside one bay — cycle runs 1.98 m of sine, hand 1.34 m of
## scribble, throw 0.95 m, walk 0.72 m, reading 0.50 m of straight line — so one
## sample count cannot make them all read alike. At 42 the longest pass still
## beads at under 3 px of daylight and the shortest fuses into a rod, the correct
## way round: a straight measurement SHOULD read as one bar and a scribble should
## read as the dense set of point samples draw_dot's truth statement says a curve
## is. At 28 (the first draft) hand and cycle broke into a dotted line with 3 to 9
## px of daylight between beads and stopped reading as strokes at all.
const DOT_R: float = 0.017
const SAMPLES: int = 42

## The ruling, and the quantum the lattice bay rounds to. Nodes are drawn at 0.70
## of the bead so the ruling reads as ruling and not as a second stroke.
##
## 0.058 AND NOT 0.060, which is arithmetic and was a bug first. The bay's usable
## half-width is BAY_W/2 - DOT_R = 0.233 m. At 0.060 the outermost legal column
## falls at 0.240 — outside the bay — so every snapped bead near the edge had to
## be clamped, and clamped beads sit BETWEEN the pinpricks. At 0.058 the fourth
## column lands at 0.232 and fits. A stair that does not land on the nodes is a
## picture of nothing, so the ruling and the rounding are built from ONE integer
## range (see _snap and _bay_lattice) rather than from two expressions that agree
## today.
const GRID_STEP: float = 0.058
const GRID_SCALE: float = 0.70

## The phase literals, taken character for character from draw_dot._ret_* and
## mario_cube_time_trace._ret_*, so the corridor's history and its members'
## histories are the same history.
const PHASE0: float = 1.31
const ARCHIVE_STRIDE: float = 0.83
const ARCHIVE_N: int = 9
const WAX_STRIDE: float = 1.70
const WAX_N: int = 5

# ── palette, taken from mystic_writing_pad and the family's wax builders ──
const C_INK := Color(0.80, 0.97, 1.0)          ## mystic_writing_pad.ink_color
const C_GHOST := Color(0.95, 0.62, 0.35)       ## mystic_writing_pad.ghost_color
const C_WAX := Color(0.10, 0.085, 0.095)       ## draw_dot._ret_wax / mario._ret_wax
const C_SHEET := Color(0.62, 0.65, 0.70, 0.30) ## the same three, character for character
const C_NODE := Color(0.52, 0.60, 0.68)        ## the family's lattice node colour
const C_FRAME := Color(0.80, 0.12, 0.12)       ## mystic_writing_pad.frame_color — the toy's red
const C_STONE := Color(0.27, 0.26, 0.27)
const C_BACK := Color(0.13, 0.13, 0.15)
const C_CHALK := Color(0.88, 0.90, 0.95)

var _root: Node3D = null
var _built: bool = false

## THE ONE PASS. Positions in a unit box, -0.5..0.5 on every axis, filled once in
## _run() and read by every bay that keeps anything.
var _pass0: PackedVector3Array = PackedVector3Array()


func _ready() -> void:
	_read_grid_config_meta()
	_rebuild()
	_built = true


# ═══════════════════════════════════════════════════════════════════════════
# THE MOVEMENT — one rule, and the only place it is written
# ═══════════════════════════════════════════════════════════════════════════

## One sample of the pass, in a unit box. `phase` selects WHICH pass: PHASE0 is
## the one the corridor is about, and larger values are earlier ones — the same
## hand, the same body, the same throw, before this one.
##
## Every branch is trigonometry on u and phase. No randf, no randi, no time, no
## node lookup: two builds of the same value are the same object.
func _sample(u: float, phase: float) -> Vector3:
	if movement == "reading":
		return _mv_reading(u, phase)
	if movement == "cycle":
		return _mv_cycle(u, phase)
	if movement == "throw":
		return _mv_throw(u, phase)
	if movement == "walk":
		return _mv_walk(u, phase)
	return _mv_hand(u, phase)


## HAND — draw_dot's own curve, in draw_dot's own terms, rescaled to the unit box.
## A stroke that drifts left to right while wandering, doubling back across itself.
## Five of the eleven sources make this mark and it is the one their record
## apparatus was written for. Slightly out of plane, because a hand in the air is.
func _mv_hand(u: float, phase: float) -> Vector3:
	var a: float = u * TAU * 1.15 + phase
	var x: float = (u - 0.5) * 0.92 + 0.22 * sin(a * 1.6)
	var y: float = 0.42 * sin(a * 0.95 + phase * 1.3) * (0.55 + 0.45 * sin(a * 0.42))
	var z: float = 0.15 * sin(a * 0.62 + phase * 0.8)
	return Vector3(clampf(x, -0.46, 0.46), clampf(y, -0.46, 0.46), clampf(z, -0.44, 0.44))


## READING — interactive_point_origin_force's line to origin. A measurement taken
## from wherever the point was being held, back to the marker, and it is STRAIGHT.
## That artifact keeps its archive "fanned to the same marker from seven past
## positions", so phase swings the held end and leaves the marker where it is.
##
## This is the movement furthest from the default, and it is second in the
## declared list for exactly that reason.
func _mv_reading(u: float, phase: float) -> Vector3:
	var hold: Vector3 = Vector3(
		-0.40 * cos(phase * 0.71),
		0.30 + 0.16 * sin(phase * 1.13),
		0.34 * sin(phase * 0.53))
	return hold.lerp(_reading_marker(), clampf(u, 0.0, 1.0))


## Where every reading on this axis ends. Off centre so the fan opens.
func _reading_marker() -> Vector3:
	return Vector3(0.20, -0.26, -0.10)


## CYCLE — y_oscillation_cube's y = A sin(wt), traversing. Two full periods at one
## amplitude: the mark that returns to itself. It is deliberately PLANAR, because
## the three sources on this value drive one channel from one signal and the
## regularity is the whole of what they argue. `phase` shifts it in the cycle,
## which is what an earlier pass of an oscillator is.
func _mv_cycle(u: float, phase: float) -> Vector3:
	var x: float = lerpf(-0.44, 0.44, u)
	var y: float = 0.40 * sin(u * TAU * 2.0 + phase)
	return Vector3(x, y, 0.0)


## THROW — mario_cube_time_trace's record: a body's history with TIME ON A SPATIAL
## AXIS. That artifact pushes its samples into +Z at time_axis_speed, so this pass
## recedes into the bay's DEPTH while the ballistic arc rises and falls, which is
## the one movement here that uses all three of the bay's dimensions for three
## different things. `phase` throws it a little harder or flatter.
func _mv_throw(u: float, phase: float) -> Vector3:
	var arc: float = 4.0 * u * (1.0 - u)
	var apex: float = 0.36 - 0.07 * sin(phase)
	var y: float = lerpf(-0.42, apex, arc)
	var x: float = 0.13 * sin(phase * 0.9) + 0.10 * (u - 0.5)
	# 0.40 and not 0.44: this is the one movement that runs the full depth of the
	# bay, and at the wax bay it has to clear the slab's front face rather than
	# press into it. Measured against BACK_Z, not guessed.
	var z: float = lerpf(-0.40, 0.40, u)
	return Vector3(clampf(x, -0.46, 0.46), y, z)


## WALK — player_trace's body at room scale. That artifact's note is explicit that
## its record "lies on the ground plane rather than on a drawing plane", the same
## five claims "one storey down", so this pass runs LOW across the bay floor and
## does its wandering in depth rather than in height.
func _mv_walk(u: float, phase: float) -> Vector3:
	var a: float = u * TAU * 1.15 + phase
	var x: float = lerpf(-0.44, 0.44, u)
	var y: float = -0.40 + 0.030 * sin(a * 2.1 + phase)
	var z: float = 0.36 * sin(a * 0.80 + phase) * (0.60 + 0.40 * sin(a * 0.35))
	return Vector3(x, y, clampf(z, -0.44, 0.44))


## Fill the canonical pass once. Every bay that keeps anything reads this array;
## nothing on this shell integrates, samples or derives the movement a second
## time, so there is nothing here that can drift out of agreement with anything
## else here.
func _run() -> void:
	_pass0.clear()
	for i in range(SAMPLES):
		_pass0.append(_sample(float(i) / float(SAMPLES - 1), PHASE0))


## Unit box → bay-local metres. The bay is not a cube, so the mapping is
## anisotropic; it is the same anisotropy in all five bays, which is what makes
## the row a comparison.
func _place(p: Vector3) -> Vector3:
	return Vector3(p.x * BAY_W, p.y * BAY_H, p.z * BAY_D)


# ── THE RULING, AS ONE INTEGER RANGE ─────────────────────────────────────
# The lattice bay draws pinpricks and snaps a pass onto them. Those are two
# separate pieces of code and they MUST land on the same points, so both of them
# read the ranges below and neither computes a position of its own. The first
# draft built the ruling from `-hw + k*step` (a field starting at the bay's edge)
# and snapped the pass with `round(p/step)*step` (a field centred on zero). Those
# two grids differ by a fraction of a step everywhere, so the stair would have
# floated between the pinpricks — the axis's most legible bay quietly showing a
# quantisation onto nothing.

## How many rungs the ruling reaches from centre, per axis. Derived from the bay
## interior less a bead's radius, so a node — and therefore a snapped bead — can
## never sit inside the masonry.
func _rungs() -> Vector3i:
	return Vector3i(
		int((BAY_W * 0.5 - DOT_R) / GRID_STEP),
		int((BAY_H * 0.5 - DOT_R) / GRID_STEP),
		int(minf(BAY_D * 0.5 - 0.008, -BACK_Z - 0.030) / GRID_STEP))


## A position admitted onto the ruling: rounded to the nearest rung and refused
## any rung the ruling does not have. grab_sphere_point_snap's claim, exactly —
## a position had to be legal before it counted.
func _snap(p: Vector3) -> Vector3:
	var k: Vector3i = _rungs()
	return Vector3(
		float(clampi(int(round(p.x / GRID_STEP)), -k.x, k.x)) * GRID_STEP,
		float(clampi(int(round(p.y / GRID_STEP)), -k.y, k.y)) * GRID_STEP,
		float(clampi(int(round(p.z / GRID_STEP)), -k.z, k.z)) * GRID_STEP)


# ═══════════════════════════════════════════════════════════════════════════
# BUILD
# ═══════════════════════════════════════════════════════════════════════════

func _rebuild() -> void:
	if is_instance_valid(_root):
		remove_child(_root)
		_root.queue_free()
	_root = Node3D.new()
	_root.name = "Corridor_%s" % movement
	add_child(_root)

	_run()
	_shell(_root)

	for i in range(REGIMES.size()):
		var bay := Node3D.new()
		bay.name = "Bay_%s" % REGIMES[i]
		bay.position = Vector3(_bay_x(i), BAY_CY, 0.0)
		_root.add_child(bay)
		_fill_bay(bay, REGIMES[i])


func _bay_x(i: int) -> float:
	return (float(i) - 0.5 * float(REGIMES.size() - 1)) * PITCH


## The shell — plinth, back wall, six pilasters, lintel, cornice, and one red
## sill per bay. Identical at every value of the axis and identical between bays,
## so the RECORD is the only thing that varies, both across the row and across a
## sweep. Every mesh here is a MeshInstance3D box, and the shell encloses every
## MultiMesh instance in the artifact — which is why no layers = 0 extent anchor
## is needed and the capture AABB is the real body.
func _shell(root: Node3D) -> void:
	var n: int = REGIMES.size()
	var width: float = float(n) * PITCH + FIN_W
	var stone: StandardMaterial3D = _matte(C_STONE)
	var back: StandardMaterial3D = _matte(C_BACK)
	var frame: StandardMaterial3D = _matte(C_FRAME.darkened(0.45))
	var reveal: StandardMaterial3D = _mat(C_FRAME, 0.35)

	var depth: float = FIN_FRONT - (BACK_Z - WALL_T)
	var mid_z: float = (FIN_FRONT + BACK_Z - WALL_T) * 0.5

	# plinth — the bays stand on it, and the nameplates are engraved on its face
	root.add_child(_box(Vector3(0.0, SILL_Y * 0.5, mid_z * 0.6),
		Vector3(width, SILL_Y, depth * 0.86), stone))

	# the back wall, one slab behind all five bays
	root.add_child(_box(Vector3(0.0, SILL_Y + BAY_H * 0.5, BACK_Z - WALL_T * 0.5),
		Vector3(width, BAY_H, WALL_T), back))

	# the pilasters — n + 1 of them, standing proud of the bay mouths
	for i in range(n + 1):
		var x: float = (float(i) - 0.5 * float(n)) * PITCH
		root.add_child(_box(
			Vector3(x, SILL_Y + BAY_H * 0.5, (FIN_FRONT + BACK_Z - WALL_T) * 0.5),
			Vector3(FIN_W, BAY_H, FIN_FRONT - BACK_Z + WALL_T), frame))

	# lintel and cornice
	root.add_child(_box(Vector3(0.0, SILL_Y + BAY_H + LINTEL_H * 0.5, mid_z),
		Vector3(width, LINTEL_H, depth), frame))
	root.add_child(_box(
		Vector3(0.0, SILL_Y + BAY_H + LINTEL_H + CORNICE_H * 0.5, mid_z),
		Vector3(width + CORNICE_OVER * 2.0, CORNICE_H, depth + CORNICE_OVER), stone))

	# one bright sill per bay — the magic slate's red frame, quoted where it reads
	for i in range(n):
		root.add_child(_box(Vector3(_bay_x(i), SILL_Y + 0.012, FIN_FRONT - 0.055),
			Vector3(BAY_W, 0.024, 0.028), reveal))
		root.add_child(_text(REGIMES[i],
			Vector3(_bay_x(i), SILL_Y - 0.10, FIN_FRONT - 0.038), 50, 0.0018, C_CHALK))

	# THE HEADER DOES NOT NAME THE AXIS VALUE, deliberately — a caption carrying it
	# would let a measurement of the record be padded by a measurement of the label.
	# Every pixel that moves across this axis is a mark the pass made.
	root.add_child(_text("one movement  ·  five records",
		Vector3(0.0, SILL_Y + BAY_H + LINTEL_H + CORNICE_H + 0.065, FIN_FRONT - 0.04),
		44, 0.0018, C_CHALK))


func _fill_bay(bay: Node3D, regime: String) -> void:
	match regime:
		"none":
			# BUILT AND EMPTY, and that is the value, not an omission. The bay has
			# its back wall, its sill and its plate like the other four; what it
			# does not have is a record. Identical at every value of `movement` by
			# construction — the same way evidence_ladder's first pier is.
			pass
		"trace":
			_bay_trace(bay)
		"lattice":
			_bay_lattice(bay)
		"archive":
			_bay_archive(bay)
		"wax":
			_bay_wax(bay)


## TRACE — the pass, kept in the ink it was written with, exactly where it went.
## The most legible bay on the shell, and the second one, which is the corridor's
## first turn: everything after this keeps MORE and shows LESS.
func _bay_trace(bay: Node3D) -> void:
	_marker(bay, C_INK, 1.4)
	_stroke(bay, PHASE0, C_INK, 1.6, 0.0, false)


## LATTICE — the ruling first, then the pass admitted onto it. A field of pale
## nodes on the back wall and a second field on the bay floor, at GRID_STEP, and
## the same array snapped to that step in all three axes: a stair, not a diagonal.
##
## The ruling is the dominant read, exactly as it is in the members: regular
## pinpricks where every other bay shows wander. grab_sphere_point_snap's claim,
## given a bay — "a position had to be LEGAL before it counted" — and the reason
## this bay keeps LESS than the one before it while appearing to keep the same.
func _bay_lattice(bay: Node3D) -> void:
	var k: Vector3i = _rungs()
	var nx: int = k.x * 2 + 1
	var ny: int = k.y * 2 + 1
	var nz: int = k.z * 2 + 1
	var small: Basis = Basis.IDENTITY.scaled(Vector3.ONE * GRID_SCALE)

	# the back wall's ruling — every legal (x, y), on the rungs _snap rounds to
	var wall := _mm("LatticeWall", _mat(C_NODE, 0.5))
	var wm: MultiMesh = wall.multimesh
	wm.instance_count = nx * ny
	var a: int = 0
	for cx in range(nx):
		for cy in range(ny):
			wm.set_instance_transform(a, Transform3D(small, Vector3(
				float(cx - k.x) * GRID_STEP,
				float(cy - k.y) * GRID_STEP,
				BACK_Z + 0.014)))
			a += 1
	bay.add_child(wall)

	# the floor's ruling — mario_cube_time_trace's space-time floor, which is what
	# makes the quantisation in DEPTH legible instead of merely true. `throw` is
	# the movement this exists for: its time axis IS the bay's depth, so without a
	# ruling on the floor its stair in time would be a claim nobody could check.
	var floor_grid := _mm("LatticeFloor", _mat(C_NODE, 0.42))
	var fm: MultiMesh = floor_grid.multimesh
	fm.instance_count = nx * nz
	var b: int = 0
	for cx2 in range(nx):
		for cz in range(nz):
			fm.set_instance_transform(b, Transform3D(small, Vector3(
				float(cx2 - k.x) * GRID_STEP,
				-BAY_H * 0.5 + 0.016,
				float(cz - k.z) * GRID_STEP)))
			b += 1
	bay.add_child(floor_grid)

	_marker(bay, C_INK, 1.2)
	_stroke(bay, PHASE0, C_INK, 1.6, 0.0, true)


## ARCHIVE — nine passes at once, none dimmed by age, all at full brightness.
## The count and the stride are draw_dot's and mario_cube_time_trace's, kept.
##
## THIS IS WHERE THE AXIS BITES, and what it does depends entirely on the
## movement. Nine scribbles are mud; nine straight readings are a fan you can
## still count; nine phase-shifted cycles braid instead of blur. Total retention
## and total illegibility are the same picture only for a mark that wandered.
func _bay_archive(bay: Node3D) -> void:
	_marker(bay, C_INK, 1.2)
	for i in range(ARCHIVE_N):
		_stroke(bay, PHASE0 + ARCHIVE_STRIDE * float(i), C_INK, 1.35, 0.0, false)


## WAX — the Wunderblock, and the only bay that needed a decision rather than a
## translation.
##
## The members all build it shut: slab, faint graded strokes, translucent sheet in
## front. Photographed head on that is `archive` with a lid, because the sheet has
## no way to declare itself as a SURFACE and the impressions have no way to
## declare themselves as UNDERNEATH. mystic_writing_pad solves it in time — it
## lifts the sheet every clear_interval in _process — which is precisely the class
## of evidence this bench cannot hold.
##
## So the sheet is caught HALF PEELED. It covers the left of the bay and stops;
## the right is bare wax. The five impressions run the full width, so the SAME
## strokes are naked on one side of the peel edge and dimmed behind celluloid on
## the other, continuous across a hard vertical line. That is the depth cue a shut
## pane cannot give: not "there is something behind glass", but "this glass is
## over that, and it is the same mark either way". The peel's free edge is bright
## and its lip curls off the plane, so the pane is legible as a physical sheet
## rather than as haze.
##
## MEASURED, not styled. A sheet hinged at the top and swung open — the first
## build — puts its free edge 0.27 m forward, which is 0.125 m past the pilasters:
## it leaves the shell, inflates the union AABB every other bay is framed against,
## and buys almost no vertical separation, because a lid rotating about its top
## edge swings OUT (sheet_h * sin) far faster than it rises (sheet_h * (1 - cos)).
## At the angle needed to see under it, it was no longer in the corridor. The peel
## costs 0.05 m of projection and shows both layers better.
##
## The surface forgets. The depth remembers. In one frame.
func _bay_wax(bay: Node3D) -> void:
	var hw: float = BAY_W * 0.47
	var hh: float = BAY_H * 0.47

	# the depth that remembers
	var slab := _box(Vector3(0.0, 0.0, BACK_Z + 0.012),
		Vector3(hw * 2.0, hh * 2.0, 0.016), _matte(C_WAX))
	bay.add_child(slab)

	# The impressions, freshest first, each older one fainter. AGE IS GRADED BY
	# FADING AND NOT BY SINKING, which is what draw_dot._ret_wax and
	# mario_cube_time_trace._ret_wax actually do — their depth offsets are four
	# millimetres and their grading is entirely in colour and emission energy. The
	# five planes here are 5 mm apart for the same reason theirs are: to keep five
	# coplanar dot clouds from z-fighting, not to carry the meaning. Sinking would
	# also have been impossible for `throw`, which already spends the bay's whole
	# depth on its time axis.
	for i in range(WAX_N):
		var f: float = float(WAX_N - i) / float(WAX_N)
		var c: Color = C_GHOST.lerp(C_WAX, 1.0 - f)
		_stroke(bay, PHASE0 + WAX_STRIDE * float(i), c, 0.45 + 1.1 * f,
			-0.010 + 0.005 * float(i), false)

	# THE PEEL. The pane's plane sits at 0.188, ahead of every impression the five
	# movements reach — `throw` spends the bay's whole depth on its time axis and
	# its newest bead lands at 0.178, so a pane any further back would be pierced
	# by the very stroke it is meant to be covering. 0.178 was the first number
	# here and it was exactly wrong: the bead and the pane were coplanar to the
	# millimetre and would have z-fought across the one bay whose whole argument
	# is which layer a mark is on.
	var sheet_z: float = 0.188
	var edge_x: float = 0.055
	var sheet_mat := StandardMaterial3D.new()
	sheet_mat.albedo_color = C_SHEET
	sheet_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	sheet_mat.roughness = 0.25
	sheet_mat.metallic = 0.0

	bay.add_child(_box(Vector3((edge_x - hw) * 0.5, 0.0, sheet_z),
		Vector3(edge_x + hw, hh * 2.0, 0.005), sheet_mat))

	# the free edge, bright, so the pane reads as a pane and not as haze
	bay.add_child(_box(Vector3(edge_x, 0.0, sheet_z),
		Vector3(0.016, hh * 2.0, 0.016), _mat(C_INK, 1.1)))

	# the curl — a short lip standing off the plane at the peel, so the sheet is
	# being LIFTED and not merely cut short. 0.09 m at 0.62 rad reaches z = 0.240,
	# inside the pilasters at 0.28.
	var lip := Node3D.new()
	lip.name = "Peel"
	lip.position = Vector3(edge_x, 0.0, sheet_z)
	lip.rotation = Vector3(0.0, -0.62, 0.0)
	bay.add_child(lip)
	lip.add_child(_box(Vector3(0.045, 0.0, 0.0),
		Vector3(0.090, hh * 2.0, 0.005), sheet_mat))

	# the rail the pane hangs from — the toy's frame, at the top of the bay
	bay.add_child(_box(Vector3(0.0, hh + 0.011, sheet_z),
		Vector3(hw * 2.0 + 0.02, 0.022, 0.020), _mat(C_FRAME, 0.25)))


## One pass, drawn as a dot cloud in the bay's local frame — not as a line,
## because this family's own truth statement is that a curve is a dense set of
## point samples and drawing it as a strip would quietly retract that.
##
## `on_ruling` admits it onto the ruling instead of into free space. `dz` separates the
## wax bay's five coplanar impressions.
func _stroke(bay: Node3D, phase: float, c: Color, energy: float, dz: float,
		on_ruling: bool) -> void:
	var mmi := _mm("Pass", _mat(c, energy))
	var mm: MultiMesh = mmi.multimesh
	mm.instance_count = SAMPLES
	for i in range(SAMPLES):
		var u: float = float(i) / float(SAMPLES - 1)
		# THE ONE ARRAY, where the phase is the corridor's own pass; anything
		# earlier is the same rule at an earlier phase, which is what an older
		# record IS. Nothing here re-derives the canonical movement.
		var raw: Vector3 = _pass0[i] if is_equal_approx(phase, PHASE0) else _sample(u, phase)
		var p: Vector3 = _place(raw)
		p.z += dz
		if on_ruling:
			p = _snap(p)
		# A MARK CANNOT LEAVE ITS BAY, and the same guard runs in all five bays so
		# the comparison stays a comparison. On the snapped path it never fires —
		# _rungs() is derived from these very bounds. On the free paths it was
		# checked value by value against the five movements' measured extents
		# rather than assumed, and it does not fire there either; it is here so
		# that a sixth movement cannot silently push a pass into the masonry.
		p = Vector3(
			clampf(p.x, -BAY_W * 0.5 + DOT_R, BAY_W * 0.5 - DOT_R),
			clampf(p.y, -BAY_H * 0.5 + DOT_R, BAY_H * 0.5 - DOT_R),
			clampf(p.z, BACK_Z + 0.030, BAY_D * 0.5 - 0.008))
		mm.set_instance_transform(i, Transform3D(Basis(), p))
	bay.add_child(mmi)


## The one piece of furniture a movement can bring with it. Only `reading` has
## any: interactive_point_origin_force's measurements all end at a marker beside
## the point, and its archive is seven readings "fanned to the same marker", so
## the marker has to be there for the fan to be a fan rather than a scatter.
func _marker(bay: Node3D, c: Color, energy: float) -> void:
	if movement != "reading":
		return
	var mi := MeshInstance3D.new()
	mi.name = "Origin"
	var sm := SphereMesh.new()
	sm.radius = 0.026
	sm.height = 0.052
	mi.mesh = sm
	mi.material_override = _mat(c, energy)
	mi.position = _place(_reading_marker())
	bay.add_child(mi)


# ═══════════════════════════════════════════════════════════════════════════
# CONFIG
# ═══════════════════════════════════════════════════════════════════════════

## Grid config arrives twice and by two routes: GridInteractablesComponent sets
## config_<key> metadata on the instantiated root and then calls
## apply_grid_config, and the capture harness calls apply_grid_config before the
## scene enters the tree. Reading the metadata on the way in means the corridor
## is built once, correctly, instead of built as `hand` and then torn down.
func _read_grid_config_meta() -> void:
	var node: Node = self
	while node != null:
		if node.has_meta("config_movement"):
			var want: String = _clean(str(node.get_meta("config_movement")))
			if MOVEMENTS.has(want):
				movement = want
		node = node.get_parent()


## Tokens: #movement:reading · #movement:cycle · #movement:throw · #movement:walk
##
## GUARDED FOUR WAYS — the key must be present, the value must be one the code can
## build, it must differ from the one already standing, and _ready must have built
## once. A placement carrying any other token reaches here with no `movement` key
## at all, and the grid reaches this twice for one placement; an unguarded rebuild
## would tear down and re-raise five bays on both of those, for nothing.
func apply_grid_config(config: Dictionary) -> void:
	if not config.has("movement"):
		return
	var want: String = _clean(str(config["movement"]))
	if not MOVEMENTS.has(want):
		return
	if want == movement:
		return
	movement = want
	if not _built:
		return          # _ready has not built yet and will build this value itself
	_rebuild()


func _clean(raw: String) -> String:
	return raw.strip_edges().to_lower()


# ═══════════════════════════════════════════════════════════════════════════
# BUILDERS
# ═══════════════════════════════════════════════════════════════════════════

func _mat(c: Color, emit: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.emission_enabled = true
	m.emission = c
	m.emission_energy_multiplier = emit
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return m


func _matte(c: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = 0.88
	m.metallic = 0.0
	return m


func _box(p: Vector3, s: Vector3, m: Material) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = s
	mi.mesh = bm
	mi.material_override = m
	mi.position = p
	return mi


## A dot cloud. One MultiMesh per stroke, as the members build them, so a stroke
## keeps its own colour and energy. All of these sit inside a bay, and every bay
## sits inside the shell, so the MeshInstance3D extent already bounds them.
func _mm(nm: String, mat: Material) -> MultiMeshInstance3D:
	var mmi := MultiMeshInstance3D.new()
	mmi.name = nm
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	var dot := SphereMesh.new()
	dot.radius = DOT_R
	dot.height = DOT_R * 2.0
	dot.radial_segments = 6
	dot.rings = 3
	mm.mesh = dot
	mm.instance_count = 0
	mmi.multimesh = mm
	mmi.material_override = mat
	return mmi


## Non-billboard on purpose. LabelFramer frames HANGING labels and leaves text
## that already lies on a body alone — these lie on the plinth and on the
## cornice, so they keep their place and add no plate to the capture. Six labels
## in the whole artifact, and not one of them names the axis value.
func _text(content: String, p: Vector3, size: int, px: float, c: Color) -> Label3D:
	var l := Label3D.new()
	l.text = content
	l.font_size = size
	l.pixel_size = px
	l.outline_size = 0
	l.modulate = c
	l.position = p
	l.billboard = BaseMaterial3D.BILLBOARD_DISABLED
	return l


func _exit_tree() -> void:
	for child in get_children():
		if not child.owner:
			child.queue_free()
