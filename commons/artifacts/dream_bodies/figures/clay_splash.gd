extends Node3D

## clay_splash — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: clay (boneless, melted, swarm, fossil, mirrored, fused); paint (flat, crust, flood, bloom)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/clay_splash.gd")

@export_enum("boneless", "melted", "swarm", "fossil", "mirrored", "fused") var clay: String = "boneless"
@export_enum("flat", "crust", "flood", "bloom") var paint: String = "flat"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("clay"):
		clay = String(config.get("clay", "boneless"))
	if config.has("paint"):
		paint = String(config.get("paint", "flat"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"clay": clay, "paint": paint})
