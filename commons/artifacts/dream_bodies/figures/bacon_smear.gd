extends Node3D

## bacon_smear — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: smear (drag, still, fan, shred, spill, cast); hold (open, pin, rail, frame, ring, strip)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/bacon_smear.gd")

@export_enum("drag", "still", "fan", "shred", "spill", "cast") var smear: String = "drag"
@export_enum("open", "pin", "rail", "frame", "ring", "strip") var hold: String = "open"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("smear"):
		smear = String(config.get("smear", "drag"))
	if config.has("hold"):
		hold = String(config.get("hold", "open"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"smear": smear, "hold": hold})
