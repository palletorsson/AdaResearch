extends Node3D

## nana_gloss — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: nana (dancing, melting, caged, swarming, ronde, poured); paint (flat, relief, blooming, unravelling)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/nana_gloss.gd")

@export_enum("dancing", "melting", "caged", "swarming", "ronde", "poured") var nana: String = "dancing"
@export_enum("flat", "relief", "blooming", "unravelling") var paint: String = "flat"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("nana"):
		nana = String(config.get("nana", "dancing"))
	if config.has("paint"):
		paint = String(config.get("paint", "flat"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"nana": nana, "paint": paint})
