extends Node3D

## print_inflatable — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: pattern (harlequin, snakeskin, swirl, stripe, pucci); inflation (taut, overblown, slack, deflated, bursting)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/print_inflatable.gd")

@export_enum("harlequin", "snakeskin", "swirl", "stripe", "pucci") var pattern: String = "harlequin"
@export_enum("taut", "overblown", "slack", "deflated", "bursting") var inflation: String = "taut"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("pattern"):
		pattern = String(config.get("pattern", "harlequin"))
	if config.has("inflation"):
		inflation = String(config.get("inflation", "taut"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"pattern": pattern, "inflation": inflation})
