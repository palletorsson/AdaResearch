extends Node3D

## fetish_idol — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: surface (latex, patent, oilslick, holo, pvc, chrome); harness (bare, strap, lace, buckle, cage, zip)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/fetish_idol.gd")

@export_enum("latex", "patent", "oilslick", "holo", "pvc", "chrome") var surface: String = "latex"
@export_enum("bare", "strap", "lace", "buckle", "cage", "zip") var harness: String = "bare"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("surface"):
		surface = String(config.get("surface", "latex"))
	if config.has("harness"):
		harness = String(config.get("harness", "bare"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"surface": surface, "harness": harness})
