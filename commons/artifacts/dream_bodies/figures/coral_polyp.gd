extends Node3D

## coral_polyp — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: colony (single, budding, spawning, bleached, drowned, fused); frond (branch, bloom, antler, thread)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/coral_polyp.gd")

@export_enum("single", "budding", "spawning", "bleached", "drowned", "fused") var colony: String = "single"
@export_enum("branch", "bloom", "antler", "thread") var frond: String = "branch"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("colony"):
		colony = String(config.get("colony", "single"))
	if config.has("frond"):
		frond = String(config.get("frond", "branch"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"colony": colony, "frond": frond})
