extends Node3D

## obi_frieze — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: chorus (rank, ring, spiral, cascade, huddle); sleeve (swung, furled, fanned, shredded, winged)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/obi_frieze.gd")

@export_enum("rank", "ring", "spiral", "cascade", "huddle") var chorus: String = "rank"
@export_enum("swung", "furled", "fanned", "shredded", "winged") var sleeve: String = "swung"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("chorus"):
		chorus = String(config.get("chorus", "rank"))
	if config.has("sleeve"):
		sleeve = String(config.get("sleeve", "swung"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"chorus": chorus, "sleeve": sleeve})
