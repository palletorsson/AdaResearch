extends Node3D

## oni_dragon — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: possession (single, three_faced, six_armed, brood); curse (flesh, tallow, exorcised, reliquary, fused)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/oni_dragon.gd")

@export_enum("single", "three_faced", "six_armed", "brood") var possession: String = "single"
@export_enum("flesh", "tallow", "exorcised", "reliquary", "fused") var curse: String = "flesh"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("possession"):
		possession = String(config.get("possession", "single"))
	if config.has("curse"):
		curse = String(config.get("curse", "flesh"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"possession": possession, "curse": curse})
