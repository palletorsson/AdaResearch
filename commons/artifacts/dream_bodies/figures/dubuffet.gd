extends Node3D

## dubuffet — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: matter (plaster, melted, swarm, cage, inflated); outgrowth (none, six_arms, crown, bloom, twin)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/dubuffet.gd")

@export_enum("plaster", "melted", "swarm", "cage", "inflated") var matter: String = "plaster"
@export_enum("none", "six_arms", "crown", "bloom", "twin") var outgrowth: String = "none"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("matter"):
		matter = String(config.get("matter", "plaster"))
	if config.has("outgrowth"):
		outgrowth = String(config.get("outgrowth", "none"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"matter": matter, "outgrowth": outgrowth})
