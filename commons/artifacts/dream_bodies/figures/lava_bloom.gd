extends Node3D

## lava_bloom — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: bough (writhe, melt, mirror, unravel, triune, fused); bloom (spray, flood, cage, crown)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/lava_bloom.gd")

@export_enum("writhe", "melt", "mirror", "unravel", "triune", "fused") var bough: String = "writhe"
@export_enum("spray", "flood", "cage", "crown") var bloom: String = "spray"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("bough"):
		bough = String(config.get("bough", "writhe"))
	if config.has("bloom"):
		bloom = String(config.get("bloom", "spray"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"bough": bough, "bloom": bloom})
