extends Node3D

## tube_reef — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: growth (arch, melt, swarm, fossil, bloom, fused); tenants (eels, shoal, hydra, chorus)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/tube_reef.gd")

@export_enum("arch", "melt", "swarm", "fossil", "bloom", "fused") var growth: String = "arch"
@export_enum("eels", "shoal", "hydra", "chorus") var tenants: String = "eels"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("growth"):
		growth = String(config.get("growth", "arch"))
	if config.has("tenants"):
		tenants = String(config.get("tenants", "eels"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"growth": growth, "tenants": tenants})
