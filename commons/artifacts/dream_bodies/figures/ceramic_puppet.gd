extends Node3D

## ceramic_puppet — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: stringing (strung, swarmed, unstrung, wired, swollen); vestment (maze_cloth, flooded, unravelled, bloomed)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/ceramic_puppet.gd")

@export_enum("strung", "swarmed", "unstrung", "wired", "swollen") var stringing: String = "strung"
@export_enum("maze_cloth", "flooded", "unravelled", "bloomed") var vestment: String = "maze_cloth"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("stringing"):
		stringing = String(config.get("stringing", "strung"))
	if config.has("vestment"):
		vestment = String(config.get("vestment", "maze_cloth"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"stringing": stringing, "vestment": vestment})
