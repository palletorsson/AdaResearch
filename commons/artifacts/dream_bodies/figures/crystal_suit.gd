extends Node3D

## crystal_suit — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: crust (gravel, spire, shard, bloom, geode); panels (leaning, shell, fallen, wings, grove)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/crystal_suit.gd")

@export_enum("gravel", "spire", "shard", "bloom", "geode") var crust: String = "gravel"
@export_enum("leaning", "shell", "fallen", "wings", "grove") var panels: String = "leaning"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("crust"):
		crust = String(config.get("crust", "gravel"))
	if config.has("panels"):
		panels = String(config.get("panels", "leaning"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"crust": crust, "panels": panels})
