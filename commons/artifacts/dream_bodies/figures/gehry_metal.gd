extends Node3D

## gehry_metal — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: sheet (crumple, melt, swarm, fossil, unravel); gesture (lean, mirror, burst, crown)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/gehry_metal.gd")

@export_enum("crumple", "melt", "swarm", "fossil", "unravel") var sheet: String = "crumple"
@export_enum("lean", "mirror", "burst", "crown") var gesture: String = "lean"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("sheet"):
		sheet = String(config.get("sheet", "crumple"))
	if config.has("gesture"):
		gesture = String(config.get("gesture", "lean"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"sheet": sheet, "gesture": gesture})
