extends Node3D

## tatlin_red — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: monument (tower, twinned, brigade, collapse, exploded); sheet (torn, thread, bloom, slab)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/tatlin_red.gd")

@export_enum("tower", "twinned", "brigade", "collapse", "exploded") var monument: String = "tower"
@export_enum("torn", "thread", "bloom", "slab") var sheet: String = "torn"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("monument"):
		monument = String(config.get("monument", "tower"))
	if config.has("sheet"):
		sheet = String(config.get("sheet", "torn"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"monument": monument, "sheet": sheet})
