extends Node3D

## dragon — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: kiln (glazed, molten, crazed, fossil, swarm, cast); necks (one, twinned, hydra, ouroboros)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/dragon.gd")

@export_enum("glazed", "molten", "crazed", "fossil", "swarm", "cast") var kiln: String = "glazed"
@export_enum("one", "twinned", "hydra", "ouroboros") var necks: String = "one"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("kiln"):
		kiln = String(config.get("kiln", "glazed"))
	if config.has("necks"):
		necks = String(config.get("necks", "one"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"kiln": kiln, "necks": necks})
