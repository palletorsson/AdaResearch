extends Node3D

## david_drape — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: drape (spiral, flood, unravel, cage); chorus (one, twinned, hydra, frieze)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/david_drape.gd")

@export_enum("spiral", "flood", "unravel", "cage") var drape: String = "spiral"
@export_enum("one", "twinned", "hydra", "frieze") var chorus: String = "one"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("drape"):
		drape = String(config.get("drape", "spiral"))
	if config.has("chorus"):
		chorus = String(config.get("chorus", "one"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"drape": drape, "chorus": chorus})
