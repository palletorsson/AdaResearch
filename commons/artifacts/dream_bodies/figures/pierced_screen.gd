extends Node3D

## pierced_screen — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: piercing (arp, coral, torn, portal, sealed); wearer (threading, folded, twinned, swarm, negative)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/pierced_screen.gd")

@export_enum("arp", "coral", "torn", "portal", "sealed") var piercing: String = "arp"
@export_enum("threading", "folded", "twinned", "swarm", "negative") var wearer: String = "threading"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("piercing"):
		piercing = String(config.get("piercing", "arp"))
	if config.has("wearer"):
		wearer = String(config.get("wearer", "threading"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"piercing": piercing, "wearer": wearer})
