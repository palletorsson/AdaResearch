extends Node3D

## masked_dancer — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: rite (mid_step, twinned, melted, swarmed, flooded); shell (eared, antlered, shoal, cage, bloom)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/masked_dancer.gd")

@export_enum("mid_step", "twinned", "melted", "swarmed", "flooded") var rite: String = "mid_step"
@export_enum("eared", "antlered", "shoal", "cage", "bloom") var shell: String = "eared"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("rite"):
		rite = String(config.get("rite", "mid_step"))
	if config.has("shell"):
		shell = String(config.get("shell", "eared"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"rite": rite, "shell": shell})
