extends Node3D

## crackle_peak — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: congregation (one, twinned, procession, swarm); habit (standing, melted, fossil, blooming)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/crackle_peak.gd")

@export_enum("one", "twinned", "procession", "swarm") var congregation: String = "one"
@export_enum("standing", "melted", "fossil", "blooming") var habit: String = "standing"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("congregation"):
		congregation = String(config.get("congregation", "one"))
	if config.has("habit"):
		habit = String(config.get("habit", "standing"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"congregation": congregation, "habit": habit})
