extends Node3D

## batik_beast — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: stuffing (stuffed, inflated, melted, swarmed, unpicked); head (muzzled, herd, crowned, blooming, boned)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/batik_beast.gd")

@export_enum("stuffed", "inflated", "melted", "swarmed", "unpicked") var stuffing: String = "stuffed"
@export_enum("muzzled", "herd", "crowned", "blooming", "boned") var head: String = "muzzled"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("stuffing"):
		stuffing = String(config.get("stuffing", "stuffed"))
	if config.has("head"):
		head = String(config.get("head", "muzzled"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"stuffing": stuffing, "head": head})
