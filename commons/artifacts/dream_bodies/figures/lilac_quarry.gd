extends Node3D

## lilac_quarry — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: strata (bedded, faulted, folded, quarried, cast); bathers (leaning, reclining, embedded, pair, strewn)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/lilac_quarry.gd")

@export_enum("bedded", "faulted", "folded", "quarried", "cast") var strata: String = "bedded"
@export_enum("leaning", "reclining", "embedded", "pair", "strewn") var bathers: String = "leaning"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("strata"):
		strata = String(config.get("strata", "bedded"))
	if config.has("bathers"):
		bathers = String(config.get("bathers", "leaning"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"strata": strata, "bathers": bathers})
