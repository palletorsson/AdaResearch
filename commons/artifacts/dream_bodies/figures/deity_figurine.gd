extends Node3D

## deity_figurine — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: manifestation (dancing, multiplied, blooming, fossilised); drapery (pleats, flood, threads, flame)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/deity_figurine.gd")

@export_enum("dancing", "multiplied", "blooming", "fossilised") var manifestation: String = "dancing"
@export_enum("pleats", "flood", "threads", "flame") var drapery: String = "pleats"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("manifestation"):
		manifestation = String(config.get("manifestation", "dancing"))
	if config.has("drapery"):
		drapery = String(config.get("drapery", "pleats"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"manifestation": manifestation, "drapery": drapery})
