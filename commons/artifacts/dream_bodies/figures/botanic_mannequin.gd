extends Node3D

## botanic_mannequin — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: skin (printed, sprouting, unravelled, cage, poured); rank (one, twinned, multiplied, swarm)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/botanic_mannequin.gd")

@export_enum("printed", "sprouting", "unravelled", "cage", "poured") var skin: String = "printed"
@export_enum("one", "twinned", "multiplied", "swarm") var rank: String = "one"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("skin"):
		skin = String(config.get("skin", "printed"))
	if config.has("rank"):
		rank = String(config.get("rank", "one"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"skin": skin, "rank": rank})
