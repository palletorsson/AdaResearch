extends Node3D

## hokusai_kimono — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: cloth (wrapped, drowned, unspooling, boned, shoal); frieze (single, mirrored, triptych, kannon, shed)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/hokusai_kimono.gd")

@export_enum("wrapped", "drowned", "unspooling", "boned", "shoal") var cloth: String = "wrapped"
@export_enum("single", "mirrored", "triptych", "kannon", "shed") var frieze: String = "single"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("cloth"):
		cloth = String(config.get("cloth", "wrapped"))
	if config.has("frieze"):
		frieze = String(config.get("frieze", "single"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"cloth": cloth, "frieze": frieze})
