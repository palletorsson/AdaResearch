extends Node3D

## porcelain_doll — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: winding (bandage, unravelling, cage, blooming, swarm); figure (reaching, three_headed, budding, flooded)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/porcelain_doll.gd")

@export_enum("bandage", "unravelling", "cage", "blooming", "swarm") var winding: String = "bandage"
@export_enum("reaching", "three_headed", "budding", "flooded") var figure: String = "reaching"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("winding"):
		winding = String(config.get("winding", "bandage"))
	if config.has("figure"):
		figure = String(config.get("figure", "reaching"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"winding": winding, "figure": figure})
