extends Node3D

## paik_light — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: broadcast (scatter, raster, swarm, chassis, melt); crowd (one, twin, chorus, aerial)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/paik_light.gd")

@export_enum("scatter", "raster", "swarm", "chassis", "melt") var broadcast: String = "scatter"
@export_enum("one", "twin", "chorus", "aerial") var crowd: String = "one"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("broadcast"):
		broadcast = String(config.get("broadcast", "scatter"))
	if config.has("crowd"):
		crowd = String(config.get("crowd", "one"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"broadcast": broadcast, "crowd": crowd})
