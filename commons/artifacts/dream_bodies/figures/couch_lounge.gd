extends Node3D

## couch_lounge — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: repose (sprawl, melt, swarm, cage, bloom); seat (chaise, mirror, flood, heels)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/couch_lounge.gd")

@export_enum("sprawl", "melt", "swarm", "cage", "bloom") var repose: String = "sprawl"
@export_enum("chaise", "mirror", "flood", "heels") var seat: String = "chaise"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("repose"):
		repose = String(config.get("repose", "sprawl"))
	if config.has("seat"):
		seat = String(config.get("seat", "chaise"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"repose": repose, "seat": seat})
