extends Node3D

## painted_chorus — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: mark (labyrinth, banded, marbled, scaled, sliced); mask (skull, eared, crested, frond, blank)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/painted_chorus.gd")

@export_enum("labyrinth", "banded", "marbled", "scaled", "sliced") var mark: String = "labyrinth"
@export_enum("skull", "eared", "crested", "frond", "blank") var mask: String = "skull"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("mark"):
		mark = String(config.get("mark", "labyrinth"))
	if config.has("mask"):
		mask = String(config.get("mask", "skull"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"mark": mark, "mask": mask})
