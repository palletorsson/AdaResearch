extends Node3D

## stijl_robot — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: assembly (danced, exploded, swarmed, melted, skeletal); crown (helmet, chorus, bloom, cage, post)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/stijl_robot.gd")

@export_enum("danced", "exploded", "swarmed", "melted", "skeletal") var assembly: String = "danced"
@export_enum("helmet", "chorus", "bloom", "cage", "post") var crown: String = "helmet"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("assembly"):
		assembly = String(config.get("assembly", "danced"))
	if config.has("crown"):
		crown = String(config.get("crown", "helmet"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"assembly": assembly, "crown": crown})
