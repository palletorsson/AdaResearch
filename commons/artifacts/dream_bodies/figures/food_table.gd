extends Node3D

## food_table — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: spread (heaped, rotted, swarm, blooming, reaching); service (three_tier, flooded, tower, wire)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/food_table.gd")

@export_enum("heaped", "rotted", "swarm", "blooming", "reaching") var spread: String = "heaped"
@export_enum("three_tier", "flooded", "tower", "wire") var service: String = "three_tier"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("spread"):
		spread = String(config.get("spread", "heaped"))
	if config.has("service"):
		service = String(config.get("service", "three_tier"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"spread": spread, "service": service})
