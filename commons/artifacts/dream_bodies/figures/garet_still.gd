extends Node3D

## garet_still — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: cast (one, melted, twinned, many_armed); still_life (around, flooded, climbing, canopy)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/garet_still.gd")

@export_enum("one", "melted", "twinned", "many_armed") var cast: String = "one"
@export_enum("around", "flooded", "climbing", "canopy") var still_life: String = "around"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("cast"):
		cast = String(config.get("cast", "one"))
	if config.has("still_life"):
		still_life = String(config.get("still_life", "around"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"cast": cast, "still_life": still_life})
