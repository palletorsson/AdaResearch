extends Node3D

## dotted_colossus — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: cladding (dots, marble, brick, fur, drape); stance (contrapposto, torsion, fragment, pair, frieze)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/dotted_colossus.gd")

@export_enum("dots", "marble", "brick", "fur", "drape") var cladding: String = "dots"
@export_enum("contrapposto", "torsion", "fragment", "pair", "frieze") var stance: String = "contrapposto"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("cladding"):
		cladding = String(config.get("cladding", "dots"))
	if config.has("stance"):
		stance = String(config.get("stance", "contrapposto"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"cladding": cladding, "stance": stance})
