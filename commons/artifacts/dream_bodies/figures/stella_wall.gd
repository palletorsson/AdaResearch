extends Node3D

## stella_wall — one dream body as its own DNA artifact (generated by
## tools/dream_bodies_promote.py; edit the builder, not this file).
##
## The sweep sets EXPORTED PROPERTIES on a scene root before _ready and reads them
## back; it cannot call a function. So each family gets this thin scene, whose
## exports are exactly the axes its builder declares in axes(), and whose _ready
## hands them to the builder as opts.
##
## Axes: cutout (flat, melt, swarm, fossil, bloom); backing (black, flood, mirror, unhoused)

const BUILDER := preload("res://commons/artifacts/dream_bodies/bodies/stella_wall.gd")

@export_enum("flat", "melt", "swarm", "fossil", "bloom") var cutout: String = "flat"
@export_enum("black", "flood", "mirror", "unhoused") var backing: String = "black"
@export var seed: int = 1


func apply_grid_config(config: Dictionary) -> void:
	if config.has("cutout"):
		cutout = String(config.get("cutout", "flat"))
	if config.has("backing"):
		backing = String(config.get("backing", "black"))
	if config.has("seed"):
		seed = int(config.get("seed", 1))
	if is_inside_tree():
		_rebuild()


func _ready() -> void:
	_rebuild()


func _rebuild() -> void:
	for c in get_children():
		c.queue_free()
	var root := Node3D.new()
	root.name = "Body"
	add_child(root)
	BUILDER.build(root, seed, {"cutout": cutout, "backing": backing})
