[gd_scene format=3]

[ext_resource type="Script" path="res://commons/artifacts/chroma_drum/chroma_drum.gd" id="1_chroma_drum"]

; Everything is built in _ready(): the three dark cylinders, the N stripes or
; 2N fin boxes of the chosen grain, the text plate and the body. Nothing is
; authored here, so there is nothing here to drift out of step with the script.
;
; THE SCRIPT IS ON THE ROOT. GridInteractablesComponent sets config_* metadata and
; calls apply_grid_config on the ROOT node; a scriptless root with the logic on a
; child makes every map token silently unreachable.
;
; The root is a plain Node3D with its origin at the base centre: the base disc's
; underside is y = 0. The collider is a StaticBody3D child built at run time with
; one cylinder for the whole drum and one box for the plate, all sized from the
; same numbers as the meshes.

[node name="ChromaDrum" type="Node3D"]
script = ExtResource("1_chroma_drum")
