{
	"schema": "adaresearch.artifact_spatial_contracts.v1",
	"title": "Artifact Spatial Contracts",
	"description": "Directional identity and placement contracts used by ArtifactSpatialFitPlanner for automatic map staging.",
	"rotation_semantics": {
		"0": "south",
		"90": "west",
		"180": "north",
		"270": "east",
		"note": "Matches map token convention used by interactables."
	},
	"directional_profiles": {
		"full_circle": {
			"name": "Full Circle",
			"front_angle_degrees": 360,
			"rotation_sensitive": false,
			"meaning": "Artifact can be read and approached from all directions.",
			"how_to_use": [
				"Place in center spaces where players can orbit.",
				"Do not rely on facing for readability."
			],
			"how_to_think": "Treat as a volumetric object with spherical social space."
		},
		"half_circle": {
			"name": "Half Circle",
			"front_angle_degrees": 180,
			"rotation_sensitive": true,
			"meaning": "Artifact has a front hemisphere and a less meaningful back.",
			"how_to_use": [
				"Face toward expected approach direction.",
				"Reserve rear cells for support geometry or wall backing."
			],
			"how_to_think": "Treat as a stage object with audience side and backstage side."
		},
		"cone": {
			"name": "Cone",
			"front_angle_degrees": 90,
			"rotation_sensitive": true,
			"meaning": "Artifact projects meaning in a focused forward cone (screens, kiosks, labels).",
			"how_to_use": [
				"Align front toward corridor, spawn, or decision point.",
				"Avoid placing primary interaction path behind the object."
			],
			"how_to_think": "Treat as directional communication that must address the player."
		},
		"corridor": {
			"name": "Corridor",
			"front_angle_degrees": 120,
			"rotation_sensitive": true,
			"requires_axis_alignment": true,
			"meaning": "Artifact is read while moving through or along a path axis.",
			"how_to_use": [
				"Place on movement routes, not in isolated corners.",
				"Align local forward with corridor axis."
			],
			"how_to_think": "Treat as kinetic architecture, not static sculpture."
		},
		"ambient": {
			"name": "Ambient",
			"front_angle_degrees": 360,
			"rotation_sensitive": false,
			"meaning": "Artifact contributes context or atmosphere more than directional instruction.",
			"how_to_use": [
				"Use for background legibility and mood.",
				"Do not block key interaction lanes."
			],
			"how_to_think": "Treat as environmental field rather than focal subject."
		}
	},
