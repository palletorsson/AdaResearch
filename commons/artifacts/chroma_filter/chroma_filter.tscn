[gd_scene format=3]

[ext_resource type="Script" path="res://commons/artifacts/chroma_filter/chroma_filter.gd" id="1_chroma_filter"]

; Everything is built in _ready(): the white slab, the two white walls, the three
; coloured panes with the chosen mix's material and the chosen triad's colours,
; the text plate at the chosen end and the body. Nothing is authored here, so
; there is nothing here to drift out of step with the script.
;
; THE SCRIPT IS ON THE ROOT. GridInteractablesComponent sets config_* metadata and
; calls apply_grid_config on the ROOT node; a scriptless root with the logic on a
; child makes every map token silently unreachable.
;
; The root is a plain Node3D with its origin at the token cell's centre and the
; slab's underside at y = 0. The slab and walls put their outer faces at local
; -0.46, so at a hall corner the piece stands 4 cm off both hall walls and grows
; +X / +Z from its cell. The collider is a StaticBody3D child built at run time
; with one box per slab, wall, pane (turned with the pane), post and plate, all
; sized from the same numbers as the meshes.

[node name="ChromaFilter" type="Node3D"]
script = ExtResource("1_chroma_filter")
