{
  "schema": "ada.biome-primitives-pilot.v1",
  "world": {
    "seed": 7,
    "size": 12
  },
  "stages": [
    {
      "map": "Point_One",
      "title": "01 / A position",
      "question": "Walk into the ground. What remains of where you stood?",
      "principle": "The position follows your walk, projected onto this ground. The black mark represents that position; a mathematical point has no radius.",
      "critical": "You arrive at a position. It has already forgotten the last one.",
      "code": "point = project_walk_to_ground(player_position)",
      "withdraw": "For review: withdraw the position mark while retaining its coordinate. The hall itself has no control panel."
    },
    {
      "map": "Point_Lines",
      "title": "02 / A relation",
      "question": "Walk away from the reference. Does your route have to be straight?",
      "principle": "A segment joins the retained reference to your current ground position. It changes with your walk and does not record the route.",
      "critical": "The relation is straight. Your way of making it need not be.",
      "code": "segment = [anchor, point]",
      "withdraw": "Withdraw relation: the segment and reference marker disappear; the point remains movable."
    },
    {
      "map": "Point_Trace",
      "title": "03 / A record",
      "question": "Take a detour. Which parts survive the sampling interval?",
      "principle": "At most one current position is sampled per update after the interval elapses. Stationary duplicates are omitted. The oldest sample is dropped when capacity is reached.",
      "critical": "The line joins what was kept. The movement between those points is already elsewhere.",
      "code": "if elapsed >= interval:\n    remember(current_position)",
      "withdraw": "Withdraw memory: recording stops and the archive is hidden. Return preserves it and begins a new stroke. Clear memory discards it."
    },
    {
      "map": "Point_Line_Grid",
      "title": "04 / An address",
      "question": "Move within a cell, then across its boundary. What changes in the address?",
      "principle": "The grid divides the same ground into one-unit cells. It reports a cell without snapping the point to its centre. This address projects x and z; height remains another difference.",
      "critical": "Several positions can share an address. The address is useful precisely because it leaves something out.",
      "code": "cell = floor((position.xz + half_extent) / cell_size)",
      "withdraw": "Withdraw grid: the address and lattice disappear. Position, relation and recording continue."
    },
    {
      "map": "Point_Triangle_Context",
      "title": "05 / A surface",
      "question": "Walk along the faces. What changes when you see them edge-on?",
      "principle": "Two triangles share a diagonal to make each rectangular face. Five equal faces stand on the same ground. Their gaps widen from 0.35 to 1.65 metres. The panels have a chosen 4 cm thickness and collision: a mathematical surface alone would not stop you.",
      "critical": "From here, a wall. From the side, almost a line. Your route encounters a thickness that the drawing did not need.",
      "code": "face = [(a, c, b), (a, d, c)]\n# Shared edge; two triangles.\n# Collision is a separate choice.",
      "withdraw": "Withdraw surface: the panels and their collisions disappear. The ground, grid, reference and retained trace remain."
    },
    {
      "map": "Primitives_Polythedra",
      "title": "06 / An interval for a body",
      "question": "You can see through every gap. Can you walk through each one?",
      "principle": "The same five fronts gain depth: each volume is 1.1 × 1.8 × 2.2 metres. Their positions and gaps are retained. The standalone walker has a 0.5 metre-wide capsule, so the first 0.35 metre gap blocks it. The wider gaps and the edges offer other routes. The chosen collision body is not a measure of every human body.",
      "critical": "The objects agree in size. The intervals make different promises. Your eye arrives where the body you were given cannot yet follow.",
      "code": "centre.z = front_z - depth / 2\nsize = Vector3(width, height, depth)\n# Seeing a passage does not define who fits.",
      "withdraw": "Withdraw depth: the same fronts become thin panels again. Withdraw surface next by returning to the grid. This removes capabilities; it does not reverse the walk."
    },
    {
      "map": "Trans_Rotation",
      "title": "07 / A turn makes room",
      "question": "Stay with the edge that does not move. Where does the opening go?",
      "principle": "This rotation study revisits the five thin faces. Each left edge is a fixed vertical hinge. The same dimensions and intervals remain; all faces turn from zero to ninety degrees and back on a twenty-second motor schedule. The sweep is marked on the ground. The bank holds its current angle while the tracked player is inside a sweep, then resumes from that moment. This is prescribed rotation, not wind, spring or force-driven motion.",
      "critical": "The face turns away. A passage appears where there was a refusal. The turning surface also takes up another space. Follow both.",
      "code": "position = pivot + rotation * (rest_position - pivot)\n# The pivot stays. The edge travels.\nif visitor_in_sweep:\n    hold_current_angle()",
      "withdraw": "Withdraw the motor: the panels keep their current angle, identity and thin geometry. Return resumes the retained schedule. The general clock and walking trace continue."
    },
    {
      "map": "Trans_Scale",
      "title": "08 / The size of an invitation",
      "question": "The hinges stay where they were. Can the same body still pass?",
      "principle": "The five panels repeat the same turn at two widths: 0.66 and 1.375 metres. Only local width changes; height, thickness, hinge positions, the metre grid and the walking body stay fixed. A narrow panel completes its turn, grows while closed, then repeats that turn wider. The 48-second cycle separates rotation from scale. Entering the maximum sweep holds both operations. The first gap changes from 0.79 to 0.075 metres: the standalone half-metre collision body fits only the first. The outside route remains available.",
      "critical": "You have not grown. The hinge has not moved. Yet the opening no longer makes room for you. How small a change turns an invitation into a refusal?",
      "code": "width = base_width * width_factor\ncentre = pivot + rotation * Vector3(width / 2, height / 2, -thickness / 2)\n# Grow while closed; repeat the same turn.\n# Resize the collision shape with the visible face.",
      "withdraw": "Withdraw the scale study: width and angle hold together at the current pose. Return resumes that moment in the comparison. The walking trace and general clock continue. These research controls are outside the game."
    }
  ],
