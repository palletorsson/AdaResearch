      "lookup_name": "hl_turret_vectors",
      "scene": "res://commons/artifacts/hl_turret_vectors/hl_turret_vectors.tscn",
      "class_name": "HLTurretVectors",
      "name": "Half-Life Turret - Vector Compendium",
      "description": "Half-Life inspired sentry turret demonstrating ALL vector operations in one coherent system: subtraction (direction to target), magnitude (distance/range check), normalization (unit direction), dot product (FOV check), cross product (rotation axis), projection (ground plane), scalar multiplication (bullet velocity), and velocity integration (bullet physics). Fires tracer rounds with visible velocity vectors!",
      "qfep_connection": "The turret as computational subject - vectors as the mathematics of surveillance, targeting, and ballistics. Shows how abstract math operations have immediate, embodied applications in games and simulations.",
      "signals": [
        "target_acquired",
        "target_lost",
        "bullet_fired",
        "bullet_hit"
      ],
      "interactions": [
        "grab target sphere to move it",
        "preset buttons for scenarios",
        "SPACE to manual fire",
        "F to toggle auto-fire"
      ],
      "parameters": {
        "turret_height": "Height of turret barrel (default 0.4)",
        "barrel_length": "Length of gun barrel (default 0.25)",
        "field_of_view_degrees": "Total FOV cone in degrees (default 90)",
        "max_range": "Maximum targeting range (default 2.5)",
        "tracking_speed": "How fast turret tracks target (default 2.0)",
        "target_position": "Initial target position Vector3",
        "shooting_enabled": "Enable automatic firing (default true)",
        "fire_rate": "Shots per second (default 3.0)",
        "bullet_speed": "Bullet velocity in units/sec (default 4.0)",
        "show_bullet_vectors": "Show velocity arrows on bullets (default true)"
      },
