		"bulging_tunnel": {
			"capacity": "FEEL how parametric distortion transforms a predictable corridor into an unpredictable cave",
			"category": "geometry",
			"complexity": "intermediate",
			"description": "Walk into a cylinder that refuses to stay regular. CSG spheres bulge outward at irregular intervals, warping your sense of depth — the tunnel breathes. The num_bulges and bulge_max_radius parameters control how much chaos enters the geometry: low values produce a hallway, high values produce a cave. Contrasts with Klein bottle (closed non-orientable) and Möbius strip (twisted surface); prepares for hyperbolic spaces where distortion becomes the rule.",
			"dev_themes": [
				"geometry",
				"non_euclidean"
			],
			"footprint": [
				3,
				3,
				10
			],
			"gamwell_reference": "Non-Euclidean geometry, Riemannian manifolds, topology",
			"include_in_map_data": true,
			"interactions": [
				"walk through tunnel",
				"adjust num_bulges via export",
				"change bulge_max_radius to control distortion intensity",
				"toggle use_random_bulges for deterministic vs stochastic"
			],
			"lookup_name": "bulging_tunnel",
			"map_ready": true,
			"map_sequences": [],
			"name": "Bulging Tunnel",
			"parameters": {
				"bulge_max_radius": "Maximum bulge radius (default: 2.0)",
				"bulge_seed": "Random seed for reproducibility (default: 42)",
				"footprint": [
					3,
					3,
					10
				],
				"num_bulges": "Number of bulge deformations (default: 5)",
				"size_group": "xlarge",
				"tunnel_length": "Length of tunnel (default: 10.0)",
				"tunnel_radius": "Base radius (default: 1.0)",
				"use_random_bulges": "Stochastic vs sinusoidal bulge sizing (default: true)"
			},
			"qfep_connection": "Lambda applied to architecture — a regular cylinder is pure F (uniform, predictable). Each bulge introduces E (variation, surprise). The num_bulges parameter IS lambda: how much chaos do you let into your structure? At zero bulges the tunnel is Euclidean. At maximum, geometry becomes landscape.",
