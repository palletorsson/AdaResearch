  "bulging_tunnel": {
   "capacity": "FEEL how parametric distortion transforms a predictable corridor into an unpredictable cave",
   "category": "geometry",
   "complexity": "intermediate",
   "description": "Walk into a cylinder that refuses to stay regular. CSG spheres bulge outward at irregular intervals, warping your sense of depth — the tunnel breathes. The num_bulges and bulge_max_radius parameters control how much chaos enters the geometry: low values produce a hallway, high values produce a cave. Contrasts with Klein bottle (closed non-orientable) and Möbius strip (twisted surface); prepares for hyperbolic spaces where distortion becomes the rule.",
   "dev_themes": [
    "geometry",
    "non_euclidean"
   ],
   "footprint": [
    3,
    3,
    10
   ],
   "gamwell_reference": "Non-Euclidean geometry, Riemannian manifolds, topology",
   "include_in_map_data": true,
   "interactions": [
