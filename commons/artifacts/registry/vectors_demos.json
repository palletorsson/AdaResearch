				"leverage",
				"rotation",
				"embodied"
			],
			"parameters": {
				"seed": "Arm bearing jitter (default 0)",
				"leverage": "0..1 angle of the push F from the arm r - drives the torque sin(theta), the tau vector length and the spin (default 0.78)",
				"complexity": "Flywheel spokes + spin-arc resolution (default 6)",
				"color_a": "Steel rig",
				"color_b": "The arm vector r",
				"force_color": "The push F",
