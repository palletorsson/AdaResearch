				"dot-product",
				"shadow",
				"rejection",
				"embodied"
			],
			"parameters": {
				"seed": "Length jitter (default 0)",
				"projection": "0..1 swings the object from perpendicular to along the rail - drives a*n_hat and the shadow length (default 0.7)",
				"complexity": "Detail (default 6)",
				"color_a": "Rail / axis n_hat",
				"color_b": "The vector a",
				"accent": "The projection shadow",
				"sun_color": "The light",
