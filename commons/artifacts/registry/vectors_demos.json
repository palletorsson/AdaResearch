		"drag_lane": {
			"lookup_name": "drag_lane",
			"scene": "res://commons/artifacts/drag_lane/drag_lane.tscn",
			"class_name": "DragLane",
			"name": "Drag Lane (F = -b·v you feel)",
			"description": "Friction / drag made felt - a forces toy for the embodied vectors-forces arc. A runner enters a resistant medium at full tilt and slows under F = -b*v, so its velocity decays v ~ e^(-bt). Frozen stroboscopically, the runner's snapshots bunch together and its velocity arrows shrink as the drag eats the motion - run through air, water, honey and each pulls back harder. DNA: drag 0..1 sweeps from glide (snapshots evenly spread) to dead-stop (piled up fast); seed jitters the medium motes; color_a lane, color_b runner + velocity, accent drag particles, medium_color the resistant volume.",
			"category": "vectors",
			"complexity": "intermediate",
			"include_in_map_data": true,
			"map_ready": true,
			"map_sequences": [ "forces" ],
			"tags": [ "force", "friction", "drag", "velocity", "decay", "embodied" ],
			"parameters": {
				"seed": "Medium-mote jitter (default 0)",
				"drag": "0..1 drag strength - sweeps the velocity decay from glide to dead-stop (default 0.5)",
				"complexity": "Snapshot count (default 6)",
				"color_a": "Lane / rig",
				"color_b": "Runner + velocity arrows",
				"accent": "Drag particles",
				"medium_color": "The resistant medium volume",
				"emissive": "Bool - lift glow (default true)",
				"sculpt_height": "Height in meters",
				"sculpt_width": "Footprint width in meters"
			},
			"dev_themes": [ "forces", "friction", "drag", "vectors" ],
			"spatial_needs": {
				"platform": "none", "footprint_cells": 3,
