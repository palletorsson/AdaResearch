		"SpectrumVisualizer": {
			"capacity": "SEE that the color wheel is a perceptual invention — magenta is the seam where the brain closes what physics leaves open",
			"category": "unknown",
			"complexity": "beginner",
			"description": "The visible spectrum bends from a line into a circle. Wavelength-to-color animation phases between linear layout (physics) and circular layout (perception). Magenta dots fill the gap that physics leaves empty — magenta is not a spectral color, it is the brain's invention to close the loop. The color wheel is a lie the brain tells to make the spectrum feel complete.",
			"dev_themes": [
				"color",
				"perception"
			],
			"footprint": [
				1.0,
				1.0,
				1.0
			],
			"gamwell_reference": "Color spaces (RGB, HSV, Lab), perceptual color science",
			"include_in_map_data": true,
			"interactions": [
				"watch auto-animation (linear to circular phase)",
				"observe magenta dots appearing in the gap"
			],
			"lookup_name": "SpectrumVisualizer",
			"map_ready": true,
			"map_sequences": [
				"color"
			],
			"name": "SpectrumVisualizer",
			"parameters": {
				"footprint": [
					1.0,
					1.0,
					1.0
				],
				"size_group": "compact"
			},
			"qfep_connection": "Lambda between physics and perception — the linear spectrum is pure F (physics, ordered by wavelength). The circular wheel is F + E (perception, with magenta invented to fill the gap). The animation IS the lambda sweep from one to the other.",
			"scene": "res://algorithms/color/spectrum_visualizer/SpectrumVisualizer.tscn",
			"size_group": "compact",
			"tags": [
				"spectrum",
				"color_wheel",
				"magenta",
				"wavelength",
