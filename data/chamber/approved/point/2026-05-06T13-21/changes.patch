+
+# Map-data → artifact wiring point. The grid system calls this per cell
+# with the parsed config_data (see GridInteractablesComponent._parse_config_token).
+# We accept any flag here; future entrances ("bloom", "pulse", etc.) plug
+# into the same dispatch.
+func apply_grid_config(config: Dictionary) -> void:
+	if config.has("entrance"):
+		entrance_flag = String(config["entrance"])
+
+
+func _maybe_play_entrance() -> void:
+	if entrance_flag == "gravity":
+		_spawn_entrance_fragments()
+
+
+# ── Gravity-of-reduction entrance animation ────────────────────────────
+func _spawn_entrance_fragments() -> void:
+	for i in FRAGMENT_COUNT:
+		var sphere := MeshInstance3D.new()
+		sphere.name = "EntranceFragment_%d" % i
+		var mesh := SphereMesh.new()
+		mesh.radius = FRAGMENT_RADIUS
+		mesh.height = FRAGMENT_RADIUS * 2.0
+		mesh.radial_segments = 12
+		mesh.rings = 8
+		sphere.mesh = mesh
+
+		# Fibonacci-on-sphere distribution (same math as
+		# algorithms/computationalbiology/attractorsphere/attractorsphere.gd
+		# ::_fibonacci_on_unit_sphere — deterministic, curriculum-honest at seq 1).
+		var theta: float = float(i) * TAU / PHI
+		var phi: float = acos(1.0 - 2.0 * (float(i) + 0.5) / float(FRAGMENT_COUNT))
+		var dir := Vector3(
+			sin(phi) * cos(theta),
+			cos(phi),
+			sin(phi) * sin(theta)
+		)
+		sphere.position = dir * FRAGMENT_SPAWN_RADIUS
+
+		var mat := StandardMaterial3D.new()
+		mat.albedo_color = FRAGMENT_COLOR
+		mat.emission_enabled = true
+		mat.emission = FRAGMENT_COLOR
+		mat.emission_energy_multiplier = 2.0
+		sphere.material_override = mat
+
+		add_child(sphere)
+		_fragments.append({"node": sphere, "start": sphere.position})
+
+	_entrance_timer = 0.0
+	_entrance_active = true
+
+
+func _step_entrance_animation(delta: float) -> void:
+	if not _entrance_active:
+		return
+	_entrance_timer += delta
+	var t: float = clampf(_entrance_timer / ANIMATION_DURATION, 0.0, 1.0)
+	# Cubic ease-in: ~5s drift, ~3s rapid collapse — gravity-like acceleration.
+	var ease_t: float = t * t * t
+
+	for f in _fragments:
+		var node: MeshInstance3D = f.node
+		if not is_instance_valid(node):
+			continue
+		node.position = (f.start as Vector3).lerp(Vector3.ZERO, ease_t)
+		var s: float = 1.0 - ease_t
+		node.scale = Vector3.ONE * maxf(s, 0.001)
+
+	if t >= 1.0:
+		_entrance_active = false
+		for f in _fragments:
+			if is_instance_valid(f.node):
+				f.node.queue_free()
+		_fragments.clear()
+
