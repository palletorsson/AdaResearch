-﻿# PointScene.gd - Pickable point with position display
-# Label follows the point and appears underneath it in the scene tree
+# @identity
+# essence: a 0-dimensional position primitive — a point in Euclidean space, the smallest geometry teaches abstraction
+# desire: to be the player's first encounter with "everything reduces to a position" — the curriculum's atomic unit
+# critical_parameter: global_position; entrance_flag — whether the gravity-of-reduction welcome plays for this placement
+# triggers: _ready() builds the static point; apply_grid_config() reads the per-cell entrance flag and conditionally spawns the entrance fragments; _process() runs the animation if active
+# emerges: a position with a name — the player learns that a point IS its coordinate (no shape, no size, only place)
+# needs: GrabSphere child for pickability [has]; SphereMesh visual proxy for VR readability [has]; Label3D for live coords [has]
+# relationships: Fibonacci-on-sphere placement mirrors algorithms/computationalbiology/attractorsphere/attractorsphere.gd::_fibonacci_on_unit_sphere; the gravity-toward-center metaphor is the curriculum-honest seq-1 echo of algorithms/forces/example_2_1_forces_vr.gd's central-body attraction (which uses real F=ma, locked behind the forces sequence)
+# truth: a point is not a small object — it is a position made visible. Seven fragments converge slowly to the center over eight seconds — gravity made into a duration the player can feel — but only when the map asks for it. Most points are silent.
+
+# PointScene.gd — Pickable point with position display.
+#
+# Optional gravity-of-reduction entrance animation. The map author opts in
+# per cell via the existing #config syntax:
+#
+#   "point:0:-0.5"                   → silent point (default; backwards compat)
+#   "point:0:-0.5#entrance:gravity"  → entrance plays — seven fragments
+#                                       converge over 8s with cubic ease-in
+#
+# Curriculum honesty (seq 1, primitives): zero randomness; deterministic
+# Fibonacci-on-sphere placement plus easing math. The flag mechanism
+# defers the play decision to map-data — most points stay quiet, only
+# specifically marked ones perform the welcome.
+
 extends Node3D
 
+# ── Entrance animation tunables ────────────────────────────────────────
+const FRAGMENT_COUNT: int = 7
+const FRAGMENT_RADIUS: float = 0.07
+const FRAGMENT_SPAWN_RADIUS: float = 1.0
+const ANIMATION_DURATION: float = 8.0
+const PHI: float = 1.61803398875
+const FRAGMENT_COLOR: Color = Color(1.0, 0.9, 0.4)
+
+# Set per-cell from map_data via apply_grid_config(). Default off.
+@export var entrance_flag: String = ""
+
 var position_label: Label3D
 var grab_sphere: Node3D
 var point_sphere: MeshInstance3D
 
+# Entrance animation state
+var _fragments: Array = []
+var _entrance_timer: float = 0.0
+var _entrance_active: bool = false
+
+
 func _ready():
 	setup_point_scene()
+	# Defer the entrance check by one frame so apply_grid_config (which the
+	# grid system calls via call_deferred) lands BEFORE we inspect the flag.
+	call_deferred("_maybe_play_entrance")
+
 
