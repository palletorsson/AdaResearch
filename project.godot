; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ada Research Zero One"
run/main_scene="res://commons/scenes/vr_staging.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://rwex60pqapc"
driver/enable_input=true

[autoload]

BootClock="*res://commons/managers/BootClock.gd"
XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
GameManager="*res://commons/managers/GameManager.gd"
TextManager="*res://commons/managers/TextManager.gd"
MapProgressionManager="*res://commons/managers/MapProgressionManager.gd"
ExamGate="*res://commons/managers/ExamGate.gd"
EcosystemManager="*res://commons/managers/EcosystemManager.gd"
GrammarOperationsManager="*res://commons/managers/GrammarOperationsManager.gd"
BiomeAccrualManager="*res://commons/managers/BiomeAccrualManager.gd"
HazardManager="*res://commons/managers/HazardManager.gd"
MushroomHand="*res://commons/managers/MushroomHand.gd"
CatalystCapabilityManager="*res://commons/managers/CatalystCapabilityManager.gd"
SceneManager="*res://commons/managers/AdaSceneManager.gd"
SoundBank="*res://commons/audio/SoundBankSingleton.gd"
TraceData="*res://commons/globals/trace_data.gd"
SceneNarrator="*res://commons/managers/SceneNarrator.gd"
EquipmentRegistry="*res://commons/globals/equipment_registry.gd"
Subtitles="*res://commons/ui/subtitles/SubtitleManager.gd"
StuckDetector="*res://commons/player/stuck_detector.gd"
DebugLogger="*res://commons/managers/DebugLogger.gd"
DeathEffect="*res://commons/managers/DeathEffect.gd"
NatureRenderer="*res://commons/managers/NatureRenderer.gd"
FloraSpawner="*res://commons/managers/FloraSpawner.gd"
VRLink="*res://commons/bridge/vr_link.gd"
BootClockEnd="*res://commons/managers/BootClockEnd.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=12

[display]

window/size/viewport_width=1800
window/size/viewport_height=1200

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/map_tool_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_script_classes]

_global_script_class_0="GridMaterialFactory"
_global_script_class_type_0="Object"
_global_script_class_path_0="res://commons/primitives/shared/grid_material_factory.gd"
_global_script_class_1="PrimitiveMeshBuilder"
_global_script_class_type_1="Object"
_global_script_class_path_1="res://commons/primitives/shared/primitive_mesh_builder.gd"
_global_script_classes=["GridMaterialFactory", "PrimitiveMeshBuilder"]

[gui]

common/drop_mouse_on_gui_input_disabled=true

