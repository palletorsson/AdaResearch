{
  "name": "ada-tutorial",
  "displayName": "Ada Research Tutorial Viewer",
  "description": "Interactive per-artifact tutorial viewer for Ada Research — traces the build pipeline from code to VR experience",
  "version": "0.1.0",
  "publisher": "ada-research",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Other"],
  "activationEvents": [
    "onLanguage:gdscript",
    "workspaceContains:commons/artifacts/registry"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ada.showArtifactTutorial",
        "title": "Ada: Show Artifact Tutorial"
      },
      {
        "command": "ada.refreshArtifactTree",
        "title": "Ada: Refresh Artifact Tree"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ada-tutorial",
          "title": "Ada Tutorial",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "ada-tutorial": [
        {
          "id": "adaArtifactTree",
          "name": "Artifacts by Sequence"
        }
      ]
    },
    "configuration": {
      "title": "Ada Tutorial",
      "properties": {
        "ada.encyclopediaUrl": {
          "type": "string",
          "default": "http://localhost:3003",
          "description": "URL of the Ada Encyclopedia dev server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
