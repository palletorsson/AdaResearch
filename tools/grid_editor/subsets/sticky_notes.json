{
  "id": "sticky_notes",
  "name": "Sticky Notes",
  "version": "1.0",
  "description": "Message board with colored sticky notes, index cards, headers, and connectors for concept mapping and brainstorming.",
  "orientation": {
    "plane": "XY",
    "up_axis": "Y",
    "forward": "+Z",
    "grid_size": 0.12,
    "comment": "Each grid cell = 12cm. Wall-mounted board, X=left/right, Y=up/down."
