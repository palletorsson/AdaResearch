+## Dispatch on `warning`. Rebuildable: a map sends its config through
+## call_deferred("apply_grid_config", …), i.e. AFTER _ready, so this has to
+## be able to run twice. It drops the previous body first (immediately —
+## remove_child before queue_free, because the sweep measures the AABB on
+## the very next frame) and resets the dim handles the lease holds.
 func _build_visual() -> void:
+	for child in get_children():
+		if child.is_in_group("catalyst_vent_body"):
+			remove_child(child)
+			child.queue_free()
+	_dim_mats.clear()
+	_dim_originals.clear()
+	match warning:
+		"none":
+			# The rule without the notice. Just the seam itself.
+			_build_orb()
+		"stain":
+			_build_stain()
+			_build_orb()
+		"cage":
+			_build_halo()
+			_build_orb()
+			_build_cage()
+		"shroud":
+			_build_orb()
+			_build_shroud()
+		_:
+			# "beacon" — the legacy body, in the legacy order.
+			_build_beacon()
+
