## LIVE PORT — generated by tools/port_wcn_probes_live.py from probe_wcn_points.gd. Do not edit;
## edit the SceneTree probe and regenerate. Runs under project startup (probe_live.tscn
## with --probe=points), so the project's autoloads exist and XR Tools pickables compile.
## Outputs carry a _live suffix.
extends Node
## Random_Noise_Types, batch N1 (doc/research/waves-chance-noise, 2026-09-12, the first hall of
## Astra's noise arc): can randomly proposed points still keep their distance?
##
## Stands up the ACTUAL museum hall with its artifacts, hands the museum the REAL necklace hand
## file, and tests the sampling bench as the map stages it (randompoints:180#stand:compare#
## count:40#size:0.9 at (10,3), placement authority with the map): two MATCHED volumes on one
## table — AS PROPOSED, every candidate kept, and AS ADMITTED, the same named seed under the
## minimum-distance rule — with every accepted point wearing its excluded neighbourhood as a
## shell of half that distance, every refused candidate left where it fell as a ghost, a cased
## readout of both columns, and REDRAW · NEW SEED · RULE · RESTORE.
##
## The measurement contract, which is what Astra asked for: the admitted cloud's closest pair is
## not under the rule; the proposed cloud's is; both volumes are the same size; the arithmetic
## closes (kept + could-not-be-placed == requested, and attempts >= kept + refused); the
## shortfall is REPORTED rather than hidden by quietly shrinking the distance. Then the seed:
## REDRAW brings both clouds back point for point, NEW SEED does not. Then the question the room
## is really about — the live port carries a point through the desktop pointer's own grab into a
## neighbour's shell and reads what happens: the shells turn red, the readout counts it, and
## nothing moves itself back. The rule was applied at birth and is not enforced since; RESTORE
## is the way back, and it is a button, not a law.
##
##   godot --rendering-method gl_compatibility --path . --xr-mode off --script res://commons/testing/probe_wcn_points.gd -- --capture
##
## Writes res://ada_run/noise-galleries-2026-09-13/Random_Noise_Types/probe_points.json
## (and probe_points*.png under --capture). Exit code 1 on any failed check.
var checks := 0
var failures: Array[String] = []
var measurements: Dictionary = {}
const MAP := "Random_Noise_Types"
const OUT := "res://ada_run/noise-galleries-2026-09-13/Random_Noise_Types/"
const MAP_CELL := Vector2i(10, 3)
const SPOT := Vector3(10.5, 0.0, 2.35)  # the visitor's spot: before the bench's FRONT, which the
                                        # token's 180 turns toward the hall's north door
const EYE_H := 1.6

func _ready() -> void: run.call_deferred()

func _live() -> bool:
	return str(get_script().resource_path).ends_with("_live.gd")

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)
	print("[wcn-points] ", "PASS " if ok else "FAIL ", message)

func note(message: String) -> void:
	print("[wcn-points] note: ", message)

func run() -> void:
	if "--capture" in OS.get_cmdline_user_args() and DisplayServer.get_name() == "headless":
		check(false, "PNG capture requires a rendered window; omit --headless, or omit --capture for logic only")
		_finish(); return
	var em: Node3D = load("res://commons/scenes/endless_museum.tscn").instantiate()
	var ctl := "res://ada_run/noise-galleries-2026-09-13/wcn-probe-control.json"
	em.set("EM_CONTROL", ctl); em.set("_overrides_path", ctl + ".unused")
	em.set("_hand_path", "res://ada_run/noise-galleries-2026-09-13/necklace_hand.json")   # the REAL hand, on purpose
	em.set("start_chapter", "noise"); em.set("start_map", MAP)
	var layout: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://commons/data/em_layout.json"))
	layout.get_or_add("stream", {})["bodies"] = 1
	em.set("_layout", layout)
	var f := FileAccess.open(ctl, FileAccess.WRITE)
	f.store_string(JSON.stringify({"first_chapter": "noise", "dollhouse": 0, "grid_pack": 1})); f.close()
	get_tree().root.add_child(em); get_tree().current_scene = em
	await get_tree().create_timer(1.0).timeout
	em.set_process(false); em.call("flush_stamps")
	var player: Node = em.get("_player")
	if player != null: player.set_process(false); player.set_physics_process(false)
	var seg: Node3D
	for rec: Dictionary in em.get("_segments"):
		if rec.node.get_meta("em_map", "") == MAP: seg = rec.node; break
	check(seg != null, "the hall exists in the active museum")
	if seg == null:
		_finish(); return
	for i in range(30): await get_tree().process_frame
	var vest: int = int(em.get("VESTIBULE_H"))
	var capture: bool = "--capture" in OS.get_cmdline_user_args()
	var cam: Camera3D
	if capture:
		var wc: Camera3D = em.get("_cam")
		if wc != null and is_instance_valid(wc):
			for c in wc.get_children():
				if c is Timer: (c as Timer).stop()
		cam = Camera3D.new(); em.add_child(cam); cam.fov = 62
	measurements["captures"] = {}

	await _review_galleries(seg, em, cam)
	_finish()

## The twelve-edge frame's outer span, so "matched volume" is measured and not asserted.
func _frame_span(vol: Node3D) -> Vector3:
	if vol == null:
		return Vector3.ZERO
	var lo := Vector3(INF, INF, INF)
	var hi := Vector3(-INF, -INF, -INF)
	for e in vol.find_children("Edge_*", "", false, false):
		var m: MeshInstance3D = e
		var box: BoxMesh = m.mesh
		if box == null: continue
		var half: Vector3 = box.size * 0.5
		lo = Vector3(min(lo.x, m.position.x - half.x), min(lo.y, m.position.y - half.y), min(lo.z, m.position.z - half.z))
		hi = Vector3(max(hi.x, m.position.x + half.x), max(hi.y, m.position.y + half.y), max(hi.z, m.position.z + half.z))
	return hi - lo

func _same_points(a: Dictionary, b: Dictionary) -> Dictionary:
	var pa: Dictionary = a.get("points", {})
	var pb: Dictionary = b.get("points", {})
	var worst: float = 0.0
	var counts: Array = []
	for k in ["proposed", "admitted"]:
		var la: Array = pa.get(k, [])
		var lb: Array = pb.get(k, [])
		counts.append([k, la.size(), lb.size()])
		if la.size() != lb.size():
			return {"same": false, "why": "different counts", "counts": counts}
		for i in range(la.size()):
			for c in range(3):
				worst = max(worst, abs(float(la[i][c]) - float(lb[i][c])))
	return {"same": worst < 0.0005, "worst_move": snappedf(worst, 0.0001), "counts": counts}

func _brief(st: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for k in st.keys():
		if k == "points": continue
		out[k] = st[k]
	return out

func _press(panel: Node, btn_name: String) -> bool:
	if panel == null: return false
	var btn: Node = panel.find_child(btn_name, true, false)
	if btn == null: return false
	var area: Node = btn.get_node_or_null("InteractableAreaButton")
	if area == null or not area.has_signal("button_pressed"): return false
	area.emit_signal("button_pressed", area)
	return true

func _cam_pose(cam: Camera3D) -> Dictionary:
	var cur: Camera3D = get_viewport().get_camera_3d()
	var fwd: Vector3 = -cam.global_transform.basis.z
	return {"current_camera": str(cur.get_path()).right(50) if cur != null else "none", "is_ours": cur == cam,
		"at": [snappedf(cam.global_position.x, 0.01), snappedf(cam.global_position.y, 0.01), snappedf(cam.global_position.z, 0.01)],
		"forward": [snappedf(fwd.x, 0.01), snappedf(fwd.y, 0.01), snappedf(fwd.z, 0.01)]}

func _finish() -> void:
	var report := {"map": MAP, "checks": checks, "failures": failures, "measurements": measurements,
		"control_path": "REDRAW / NEW SEED / RULE / RESTORE through InteractableAreaButton.button_pressed (one argument); the live port presses NEW SEED and REDRAW through the desktop pointer and carries a point with the pointer's own grab",
		"hand_file": "ada_run/necklace_hand.json (real)", "headset_verified": false,
		"engine": Engine.get_version_info().string, "physics_fps": Engine.physics_ticks_per_second}
	var f := FileAccess.open(OUT + "probe_points_live.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(report, "  ")); f.close()
	print("[wcn-points] ", checks, " checks; ", failures.size(), " failures")
	get_tree().quit(0 if failures.is_empty() else 1)

func _review_galleries(seg: Node3D, em: Node3D, cam: Camera3D) -> void:
	var records: Dictionary = {}
	var artifacts: Dictionary = {}
	for rec: Dictionary in em.get("_edit_records"):
		var node: Node = rec.get("node")
		if node != null and seg.is_ancestor_of(node):
			var token: String = str(rec.get("token", ""))
			if token in ["randompoint", "randompoints", "WhiteNoiseGallery", "NoiseColors3D"]:
				artifacts[token] = node
	check(artifacts.size() == 4, "all four existing room artifacts are present")
	check(artifacts.get("randompoint") != null and artifacts.get("randompoints") != null, "both earlier point encounters remain in place")
	for token in ["WhiteNoiseGallery", "NoiseColors3D"]:
		var g: Node3D = artifacts.get(token)
		check(g != null, token + " exists in the actual museum")
		if g == null: continue
		var panel: Node3D = g.get("_control_panel")
		var status: Label3D = g.get("_status_label")
		var model: MultiMeshInstance3D = g.get("_multi_mesh_instance")
		var unit: Node3D = g.get_node_or_null("GalleryConsole")
		check(unit != null, token + " has a human-sized console")
		if unit == null: continue
		check(unit.global_basis.get_scale().distance_to(Vector3.ONE) < 0.0001, token + " miniature scale does not shrink the console")
		var entry: Dictionary = {"scale": g.global_basis.get_scale().x, "model_count": model.multimesh.instance_count, "panel_height": panel.global_position.y, "modes": [], "height_samples": []}
		var initial: Array = []
		for i in range(model.multimesh.instance_count):
			var t: Transform3D = model.multimesh.get_instance_transform(i)
			initial.append([t.origin.x,t.origin.y,t.origin.z,t.basis.y.y])
			entry["height_samples"].append(t.basis.y.y)
		check(initial.size() == (10000 if token == "WhiteNoiseGallery" else 1000), token + " retains the full existing visual field")
		check(panel.global_position.y > 1.05 and panel.global_position.y < 1.50, token + " panel stands at reachable height")
		var drv: Node = load("res://commons/testing/wcn_desktop_driver.gd").new()
		get_tree().root.add_child(drv)
		var from: Vector3 = unit.global_position + g.global_basis.orthonormalized() * Vector3(0,0,1.38)
		from.y = 0.05
		drv.call("spawn", from, em)
		for i in range(15): await get_tree().process_frame
		var names := ["WHITE", "PINK", "BROWN", "BLUE", "VIOLET"]
		for mode in range(5):
			var button: Node = panel.find_child("Btn_%d" % mode, true, false)
			var press: Dictionary = await drv.call("press", button, from)
			await get_tree().create_timer(0.12).timeout
			check(g.get("_audio_playing") and int(g.get("_current_audio_noise")) == mode, token + " pointer selects " + names[mode])
			check((g.get("_audio_player") as AudioStreamPlayer3D).playing and g.get("_audio_stream") != null, token + " sound stream is active for " + names[mode])
			check(status.text.contains(names[mode]) and status.text.contains("separate"), token + " status names sound and its separate source")
			var same: bool = initial.size() == model.multimesh.instance_count
			for i in range(initial.size()):
				var t: Transform3D = model.multimesh.get_instance_transform(i)
				if [t.origin.x,t.origin.y,t.origin.z,t.basis.y.y] != initial[i]: same = false; break
			check(same, token + " model stays unchanged when sound changes to " + names[mode])
			entry["modes"].append({"mode": names[mode], "press": press, "model_unchanged": same, "status": status.text})
			if mode == 2:
				await _gallery_capture(cam, g, Vector3(0,1.0,2.7), Vector3(0,.20,.2), token + "-gallery")
				await _gallery_capture(cam, unit, Vector3(0,.65,1.40), Vector3(0,.10,.75), token + "-console")
		var stop: Dictionary = await drv.call("press", panel.find_child("Btn_5",true,false), from)
		check(not g.get("_audio_playing") and not (g.get("_audio_player") as AudioStreamPlayer3D).playing, token + " STOP ends playback through the pointer")
		entry["stop"] = stop
		drv.call("teardown")
		# Dry output from the actual generator, independent of room attenuation.
		# Give every mode the same white innovations. No microphone/headset claim.
		entry["audio"] = []
		for mode in range(5):
			var rng: RandomNumberGenerator = g.get("_audio_rng")
			rng.seed = 12345
			g.call("_reset_audio_filter_state")
			var sample_count: int = 88200
			var bytes := PackedByteArray(); bytes.resize(sample_count * 2)
			var first: Array = []
			var energy: float = 0.0
			var peak: float = 0.0
			for i in range(sample_count):
				var value: float = g.call("_generate_noise_sample", mode)
				energy += value * value; peak = maxf(peak, absf(value))
				if i < 512: first.append(value)
				var pcm: int = roundi(value * 32767.0)
				bytes[i*2] = pcm & 0xff; bytes[i*2+1] = (pcm >> 8) & 0xff
			check(peak > 0.001 and peak <= 0.950001, token + " " + names[mode] + " has bounded non-silent dry output")
			var wave := AudioStreamWAV.new()
			wave.format = AudioStreamWAV.FORMAT_16_BITS; wave.mix_rate = 44100; wave.stereo = false; wave.data = bytes
			var path: String = OUT + token + "-" + names[mode].to_lower() + ".wav"
			check(wave.save_to_wav(path) == OK, token + " " + names[mode] + " dry preview saved")
			entry["audio"].append({"mode":names[mode],"samples":sample_count,"rate":44100,"seed":12345,"rms":sqrt(energy/sample_count),"peak":peak,"first":first,"file":path.get_file()})
		records[token] = entry
	if artifacts.has("WhiteNoiseGallery") and artifacts.has("NoiseColors3D"):
		for mode in range(5):
			check(records["WhiteNoiseGallery"]["audio"][mode]["first"] == records["NoiseColors3D"]["audio"][mode]["first"], "same-input generators agree across both consumers: mode %d" % mode)
	var mine: Array = []
	for e in em.get("_walk_severed"):
		if str(e.get("hall", "")).contains(MAP): mine.append(e)
	check(mine.is_empty(), "gallery controls preserve the museum's door-to-door route")
	var f := FileAccess.open(OUT + "galleries.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(records, "  ")); f.close()
	measurements["galleries"] = {"tokens": records.keys(), "records": "galleries.json", "audio_lane": "dry generated samples and stream state; not recorded room output", "heard_by_person": false}


func _gallery_capture(cam: Camera3D, g: Node3D, offset: Vector3, aim: Vector3, filename: String) -> void:
	cam.global_position = g.global_position + g.global_basis.orthonormalized() * offset
	cam.look_at(g.global_position + g.global_basis.orthonormalized() * aim)
	for i in range(12): cam.make_current(); await get_tree().process_frame
	get_viewport().get_texture().get_image().save_png(OUT + filename + ".png")
