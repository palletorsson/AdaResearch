{
 "map_info": {
  "name": "Trans_Body",
  "lookup_name": "Trans_Body",
  "title": "The Body",
  "description": "Three thresholds, and your own body is what opens each one. A corridor narrows to a wall of slats that stands shut and makes way exactly where you are standing, then closes again behind you. It narrows further to a solid block of small cubes that loses every cube you touch, so you melt a tunnel through it and the tunnel stays cut in the shape of the body that cut it. It narrows a third time to a field of blocks packed closer together than a pair of shoulders, which shrink as you come near and grow back once you are past. Nothing in this hall moves on its own. Here your approach supplies the input: slats turn, blocks shrink, and the carved lattice keeps a permanent change. Removal is deliberately a different operation from the reversible transformations.",
  "format": "json",
  "version": "1.0",
  "dimensions": {
   "width": 11,
   "depth": 25,
   "max_height": 5
  },
  "museum": {
   "wall_height": 4,
   "plinths": false,
   "simulation": {
    "grid": true,
    "staged": true,
    "margin": 2,
    "padding": 2,
    "depth": 2.5,
    "fire": false
   }
  },
  "metadata": {
   "source": "authored",
   "n_artifacts": 4,
   "difficulty": "beginner",
   "category": "tutorial",
   "estimated_time": "2 minutes",
   "learning_objective": "Use bodily approach as input; distinguish reversible rotation/scaling from persistent removal of geometry."
  }
 },
