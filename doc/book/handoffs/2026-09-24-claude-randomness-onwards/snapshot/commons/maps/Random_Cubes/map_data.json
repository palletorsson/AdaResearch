  "map_info": {
    "name": "Random Algorithms Arena",
    "title": "Probability Primitives",
    "lookup_name": "Random_Cubes",
    "description": "A user-thrown simulated die connects a physical outcome to a retained statistical record and an authored reward. Compare one result, a face frequency and the running mean while keeping the throwing procedure in view.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 13,
      "depth": 20,
      "max_height": 3
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "algorithms",
      "estimated_time": "5-7 minutes",
      "learning_objectives": [
        "Compare the upward physical face with the reported result after settlement",
        "Track one face’s frequency separately from the running numerical mean",
        "Use the equal-face mean of 3.5 as a distribution hypothesis rather than a possible face",
        "Keep the throwing method and reward rule distinct from a claim of fairness"
      ]
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0
    }
  },
