[gd_scene format=3 uid="uid://c7knt5mqx2vbd"]

[ext_resource type="Script" path="res://commons/artifacts/salesman_knot/salesman_knot.gd" id="1_salesman_knot"]

; Everything is built in _ready(): the serpentine Hamiltonian circuit, the
; trefoil field that sets the stroke width per edge, and one MultiMesh carrying
; the whole tour. Nothing is authored here, so there is nothing here to drift.
;
; THE SCRIPT IS ON THE ROOT. GridInteractablesComponent sets config_* metadata
; and calls apply_grid_config on the ROOT node; a scriptless root with the logic
; on a child makes every map token silently unreachable.
;
; The root is a plain Node3D and the collider is a StaticBody3D CHILD built at
; run time, sized from the same numbers as the plate, so the body is where the
; plate is. See rule 2 in salesman_knot.gd.

[node name="SalesmanKnot" type="Node3D"]
script = ExtResource("1_salesman_knot")
