{
  "map_info": {
    "description": "Two movable balls map six parameters of a phase-modulation/FM-style instrument. Establish a baseline, hold a reference and compare a changed note. A four-lane scope shows the modulation term, carrier, rule and output while the ear follows the full envelope.",
    "dimensions": {
      "width": 14,
      "depth": 16,
      "max_height": 4
    },
    "format": "json",
    "lookup_name": "WaveFunctions_Effect_Sound",
    "metadata": {
      "category": "wavefunctions",
      "difficulty": "intermediate",
      "estimated_time": "8-12 minutes",
      "learning_objectives": [
        "Use BASELINE, HOLD, PLAY and COMPARE to hear one changed parameter",
        "Map ball position to carrier frequency and envelope, and to modulation ratio, index and decay",
        "Read modulation inside the carrier phase rather than as an added output voice",
        "Separate the carrier envelope from the modulator envelope",
        "Notice the scope’s normalization and short time window; preserve listening as evidence"
      ]
    },
    "name": "Audio Reactive Mario",
    "title": "Sound as Waveform",
