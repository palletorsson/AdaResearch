	  "difficulty": "intermediate",
	  "category": "wavefunctions",
	  "estimated_time": "8-12 minutes",
	  "learning_objectives": [
		"Change five harmonic amplitudes and predict their sum at one phase",
		"Distinguish a continuous parameter change from a recipe label threshold",
		"Observe finite harmonics, display thresholds and rounded coefficients",
        "Separate restoring coefficients from restoring phase before entering randomness"
	  ]
	},
