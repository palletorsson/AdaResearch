  "documentation": {
	"summary": "WaveFunctions Synthesis Lab",
	"layout": "11x13 laboratory with workstations, glass display cases, and experimental apparatus",
	"objective": "Understand how complex signals decompose into simple waves, and see oscillation in biological systems",
	"key_elements": [
	  "air_music_display_case - Air Music in glass display: spatial audio triggered by movement, subtle ambient phasing",
	  "additive_wave_demo - Build waves from harmonics",
	  "dna_specimen - DNA double helix in glass jar, biological oscillation made visible",
	  "petri_dish_worms - C. elegans moving in sine patterns",
	  "GlassRack - Laboratory glassware apparatus",
	  "lissajous_curves - 3D parametric waveforms in glass display case (1m)",
	  "oscilloscope - Waveform visualization",
	  "seismograph - Drum chart recorder with sine trace",
	  "chladni_plate - Vibration pattern visualization",
	  "multimeter - AC voltage needle oscillation",
	  "chemicalapparatus - Bubbling liquids with phase offsets",
	  "samplevialrack - Wave propagation across 6 vials",
	  "electronicscales - Damped harmonic settling",
	  "microscope - Pulsing illumination",
	  "atmosphericmonitoring - Three gauges at different frequencies",
	  "holographicdisplay - Scan line + flicker effects",
      "biomagneticresonator - Standing waves with harmonics"
	]
  },
