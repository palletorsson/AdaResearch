  "map_info": {
	"name": "WaveFunctions_Synthesis_Lab",
	"title": "The sum on the bench",
	"lookup_name": "WaveFunctions_Synthesis_Lab",
	"description": "A visual laboratory for taking a five-term wave apart and reconstructing it. One additive bench exposes the coefficients, component rows, shared phase and their sum. The surrounding specimens remain independent supporting material.",
	"version": "placed-humanoid_walker",
	"format": "json",
