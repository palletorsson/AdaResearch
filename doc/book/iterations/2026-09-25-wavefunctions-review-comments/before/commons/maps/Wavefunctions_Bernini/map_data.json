{
  "map_info": {
    "name": "Bernini's Twist: The Baroque Algorithm",
    "title": "Baroque Helical Columns",
    "lookup_name": "Wavefunctions_Bernini",
    "description": "Repeated spiral columns distinguish periodic change through height from rotation through time. A CPU-generated ring mesh combines sine/cosine centre offsets, radius variation and a changing angular phase, with procedural audio accompaniment.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 20,
      "depth": 16,
      "max_height": 3
    },
    "metadata": {
      "difficulty": "advanced",
      "category": "wavefunctions",
      "estimated_time": "5-7 minutes",
      "learning_objectives": [
        "Follow a shaft profile through height, then observe the shaft rotate through time",
        "Relate circular sine/cosine coordinates to a helical centre path and radial variation",
        "Distinguish generated mesh construction from a vertex-shader or noise deformation",
        "Read the repetition of columns as intervals and sight lines",
        "Treat architectural inspiration and generated accompaniment as situated choices, not a full historical account or a touch instrument"
      ]
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0
    }
  },
