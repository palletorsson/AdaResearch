    "provenance": "Explicit assumed reconstruction from Point One excerpts and its small solid-point source. Current Point One lesson edits an existing museum script; it does not yet yield this standalone file. Names, material helper and subdivisions are retained source settings, not evidence of taught mastery."
  },
  "operations": [
    {
      "id": "body-class",
      "kind": "replace",
      "before": "\tvar solid := StaticBody3D.new()\n",
      "after": "\tvar solid := XRToolsPickable.new()\n"
    },
    {
      "id": "pickup-settings",
      "kind": "insert_after",
      "anchor": "\tsolid.position = centre\n",
      "text": "\tsolid.freeze = true\n\tsolid.freeze_mode = RigidBody3D.FREEZE_MODE_KINEMATIC\n\tsolid.release_mode = XRToolsPickable.ReleaseMode.FROZEN\n\tsolid.ranged_grab_method = XRToolsPickable.RangedMethod.NONE\n\tsolid.collision_layer = 4\n\tsolid.collision_mask = 196615\n"
    },
    {
      "id": "carry-visible-surface",
      "kind": "insert_after",
      "anchor": "\tadd_child(solid)\n",
      "text": "\tbody.reparent(solid)\n"
    }
  ],
