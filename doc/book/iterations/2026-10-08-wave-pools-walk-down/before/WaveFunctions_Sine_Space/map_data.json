{
  "map_info": {
    "name": "Sine Space: The Eternal Return",
    "title": "Walking Through Sine",
    "lookup_name": "WaveFunctions_Sine_Space",
    "description": "A contact tray and visible wave corridor lead into a broad silver sine floor. Coloured balls fall, bounce and roll across the same relief the player crosses between solid side walls.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 20,
      "depth": 40,
      "max_height": 4
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "wavefunctions",
      "estimated_time": "6-8 minutes",
      "learning_objectives": [
        "Compare sphere size and relief on one stationary colliding sine surface",
        "Interpret outlet, other-exit and still-in counts at a stated deadline",
        "Compare a moving layered wall with walking past its frozen form",
        "Distinguish relative phase, local-X gap and collision support"
      ]
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0,
      "sculpture_clear_rects": [
        [
          1,
          1,
          18,
          38
        ]
      ],
      "artifact_placement": "map"
    }
  },
  "utility_definitions": {
    "t": {
      "type": "teleporter",
      "name": "Next Lesson",
      "description": "Continue to the next algorithm demonstration",
      "properties": {
        "action": "next_in_sequence"
      }
    }
  },
  "documentation": {
    "summary": "Sine Space: a stationary contact surface and a moving visible passage",
    "layout": "20x40. Widened forecourt, north-south wave corridor, then a 14x18-metre sine floor between solid side walls. Coloured physics balls drop from overhead; no level bypass. Arrival and exit landings meet zero-height ends.",
    "objective": "Predict a sphere departure, release, change only body size or relief, then compare the colliding tray with the corridor walls that permit crossing. Keep the counter and the measured x-gap explicit.",
    "key_elements": [
      "All five earlier artifacts retained and shifted 3m right: tray (6,4), explanation (6,9), corridor (9,12), wave floor centred (9,26), dark sphere (13,36).",
      "Colorballs (9,25), sine_rain case: 48 coloured spheres, radius 0.22m, continuous staggered recycling above the wave floor.",
      "Walls occupy x1 and x16-18 over z17-34, joined to the outer shell. Wave floor spans x2..16, z17..35.",
      "Spawn (11,2), exit (14,37). No lift or flat side bypass.",
      "Student surface bay remains hall-local (10.5,0,8.5)."
    ]
  },
