{
  "map_info": {
    "name": "Wave Propagation: The Medium is the Message",
    "title": "Waves Through Space",
    "lookup_name": "WaveFunctions_3D_Wave_Propagation",
    "description": "Follow a disturbance through a finite lattice of coupled oscillators. Compare the same sine drive or one pulse with links present and absent. A nearby tiled wave display offers a contrasting analytic distance-field construction; its default attenuation is exponential.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 24,
      "depth": 36,
      "max_height": 5
    },
    "metadata": {
      "difficulty": "intermediate",
      "category": "wavefunctions",
      "estimated_time": "5-7 minutes",
      "learning_objectives": [
        "Follow one sphere before reading a travelling pattern across the lattice",
        "Compare identical starting states and forcing with coupling on or off",
        "Distinguish a continuing sine drive from a single velocity pulse",
        "Relate boundary behaviour to the number of neighbours",
        "Compare local force integration with the secondary display’s analytic distance field; do not infer physical inverse-square energy transport from either display"
      ],
      "n_artifacts": 5
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0,
      "artifact_placement": "map",
      "sculpture_clear_rects": [
        [
          1,
          1,
          22,
          34
        ]
      ]
    }
  },
  "utility_definitions": {
    "t": {
      "type": "teleporter",
      "name": "Next Lesson",
      "description": "Continue to the next algorithm demonstration",
      "properties": {
        "action": "next_in_sequence"
      }
    }
  },
  "documentation": {
    "summary": "Wave propagation: a neighbour responds",
    "layout": "24x36 m level museum gallery. Near field: film and coupled lattice, with its real comparison controls on the east edge. Kusama sculpture has a separate right-hand bay. Tiled radial field occupies the rear with an open perimeter route.",
    "objective": "Compare local neighbour coupling with a prescribed radial display. Reconstruct the relationship with a small row of the carried PointBody spheres.",
    "key_elements": [
      "Five earlier authored artifacts retained. No curriculum reordering.",
      "Lattice at (6,10); panel reached from the east. Bonds reveal adjacent relations; independent mode hides them.",
      "Kusama at (18,11), raised 2m. Radial tiles at (12,25), raised 0.9m to keep troughs above the floor.",
      "Spawn (11,2), exit (11,33); level perimeter route avoids moving tiles.",
      "Student bay hall-local (12,0,11), yaw180, scale1. The lesson creates its own row, rods and readout."
    ]
  },
