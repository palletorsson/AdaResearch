+## Ready
 
-## Once
+Find this function:
 
 ```gdscript
-extends Node3D
-
-var display := Label3D.new()
-
-func _ready():
-    display.position.y = 1.5
-    display.text = "Hello, world."
-    add_child(display)
+func _ready() -> void:
+    _build()
+    _arrival_frame = int(Engine.get_process_frames())
+    _built = true
