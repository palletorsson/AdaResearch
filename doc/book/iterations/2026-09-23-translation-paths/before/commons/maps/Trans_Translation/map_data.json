        "Trans_AxisDecomposition"
      ],
      "n_artifacts": 19,
      "learning_objectives": [
        "Ride translations along positive and negative axes",
        "Compare the same z displacement at different heights",
        "Collect pickups through carried contact",
        "Compose x and z without rotation",
        "Compare the same displacement with sequential axis constraints and a free diagonal route"
      ]
    },
