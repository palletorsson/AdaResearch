+func select_comparison_rule(next_rule: String) -> void:
+	if not comparison or next_rule not in ["trail", "avoid"]:
+		return
+	rule = next_rule
+	replay_comparison()
+
+
+## Same per-step decay/walk order as _warmup. Boundary correction can skip a
+## walker's later draws, so equal seeds do not promise identical draw use by two laws.
+func advance_comparison(count: int = 1) -> void:
+	if not comparison or not _terrain_ready:
+		return
+	for _i in clampi(count, 1, 20):
+		_decay_pheromones(1.0 / maxf(walk_speed, 0.001))
+		_walk_step()
+		_comparison_steps += 1
+	_update_mesh()
+	_update_info_label()
+	_update_comparison()
+
