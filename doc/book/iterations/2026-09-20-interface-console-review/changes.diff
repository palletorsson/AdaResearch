+## Optional live 2D value screen seated on the horizontal panel fader. The
+## original label remains an internal compatibility sink but is never drawn.
+## Rendering happens only when the formatted value changes.
+func use_panel_value_surface() -> void:
+	if is_instance_valid(_surface_value): return
+	if not _ensure_label(): return
+	_label.hide()
+	_surface_viewport = SubViewport.new()
+	_surface_viewport.name = "ValueViewport"
+	_surface_viewport.size = Vector2i(128, 48)
+	_surface_viewport.disable_3d = true
+	_surface_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
+	add_child(_surface_viewport)
+	var background := ColorRect.new()
+	background.size = Vector2(128, 48)
+	background.color = Color(0.08, 0.09, 0.10)
+	_surface_viewport.add_child(background)
+	_surface_value = Label.new()
+	_surface_value.name = "Value"
+	_surface_value.size = Vector2(128, 48)
+	_surface_value.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	_surface_value.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	_surface_value.add_theme_font_size_override("font_size", 28)
+	_surface_value.add_theme_color_override("font_color", Color(0.75, 1.0, 0.70))
+	_surface_value.text = _last_display_text
+	_surface_viewport.add_child(_surface_value)
+	var screen := MeshInstance3D.new()
+	screen.name = "ValueSurface"
+	var quad := QuadMesh.new()
+	quad.size = Vector2(0.052, 0.020)
+	screen.mesh = quad
+	screen.position = Vector3(0.027, 0.075, 0.0085)
+	screen.rotation_degrees.z = -90.0
+	screen.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	var material := StandardMaterial3D.new()
+	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	material.albedo_texture = _surface_viewport.get_texture()
+	screen.material_override = material
+	get_node("Frame").add_child(screen)
 
