  "halls": [
    {
      "id": "CA_Introduction",
      "number": 1,
      "operation": "Read three Boolean states, select a rule answer and write a new row. Keep old and next separate.",
      "point_role": "Move to inspect an address; trigger advances one generation.",
      "question": "What does a local rule make, and what has the display or imposed symmetry already arranged?",
      "tracks": {
        "tutorial": {
          "title": "A row with neighbours",
          "prose_words_approx": 917,
          "code_blocks": 2,
          "code_lines": 171
        },
        "final": {
          "title": "What will the next row do?",
          "prose_words_approx": 1641,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "A row with neighbours",
      "image": "assets/CA_Introduction/neighbour-ring.png",
      "overhead": "assets/CA_Introduction/room-overhead.png"
    },
    {
      "id": "CA_ElementaryRules",
      "number": 2,
      "operation": "Give each address empty, active or fading state. Count active neighbours in a finite volume.",
      "point_role": "Carry STEP while observing the enlarged neighbourhood.",
      "question": "Can something remain present after it stops contributing to its neighbours?",
      "tracks": {
        "tutorial": {
          "title": "A state that lingers",
          "prose_words_approx": 1095,
          "code_blocks": 2,
          "code_lines": 176
        },
        "final": {
          "title": "A cell with a past",
          "prose_words_approx": 960,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "A state that lingers",
      "image": "assets/CA_ElementaryRules/lingering-cell.png",
      "overhead": "assets/CA_ElementaryRules/room-overhead.png"
    },
    {
      "id": "CA_GameOfLife",
      "number": 3,
      "operation": "Keep independent generations and map one record onto a board and supporting tiles.",
      "point_role": "Move to inspect a recorded generation; trigger appends the next.",
      "question": "When does a gap in an image become a missing support for a body?",
      "tracks": {
        "tutorial": {
          "title": "Keep a generation",
          "prose_words_approx": 978,
          "code_blocks": 2,
          "code_lines": 192
        },
        "final": {
          "title": "A history you can inhabit",
          "prose_words_approx": 775,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "Keep a generation",
      "image": "assets/CA_GameOfLife/walking-history.png",
      "overhead": "assets/CA_GameOfLife/room-overhead.png"
    },
    {
      "id": "CA_BeyondBinary",
      "number": 4,
      "operation": "Update a two-dimensional present. Follow a moving pattern through fixed addresses and connect one address to a lamp.",
      "point_role": "Carry STEP; the point does not plant or move the pattern.",
      "question": "What moves when the addresses stay, and what does being observed change?",
      "tracks": {
        "tutorial": {
          "title": "A pattern visits an address",
          "prose_words_approx": 870,
          "code_blocks": 2,
          "code_lines": 204
        },
        "final": {
          "title": "A pattern visits an address",
          "prose_words_approx": 990,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "A pattern visits an address",
      "image": "assets/CA_BeyondBinary/life-floor.png",
      "overhead": "assets/CA_BeyondBinary/room-overhead.png"
    },
    {
      "id": "CA_ExpandingSpace",
      "number": 5,
      "operation": "Let a position become an input. Compare decay, recovery and simultaneous versus ordered updates.",
      "point_role": "Place the held point near the field; its position enters the rule.",
      "question": "What happens when observing becomes one of the conditions of the surface?",
      "tracks": {
        "tutorial": {
          "title": "The surface includes you",
          "prose_words_approx": 1268,
          "code_blocks": 2,
          "code_lines": 194
        },
        "final": {
          "title": "The surface includes you",
          "prose_words_approx": 790,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "The surface includes you",
      "image": "assets/CA_ExpandingSpace/presence-depleted.png",
      "overhead": "assets/CA_ExpandingSpace/room-overhead.png"
    },
    {
      "id": "CA_SoftRules",
      "number": 6,
      "operation": "Store two concentrations and compare local reaction with neighbour exchange.",
      "point_role": "Choose a position and trigger a seed in both fields.",
      "question": "What can a cell receive, and which relations have been withheld?",
      "tracks": {
        "tutorial": {
          "title": "What a neighbour offers",
          "prose_words_approx": 1260,
          "code_blocks": 3,
          "code_lines": 251
        },
        "final": {
          "title": "What can a cell receive?",
          "prose_words_approx": 963,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "What a neighbour offers",
      "image": "assets/CA_SoftRules/exchange-seed.png",
      "overhead": "assets/CA_SoftRules/room-overhead.png"
    },
    {
      "id": "CA_AgentsCircuits",
      "number": 7,
      "operation": "Compare a local state update with a supplied recursive placement recipe. Change only the seed.",
      "point_role": "Return to address inspection and STEP beside a fixed construction.",
      "question": "Does a similar outline establish the same way of making?",
      "tracks": {
        "tutorial": {
          "title": "Two ways to make",
          "prose_words_approx": 1242,
          "code_blocks": 3,
          "code_lines": 204
        },
        "final": {
          "title": "The same pattern, different work",
          "prose_words_approx": 943,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "Two ways to make",
      "image": "assets/CA_AgentsCircuits/two-procedures.png",
      "overhead": "assets/CA_AgentsCircuits/room-overhead.png"
    },
    {
      "id": "CA_EdgeOfChaos",
      "number": 8,
      "operation": "Run matched fields from almost identical beginnings. Distinguish storage, measurement and display gain.",
      "point_role": "Select a Z section; trigger updates both fields. Release returns the installed reader to walking.",
      "question": "Has a difference vanished, or have our storage, counting and viewing choices hidden it?",
      "tracks": {
        "tutorial": {
          "title": "What a difference keeps",
          "prose_words_approx": 1523,
          "code_blocks": 3,
          "code_lines": 285
        },
        "final": {
          "title": "How far does one difference go?",
          "prose_words_approx": 1181,
          "code_blocks": 0,
          "code_lines": 0
        }
      },
      "label": "What a difference keeps",
      "image": "assets/CA_EdgeOfChaos/one-difference.png",
      "overhead": "assets/CA_EdgeOfChaos/room-overhead.png"
    }
