+extends MeshInstance3D
+## An opt-in image on the existing floor. It owns no collision or player movement.
+const PATTERN_SHADER = preload("res://commons/artifacts/regularity/super_triangle.gdshader")
+const FAMILIES := ["DIAGONALS", "CHEVRONS", "DIAMONDS", "TURNING WAVES", "LARGE DIAMONDS", "SUPER DIAMONDS"]
+var receiver: Node3D
+var _layout: Array = []
+var _pulse_texture: ImageTexture
+var _pulse_data := PackedByteArray()
+
+func _ready() -> void:
+	name = "SuperTriangleSurface"
+	cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	mesh = PlaneMesh.new()
+	var material := ShaderMaterial.new()
+	material.shader = PATTERN_SHADER
+	material_override = material
+
+func update_pattern(clock: float, ink: Color, paper: Color, columns: Array) -> void:
+	if not is_instance_valid(receiver): return
+	var layout := [receiver.grid_width, receiver.grid_depth, receiver.tile_size, receiver.floor_y_offset, receiver.floor_height, receiver.tile_gap]
+	if layout != _layout:
+		_layout = layout
+		(mesh as PlaneMesh).size = Vector2(receiver.grid_width, receiver.grid_depth) * receiver.tile_size
+		position.y = receiver.floor_y_offset + receiver.floor_height + 0.003
+		material_override.set_shader_parameter("tile_count", Vector2(receiver.grid_width, receiver.grid_depth))
+		material_override.set_shader_parameter("tile_size", receiver.tile_size)
+		material_override.set_shader_parameter("gap_fraction", receiver.tile_gap / receiver.tile_size * 0.5)
+		_pulse_data.resize(receiver.grid_width)
+		_pulse_data.fill(0)
+		_pulse_texture = ImageTexture.create_from_image(Image.create_from_data(receiver.grid_width, 1, false, Image.FORMAT_R8, _pulse_data))
+		material_override.set_shader_parameter("column_pulses", _pulse_texture)
+	var pulses := PackedByteArray()
+	pulses.resize(receiver.grid_width)
+	pulses.fill(0)
+	for column in columns:
+		if column >= 0 and column < pulses.size(): pulses[column] = 255
+	if pulses != _pulse_data:
+		_pulse_data = pulses
+		_pulse_texture.update(Image.create_from_data(receiver.grid_width, 1, false, Image.FORMAT_R8, _pulse_data))
+	material_override.set_shader_parameter("motion", fposmod(clock, 24.0))
+	material_override.set_shader_parameter("ink", ink)
+	material_override.set_shader_parameter("paper", paper)
--- before/commons/artifacts/regularity/super_triangle.gdshader
+++ commons/artifacts/regularity/super_triangle.gdshader
@@ -0,0 +1,63 @@
+shader_type spatial;
+render_mode unshaded, cull_disabled;
+
+uniform vec2 tile_count = vec2(12.0);
+uniform float tile_size = 0.8;
+uniform float gap_fraction = 0.0125;
+uniform float motion = 0.0;
+uniform vec4 ink : source_color = vec4(0.0, 0.0, 0.0, 1.0);
+uniform vec4 paper : source_color = vec4(1.0);
+uniform sampler2D column_pulses : filter_nearest, repeat_disable;
+varying vec2 grid_position;
+const float QUARTER_TURN = 1.57079632679;
+const float FULL_TURN = 6.28318530718;
+
+float grouping(int family) {
+	if (family == 4) { return 2.0; }
+	if (family == 5) { return 3.0; }
+	return 1.0;
+}
+
+float angle_for(int pose, vec2 grid) {
+	int family = (pose / 4) % 6;
+	vec2 cell = floor(grid / grouping(family));
+	vec2 parity = mod(cell, 2.0);
+	float quarter = 0.0;
+	if (family == 1) {
+		quarter = parity.x;
+	} else if (family == 2 || family >= 4) {
+		// Four half-square motifs face the common centre of a 2 by 2 block.
+		quarter = mix(mix(0.0, 1.0, parity.x), mix(3.0, 2.0, parity.x), parity.y);
+	} else if (family == 3) {
+		quarter = mod(cell.x + cell.y, 4.0);
+	}
+	return (quarter + float(pose % 4) + 0.5) * QUARTER_TURN;
+}
+
+void vertex() {
+	grid_position = VERTEX.xz / tile_size + tile_count * 0.5;
+}
+
+void fragment() {
+	// The receiving square tiles and their joints stay in the same places.
+	vec2 within_tile = fract(grid_position);
+	if (min(min(within_tile.x, within_tile.y), min(1.0-within_tile.x, 1.0-within_tile.y)) < gap_fraction) {
+		discard;
+	}
+	float clock = mod(motion, 24.0);
+	int from_pose = int(floor(clock));
+	int to_pose = (from_pose + 1) % 24;
+	float blend = smoothstep(0.15, 0.9, fract(clock));
+	float group_size = mix(grouping(from_pose / 4), grouping(to_pose / 4), blend);
+	vec2 local = fract(grid_position / group_size) - 0.5;
+	float a = angle_for(from_pose, grid_position);
+	float b = angle_for(to_pose, grid_position);
+	float turn = mod(b-a+FULL_TURN*0.5, FULL_TURN)-FULL_TURN*0.5;
+	float angle = a + turn * blend;
+	float divider = dot(local, vec2(cos(angle), sin(angle)));
+	float edge = max(fwidth(divider) * 0.75, 0.0001);
+	float white = smoothstep(-edge, edge, divider);
+	vec3 colour = mix(ink.rgb, paper.rgb, white);
+	float pulse = texture(column_pulses, vec2((floor(grid_position.x)+0.5)/tile_count.x, 0.5)).r;
+	ALBEDO = mix(colour, vec3(1.0), pulse * 0.4);
+}
