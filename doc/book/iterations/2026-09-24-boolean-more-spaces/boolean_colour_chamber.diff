+ cut.radius = radius
+ cut.height = height
+ cut.sides = 48
+ cut.smooth_faces = true
+ cut.position = at
+ cut.rotation = rotation_value
+ cut.operation = op
+ cut.material = surface
+ parent.add_child(cut)
+ return cut
