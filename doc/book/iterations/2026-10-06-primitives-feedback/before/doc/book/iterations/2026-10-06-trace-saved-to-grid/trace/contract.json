  "operations": [
    {
      "id": "sampling-distance",
      "kind": "insert_after",
      "anchor": "const CENTRE := Vector3(0, 1.12, 0)\n",
      "text": "const MIN_SEGMENT_DISTANCE := 0.05\n"
    },
    {
      "id": "history-state",
      "kind": "replace",
      "before": "var point_b: XRToolsPickable\nvar line: MeshInstance3D\nvar distance := 0.0\n",
      "after": "var positions: Array[Vector3] = []\nvar trail: Node3D\n"
    },
    {
      "id": "seed-instead-of-second-end",
      "kind": "replace",
      "before": "    point_b = PointBody.new()\n    point_b.position = CENTRE + Vector3(1.0, 0, 0)\n    add_child(point_b)\n\n    line = LineSkin.new()\n    add_child(line)\n",
      "after": "    trail = Node3D.new()\n    add_child(trail)\n    positions.append(point.position)\n"
    },
    {
      "id": "retain-and-join-neighbours",
      "kind": "replace",
      "before": "    var a := local_position\n    var b := to_local(point_b.global_position)\n    var displacement := b - a\n    distance = displacement.length()\n    line.show_segment(a, displacement, distance)\n    readout.text += \"\\nDISTANCE \" + str(distance)\n",
      "after": "    var last := positions[positions.size() - 1]\n    if (local_position - last).length() >= MIN_SEGMENT_DISTANCE:\n        positions.append(local_position)\n\n        for segment in trail.get_children():\n            segment.queue_free()\n\n        for i in range(1, positions.size()):\n            var a := positions[i - 1]\n            var displacement := positions[i] - a\n            var segment := LineSkin.new()\n            trail.add_child(segment)\n            segment.show_segment(a, displacement, displacement.length())\n\n    readout.text += \"\\nPOINTS \" + str(positions.size())\n"
    },
    {
      "id": "archive-support",
      "kind": "insert_after",
      "anchor": "const LineSkin = preload(\"line_skin.gd\")\n",
      "text": "const TraceArchive = preload(\"trace_archive.gd\")\n"
    },
    {
      "id": "save-on-release",
      "kind": "insert_after",
      "anchor": "    positions.append(point.position)\n",
      "text": "    point.dropped.connect(_save_trace)\n"
    },
    {
      "id": "save-after-drawing-settles",
      "kind": "insert_after",
      "anchor": "    readout.text += \"\\nPOINTS \" + str(positions.size())\n",
      "text": "\nfunc _save_trace(_point: Node3D) -> void:\n    await get_tree().process_frame\n    if positions.size() < 2:\n        return\n    var error := TraceArchive.save_drawing(trail, positions)\n    if error != OK:\n        push_error(\"Could not save this trace: \" + error_string(error))\n"
    }
  ],
