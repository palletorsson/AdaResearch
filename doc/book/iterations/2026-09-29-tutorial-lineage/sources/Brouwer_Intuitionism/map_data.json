      "category": "foundations",
      "difficulty": "expert",
      "estimated_time": "5-6 minutes",
      "learning_objectives": [
        "Append a chosen term and distinguish a prefix from an infinite sequence",
        "Distinguish a witness plus verification from an existence claim",
        "Understand that intuitionistic logic does not assume excluded middle in general; no third truth value is implied",
        "Construct a finite diagonal string that differs from every displayed row",
        "Distinguish constructive proof, a finite illustration and computational cost"
      ]
    },
