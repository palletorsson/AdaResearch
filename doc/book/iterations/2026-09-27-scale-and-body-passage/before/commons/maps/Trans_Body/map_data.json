 "map_info": {
  "name": "Trans_Body",
  "lookup_name": "Trans_Body",
  "title": "The Body",
  "description": "Three thresholds respond to bodily approach: slats turn, a low lattice loses cells to leave an open-topped cut, and a field of blocks shrinks. Moving beyond their sensing reach lets the slats and blocks return; the cut remains while the room stays loaded. What does the room recognise as a body, and what trace can its resolution retain?",
  "format": "json",
  "version": "1.0",
