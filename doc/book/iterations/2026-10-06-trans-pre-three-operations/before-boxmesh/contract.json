  "operations": [
    {
      "id": "next-museum-study",
      "kind": "replace",
      "before": "extends Node3D\nconst CubeBody = preload(\"cube_body.gd\")\nconst PointBody = preload(\"point_body.gd\")\nvar places: Array[Vector3] = [Vector3(-0.8, 0, 0), Vector3(0.5, 0, -0.7)]\nvar cubes: Array[Node3D] = []\nvar point := PointBody.new()\n\nfunc _ready() -> void:\n    for place in places:\n        var cube := CubeBody.new()\n        cube.position = place\n        add_child(cube)\n        cubes.append(cube)\n    point.position = Vector3(0.1, PointBody.RADIUS, 0.6)\n    add_child(point)\n",
      "after": "extends Node3D\nconst CubeBody = preload(\"cube_body.gd\")\n\nvar cube := CubeBody.new()\nvar start := Vector3(0, 1, 0)\nvar turn_degrees := 0.0\nvar size_factor := 1.0\nvar rise := 0.0\nvar duration := 2.0\nvar elapsed := 0.0\n\nfunc _ready() -> void:\n    assert(duration > 0.0 and size_factor > 0.0)\n    add_child(cube)\n    cube.position = start\n    cube.rotation_degrees.y = turn_degrees\n    cube.scale = Vector3.ONE * size_factor\n\nfunc _process(delta: float) -> void:\n    elapsed += delta\n    var t: float = minf(elapsed / duration, 1.0)\n    cube.position = start + Vector3.UP * rise * t\n"
    }
  ],
