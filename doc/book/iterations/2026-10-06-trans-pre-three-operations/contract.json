  "operations": [
    {
      "id": "next-museum-study",
      "kind": "replace",
      "before": "extends Node3D\nconst CubeBody = preload(\"cube_body.gd\")\nconst PointBody = preload(\"point_body.gd\")\nvar places: Array[Vector3] = [Vector3(-0.8, 0, 0), Vector3(0.5, 0, -0.7)]\nvar cubes: Array[Node3D] = []\nvar point := PointBody.new()\n\nfunc _ready() -> void:\n    for place in places:\n        var cube := CubeBody.new()\n        cube.position = place\n        add_child(cube)\n        cubes.append(cube)\n    point.position = Vector3(0.1, PointBody.RADIUS, 0.6)\n    add_child(point)\n",
      "after": "extends Node3D\n\nvar cube := MeshInstance3D.new()\nvar start := Vector3(0, 1, 0)\nvar turn_degrees := 0.0\nvar size_factor := 1.0\nvar rise := 0.0\nvar duration := 2.0\nvar elapsed := 0.0\n\nfunc _ready() -> void:\n    assert(duration > 0.0 and size_factor > 0.0)\n    cube.mesh = BoxMesh.new()\n    add_child(cube)\n    cube.position = start\n    cube.rotation_degrees.y = turn_degrees\n    cube.scale = Vector3.ONE * size_factor\n\n    var sensor := Area3D.new()\n    sensor.collision_layer = 0\n    sensor.collision_mask = 1\n    sensor.set_collision_mask_value(20, true)\n    cube.add_child(sensor)\n    var hitbox := CollisionShape3D.new()\n    hitbox.shape = BoxShape3D.new()\n    sensor.add_child(hitbox)\n    sensor.body_entered.connect(_on_body_entered)\n\nfunc _process(delta: float) -> void:\n    elapsed += delta\n    var t: float = minf(elapsed / duration, 1.0)\n    cube.position = start + Vector3.UP * rise * t\n\nfunc _on_body_entered(body: Node3D) -> void:\n    if body.is_in_group(\"em_walker\") or body.is_in_group(\"player_body\"):\n        print(\"Collected\")\n        queue_free()\n"
    }
  ],
