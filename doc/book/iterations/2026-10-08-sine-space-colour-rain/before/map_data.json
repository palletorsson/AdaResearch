{
  "map_info": {
    "name": "Sine Space: The Eternal Return",
    "title": "Walking Through Sine",
    "lookup_name": "WaveFunctions_Sine_Space",
    "description": "A contact tray, a visible wave corridor and a walkable sine floor. Solid walls close both side routes: the onward walking route crosses the stationary sine surface so its folds change the player’s height.",
    "version": "1.0",
    "format": "json",
    "dimensions": {
      "width": 14,
      "depth": 40,
      "max_height": 4
    },
    "metadata": {
      "difficulty": "beginner",
      "category": "wavefunctions",
      "estimated_time": "6-8 minutes",
      "learning_objectives": [
        "Compare sphere size and relief on one stationary colliding sine surface",
        "Interpret outlet, other-exit and still-in counts at a stated deadline",
        "Compare a moving layered wall with walking past its frozen form",
        "Distinguish relative phase, local-X gap and collision support"
      ]
    },
    "museum": {
      "wall_height": 3,
      "gate_depth_rows": 0,
      "sculpture_clear_rects": [
        [
          1,
          1,
          12,
          38
        ]
      ],
      "artifact_placement": "map"
    }
  },
  "utility_definitions": {
    "t": {
      "type": "teleporter",
      "name": "Next Lesson",
      "description": "Continue to the next algorithm demonstration",
      "properties": {
        "action": "next_in_sequence"
      }
    }
  },
  "documentation": {
    "summary": "Sine Space: a stationary contact surface and a moving visible passage",
    "layout": "14x40. Open forecourt, north-south wave corridor, then an 8x18-metre sine floor between solid side walls. No dry side bypass. Level arrival and exit landings meet the zero-height ends of the surface.",
    "objective": "Predict a sphere departure, release, change only body size or relief, then compare the colliding tray with the corridor walls that permit crossing. Keep the counter and the measured x-gap explicit.",
    "key_elements": [
      "All five authored artifacts retained. Tray (3,4), explanation (3,9), corridor (6,12), walkable floor centred on (6,26), dark sphere moved to the exit landing (10,36).",
      "Solid side walls occupy x1 and x10-12 over z17-34, sealing both bypasses against the outer shell.",
      "Spawn (8,2), exit (11,37). Removed the unused automatic lift at (11,14); it offered a route above the required crossing.",
      "Student surface bay remains hall-local (10.5,0,8.5)."
    ]
  },
