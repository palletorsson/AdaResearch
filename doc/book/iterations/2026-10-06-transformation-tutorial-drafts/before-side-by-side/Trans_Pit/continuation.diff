+func box(size: Vector3, at: Vector3) -> MeshInstance3D:
+    var body := MeshInstance3D.new()
+    var mesh := BoxMesh.new()
+    mesh.size = size
+    body.mesh = mesh
+    body.position = at
+    add_child(body)
+    return body
