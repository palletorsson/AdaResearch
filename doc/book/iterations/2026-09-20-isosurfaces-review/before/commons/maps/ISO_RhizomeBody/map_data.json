{
	"map_info": {
		"name": "ISO RhizomeBody",
		"lookup_name": "ISO_RhizomeBody",
		"description": "A hollow body you walk inside, grown as one signed-distance field and hollowed with abs(f) - wall, so the walkable void is the solid's own interior and the plan is a graph rather than a corridor.",
		"version": "1.0",
		"format": "json",
		"dimensions": {
			"width": 34,
			"depth": 34,
			"max_height": 8
		},
		"metadata": {
			"difficulty": "advanced",
			"category": "isosurfaces",
			"estimated_time": "6-10 minutes",
			"spatial_temperature": 0.72,
			"design_notes": "An empty hall, because the exhibit is 25 m across and IS the room. You arrive in a corner and the body is already in front of you: eight chambers, ten passages, three independent cycles, marched as one fused shell. It is sealed by construction — abs(f) - wall gives an outer skin and an inner skin and nothing between — so one chamber is bored, and finding that mouth is the first move the map asks for. Inside, the wayfinding is the anatomy: each limb carries its own hue and the sutures light where two limbs fused, so colour tells you which limb you are in and light tells you where it joins another. The teleporter is on the far side, so the walk through the body is the way out."
		},
		"title": "Rhizome Body"
	},
