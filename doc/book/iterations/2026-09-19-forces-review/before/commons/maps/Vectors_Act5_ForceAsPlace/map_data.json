  "map_info": {
    "name": "Vectors_Act5_ForceAsPlace",
    "lookup_name": "Vectors_Act5_ForceAsPlace",
    "title": "Force as Place",
    "description": "A local acceleration field over a five-row pit. Aim it with the machine, release a cube, then compare bodily carry with the retained solid plank. The field replaces gravity; contacts, damping and receiver controllers remain different.",
    "version": "vf-field-act5",
    "format": "json",
    "dimensions": {
      "width": 16,
      "depth": 24,
      "max_height": 3
    },
    "metadata": {
      "difficulty": "advanced",
      "category": "vectors_forces_field",
      "estimated_time": "6-10 minutes",
      "act": "V — force as place",
      "learning_objectives": [
        "Force field as place",
        "Dialing a field vector",
        "Field replaces gravity"
      ],
      "n_artifacts": 6
    },
    "museum": {
      "basin": {
        "depth": 3.0,
        "glass": false,
        "fire": false
      },
      "artifact_placement": "map",
      "gate_depth_rows": 0,
      "sculpture_clear_rects": [
        [
          1,
          1,
          14,
          22
        ]
      ]
    }
  },
  "subtitles": {
    "intro": {
      "text": "Two routes over a pit. Aim the local field, test a cube, then enter. Inside, the field owns locomotion; the plank remains.",
      "speaker": "Act V",
      "level": 1
    },
    "truth_machine": {
      "text": "The machine posts one vector into the field over the void. Down, and things fall; up-and-across, and they're carried over.",
      "speaker": "Vector machine",
      "level": 1
    },
    "truth_void": {
      "text": "Zero acceleration does not mean zero velocity. What motion did you bring into this place?",
      "speaker": "The void",
      "level": 1
    },
    "truth_complete": {
      "text": "What carried you: the plank, your incoming motion, or the field? Where did ordinary walking take over again?",
      "speaker": "Reflection",
      "level": 1
    }
  },
