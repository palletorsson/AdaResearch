+func room_perspective() -> void:
+	# Parallel marks belong to the room. Their convergence is made by the view.
+	var ink := Color("202329")
+	for x in [-10.5,10.5]:
+		paint(Vector3(x,0.025,-8.15),Vector3(x,0.025,17.9),0.045,ink)
+		for k in range(13):
+			var z: float = -7.5 + float(k)*2.0
+			paint(Vector3(x-0.12,0.028,z),Vector3(x+0.12,0.028,z),0.025,ink)
+	# The museum is open to the sky. These two narrow soffits give the drawing
+	# real ceiling edges without closing the hall. Height comes from its owner.
+	var ceiling_y: float = DETAIL.CEIL_SOFFIT
+	var edge_y := ceiling_y-0.025
+	for x in [-12.29,12.29]:
+		var soffit := MeshInstance3D.new()
+		soffit.name="CeilingStripLeft" if x<0 else "CeilingStripRight"
+		var box := BoxMesh.new();box.size=Vector3(0.42,0.12,26.4)
+		soffit.mesh=box;soffit.position=Vector3(x,ceiling_y+0.06,4.75)
+		var mat := StandardMaterial3D.new();mat.albedo_color=Color("e5e1d8");mat.roughness=0.9
+		soffit.material_override=mat;add_child(soffit)
+		var edge_x: float = -12.08 if x<0 else 12.08
+		paint(Vector3(edge_x,edge_y,-8.45),Vector3(edge_x,edge_y,17.95),0.05,ink)
+	# The nearer line lies on the same eye-rays as part of the left ceiling
+	# edge. A sideways step breaks that alignment; no camera or head is moved.
+	var eye := Vector3(-4,1.65,-7)
+	var edge_a := Vector3(-12.08,edge_y,-5.5)
+	var edge_b := Vector3(-12.08,edge_y,16.5)
+	var fraction := 0.55
+	var a := eye.lerp(edge_a,fraction)
+	var b := eye.lerp(edge_b,fraction)
+	paint(a,b,0.05*fraction,ink)
+	get_child(get_child_count()-1).name="DetachedCeilingLine"
+	set_meta("alignment_eye",eye)
+	set_meta("alignment_edge",[edge_a,edge_b])
+	set_meta("alignment_line",[a,b])
+	# A discreet place to begin looking; an invitation, not a required camera.
+	paint(Vector3(-4.35,0.012,-7),Vector3(-3.65,0.012,-7),0.045,ink)
+	floor_words("LOOK UP. STEP ASIDE.",Vector3(-4,0.016,-7.55),Vector2(3.3,0.2))
