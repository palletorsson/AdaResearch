extends "res://tools/probes/transformation_encounters.gd"
const Journey=preload("res://tools/probes/array_entered_address.gd")
var party:Node3D
var actor:CharacterBody3D
var driver:Journey.KeyJourney
var completed:=false
var paths:Array=[]

func press(index:int) -> void:
	var area:Node3D=party.buttons[index].get_node("InteractableAreaButton")
	XRToolsPointerEvent.pressed(camera,area,area.global_position)
	XRToolsPointerEvent.released(camera,area,area.global_position)
	await create_timer(0.15).timeout

func travel(point:Vector3) -> bool:
	driver.target=party.to_global(point);driver.arrived=false;driver.moving=true
	var start:=Time.get_ticks_msec()
	while not driver.arrived and Time.get_ticks_msec()-start<8000:await physics_frame
	driver.moving=false;driver.release()
	paths.append({"target":xyz(point),"reached":xyz(party.to_local(actor.global_position)),"arrived":driver.arrived})
	return driver.arrived

func landing_checks() -> void:
	root.size=Vector2i(1440,960)
	var grid:Node3D=hall.get_node_or_null("SimGrid_Color_Rainbow")
	check("authored grid present",grid!=null)
	if grid==null:return
	for frame in 3600:
		if grid.has_meta("stage_grid_ready"):break
		await process_frame
	check("grid completed",grid.has_meta("stage_grid_ready"))
	party=find_scene("/rainbow_celebration.gd")
	check("current rainbow celebration placed",party!=null)
	if party==null:return
	check("five familiar cubes placed along level walk",party.walk_pickups.get_child_count()==5)
	var ignored := Node3D.new()
	root.add_child(ignored)
	for cube in party.walk_pickups.get_children():
		cube._on_detection_area_body_entered(ignored)
		check(cube.name+" ignores scenery and detects desktop plus VR",not cube.has_been_collected and cube.get_node("DetectionArea").collision_mask==(1 | (1 << 19)))
		var blockers:=false
		for body in cube.find_children("*","StaticBody3D",true,false):blockers=blockers or body.collision_layer!=0
		check(cube.name+" does not obstruct the walk",not blockers)
	ignored.queue_free()
	check("finish banner has two poles and six stripes",party.has_node("FinishPoleLeft") and party.has_node("FinishPoleRight") and party.find_children("FinishBannerStripe_*","MeshInstance3D",false,false).size()==6)
	var lowest:=100.0
	for stripe in party.find_children("FinishBannerStripe_*","MeshInstance3D",false,false):
		for v in stripe.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:lowest=minf(lowest,v.y)
	check("banner cloth clears floor by at least 2.8 metres",lowest>=2.8)
	check("arrival starts with six bands and two controls",party.arch.rainbow_colors.size()==6 and party.buttons.size()==2)
	var poses:Array=[]
	for tile in party.tiles:poses.append(tile.global_transform)
	var original_arch:Transform3D=party.arch.global_transform
	party.set_process(false)
	var bounds:Array=[]
	for count in [6,7,48,2]:
		if count!=6:await press(0)
		party._process(4.0) # End confetti for identical, unobscured comparison views.
		check(str(count)+" bands generated by actual control",party.arch.rainbow_colors.size()==count and party.arch._arc_roots[0].get_child_count()==count and party.arch._arc_roots[1].get_child_count()==count)
		var unchanged:=true
		for i in party.tiles.size():unchanged=unchanged and party.tiles[i].global_transform.is_equal_approx(poses[i])
		check(str(count)+" leaves all fourteen route pieces fixed",unchanged and party.tiles.size()==14)
		var band:MeshInstance3D=party.arch._arc_roots[0].get_child(0)
		var vertices:PackedVector3Array=band.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
		var width:float=band.to_global(vertices[0]).distance_to(band.to_global(vertices[1]))*count
		var opening:float=party.arch.global_basis.x.length()*30.0
		check(str(count)+" keeps world band width 1.288m and opening 6.9m",absf(width-1.288)<0.001 and absf(opening-6.9)<0.001)
		check(str(count)+" arch is still display geometry without collision",party.arch.find_children("*","CollisionObject3D",true,false).is_empty() and party.arch.global_transform.is_equal_approx(original_arch))
		bounds.append({"bands":count,"local_width":party.arch._band_thickness()*count,"world_width_m":width,"opening_diameter_m":opening})
		await snapshot("bands-"+str(count),party.to_global(Vector3(0,1.65,10.0)),party.to_global(Vector3(0,3.05,-2)),67)
	check("eight low steps retain collision",party.tiles.slice(0,8).all(func(tile):return tile.find_children("*","StaticBody3D",true,false).size()==1))
	await press(0)
	check("four presses return to six bands",party.mode_index==0 and party.arch.rainbow_colors.size()==6)
	var amount:int=party.confetti.multimesh.instance_count
	var event_count:int=party.celebration_count
	await press(1);party._process(0.8)
	check("CELEBRATE starts another bounded pool",party.celebration_count==event_count+1 and amount==96 and party.confetti.visible)
	await snapshot("celebration",party.to_global(Vector3(0.4,1.65,8.8)),party.to_global(Vector3(0,3,-1)),73)
	party._process(3.6)
	check("confetti ends without increasing instance count",not party.confetti.visible and party.confetti.multimesh.instance_count==amount)
	await snapshot("banners",party.to_global(Vector3(-3.1,1.65,7)),party.to_global(Vector3(-4.8,2.75,3.8)),62)
	await snapshot("dressed-mushrooms",party.to_global(Vector3(1.4,1.65,7)),party.to_global(Vector3(4.3,1.65,2.4)),65)
	# Supplied desktop keys drive the actual body through each pickup volume.
	party.set_process(true)
	actor=museum.get("_player");actor.global_position=party.to_global(Vector3(0,0.05,9));actor.velocity=Vector3.ZERO
	museum.set("_dollhouse",false)
	driver=Journey.KeyJourney.new();driver.world=museum;driver.actor=actor;driver.view=museum.get("_cam");root.add_child(driver)
	await create_timer(0.25).timeout
	var score_before:int=root.get_node("GameManager").player_score
	event_count=party.celebration_count
	await snapshot("walk-before",party.to_global(Vector3(0.65,1.65,6.1)),party.to_global(Vector3(0,2.1,-5)),76)
	check("ordinary walking enters welcome patch on level route",await travel(Vector3(0,0.05,5)))
	check("body crossing welcomes without button press",party.celebration_count==event_count+1)
	var tails:Array=[]
	for i in range(5):
		var z:float=4.2-i*2.1
		check("walk collects cube "+str(i+1),await travel(Vector3(0,0.05,z-0.7)))
		await create_timer(0.1).timeout
		check("collection count follows crossings "+str(i+1),party.collected_cubes==i+1)
		check("a bounded spark burst follows crossing "+str(i+1),party.spark_bursts.get_child_count()>0 and party.spark_bursts.get_child_count()<=5)
		var burst:Node3D=party.spark_bursts.get_child(party.spark_bursts.get_child_count()-1)
		check("sparks have sampled tails rather than dots "+str(i+1),burst.trails.multimesh.instance_count==392)
		var longest:=0.0
		for k in range(28):
			var length:=0.0
			for j in range(14):length+=burst.trails.multimesh.get_instance_transform(k*14+j).basis.y.length()
			longest=maxf(longest,length)
		tails.append({"cube":i+1,"age":burst.elapsed,"longest_tail_m":longest})
		check("visible tail longer than one metre "+str(i+1),longest>1.0)
		var aligned:=true
		for k in range(28):
			var front:Vector3=burst._point(k,burst.elapsed)
			var back:Vector3=burst._point(k,maxf(0.0,burst.elapsed-0.75/14.0))
			var transform:Transform3D=burst.trails.multimesh.get_instance_transform(k*14)
			if transform.basis.y.length()>0.0001:
				aligned=aligned and transform.basis.y.normalized().dot((front-back).normalized())>0.999
		check("spark segments follow their actual flight direction "+str(i+1),aligned)
		if i==1:
			for live in party.spark_bursts.get_children():live.set_process(false)
			await snapshot("walk-sparks",party.to_global(Vector3(1.5,1.65,4.7)),party.to_global(Vector3(0,1.9,-0.7)),78)
			for live in party.spark_bursts.get_children():live.set_process(true)
	check("collecting all five leaves global score unchanged",root.get_node("GameManager").player_score==score_before)
	check("ordinary walking passes under the two-pole banner",await travel(Vector3(0,0.05,-8)))
	check("body remains at floor level after banner",absf(party.to_local(actor.global_position).y)<0.12 and actor.is_on_floor())
	await snapshot("finish-banner",party.to_global(Vector3(0.7,1.65,-3.6)),party.to_global(Vector3(0,3.75,-7)),88)
	await create_timer(3.0).timeout
	check("spent cubes and tails clean up",party.walk_pickups.get_child_count()==0 and party.spark_bursts.get_child_count()==0)
	check("ordinary walking returns along level route",await travel(Vector3(0,0.05,9)))
	check("return can trigger another welcome",party.celebration_count==event_count+2)
	check("return does not recollect spent cubes",party.collected_cubes==5)
	await press(1)
	check("CELEBRATE remains usable after collecting all cubes",party.confetti.visible and party.collected_cubes==5)
	observations["width_measurements"]=bounds
	observations["walks"]=paths
	observations["tails"]=tails
	observations["banner_clearance_m"]=lowest
	observations["figure_scope"]="Native museum. Walk-before and banner are selected eye-height views. Walk-sparks pauses existing particle updates at their reached time for one capture; no synthetic particles added. Supplied keyboard journey uses actual museum controller."

	completed=true

func finish() -> void:
	if driver!=null:driver.release();driver.set_physics_process(false)
	check("focused encounter completed",completed)
	FileAccess.open(folder+"report.json",FileAccess.WRITE).store_string(JSON.stringify({"room":map_id,"checks":checks,"failures":failures,"observations":observations,"passed":failures.is_empty(),"scope":"Isolated production museum. Supplied pointer events and keyboard journey using the ordinary controller. Native renders and world-space mesh measurements. No tracked-controller reach, headset comfort, learner or performance claim. Local celebration extended; other rainbow stages and global pickups preserved."},"  "))
	print("RAINBOW WALK ",checks.size()-failures.size(),"/",checks.size())
	quit(0 if failures.is_empty() else 1)
