+## A retained skirt mesh lengthens and fills; fabric/UV addresses stay its own.
+## The visit supplies the target. Time only eases towards that target.
+func set_growth(value: int, maximum: int = 24, animate: bool = false) -> void:
+	growth_enabled = true
+	growth_stage = clampi(value, 0, maxi(1, maximum))
+	var target := float(growth_stage) / float(maxi(1, maximum))
+	if _growth_tween and _growth_tween.is_valid():
+		_growth_tween.kill()
+	if animate and is_inside_tree() and not is_equal_approx(_growth_amount, target):
+		_growth_tween = create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
+		_growth_tween.tween_method(_apply_growth, _growth_amount, target, 1.4)
+	else:
+		_apply_growth(target)
+
+
+func _apply_growth(amount: float) -> void:
+	_growth_amount = clampf(amount, 0.0, 1.0)
+	var skirt := get_node_or_null("Skirt") as MeshInstance3D
+	if skirt == null:
+		return
+	var shape := skirt.mesh as CylinderMesh
+	if shape == null:
+		return
+	var width := lerpf(0.65, 1.15, _growth_amount)
+	shape.height = lerpf(0.50, 0.90, _growth_amount)
+	shape.bottom_radius = (0.26 if look_id == "holo_fan" else 0.43) * width
+	skirt.position.y = SKIRT_WAIST - shape.height * 0.5
+	for trim in _growth_trims:
+		var rest: Vector3 = trim.rest
+		trim.node.position = Vector3(rest.x * width, SKIRT_WAIST + (rest.y - SKIRT_WAIST) * shape.height / 0.85, rest.z * width)
