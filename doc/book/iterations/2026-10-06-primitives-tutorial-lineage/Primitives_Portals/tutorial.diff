+<!-- student-code:circle_samples.gd -->
 ```gdscript
-var divisions := 6
-var radius := 1.0
-var tolerance := 0.01
+extends RefCounted
+# Supplied circle sampler. Angles return in the Waves sequence.
+static func make(sides: int, radius: float) -> Array[Vector3]:
+    assert(sides >= 3 and radius > 0.0)
+    var points: Array[Vector3] = []
+    for side in range(sides):
+        var angle := TAU * side / sides
+        points.append(Vector3(cos(angle), 0, sin(angle)) * radius)
+    return points
 ```

-Change `divisions` to `12`, then `24`, then `48`, running the scene after each edit. Keep the radius fixed. Watch the corners become less visible and the measured shortfall decrease. Walk closer when a corner becomes hard to see.
