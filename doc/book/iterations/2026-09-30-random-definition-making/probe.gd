extends "res://tools/probes/transformation_encounters.gd"
func landing_checks() -> void:
	museum.flush_stamps()
	await create_timer(2.0).timeout
	var bench := find_scene("/seed_replay_demo.gd")
	check("replay instrument present",bench!=null)
	if bench==null:return
	check("wall display has paired 8 by 8 grids",bench.wall_display and bench.column_count()==2 and bench.column_colors(0).size()==64)
	bench.apply_grid_config({"seed":42})
	if bench.extra_on():bench.toggle_extra_draw()
	var left: PackedColorArray=bench.column_colors(0)
	check("same seed and procedure match",left==bench.column_colors(1))
	bench.replay()
	check("replay reconstructs colours",left==bench.column_colors(0))
	await snapshot("museum-matched",bench.to_global(Vector3(0,2.0,4.0)),bench.to_global(Vector3(0,1.9,0)),56)
	bench.toggle_extra_draw()
	check("extra draw changes only right palette",left==bench.column_colors(0) and left!=bench.column_colors(1))
	var stream: PackedFloat32Array=bench.raw_prefix(0,25)
	check("right bars begin one draw later",stream.slice(1,25)==bench.raw_prefix(1,24))
	var wanted:=PackedColorArray()
	var independent:=RandomNumberGenerator.new()
	independent.seed=42
	independent.randf()
	for i in range(64):wanted.append(Color(independent.randf(),independent.randf(),independent.randf()))
	check("offset colours match independent generator",wanted==bench.column_colors(1))
	await snapshot("museum-offset",bench.to_global(Vector3(0,2.0,4.0)),bench.to_global(Vector3(0,1.9,0)),56)
	bench.apply_grid_config({"seed":137})
	if not bench.extra_on():bench.toggle_extra_draw()
	await process_frame
	var saved: Dictionary=bench.capture_museum_state()
	var before: PackedColorArray=bench.column_colors(1)
	bench.randomize_seed()
	var next_seed: int=bench.current_seed()
	bench.restore_museum_state(saved)
	check("restoration recovers seed and flag",bench.current_seed()==137 and bench.extra_on())
	check("restoration recovers colours",bench.column_colors(1)==before)
	bench.randomize_seed()
	check("restoration recovers picker",bench.current_seed()==next_seed)
	var portal: Node=load("res://commons/scenes/em/em_portal_stream.gd").new()
	bench.restore_museum_state(saved)
	portal._save_state(hall)
	bench.apply_grid_config({"seed":7})
	bench.toggle_extra_draw()
	portal._restore_state(hall)
	check("portal caller restores experiment",bench.current_seed()==137 and bench.extra_on() and bench.column_colors(1)==before)
	portal.free()
	bench.apply_grid_config({"seed":42})
	if bench.extra_on():bench.toggle_extra_draw()
	observations["scope"]="Actual museum artifact and direct portal-state methods; no physical portal crossing, headset or learner trial."
