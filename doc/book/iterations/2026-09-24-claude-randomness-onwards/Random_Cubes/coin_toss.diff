+## THE DESKTOP CARRY (DesktopInteractionPointer) emits neither picked_up nor dropped.
+## It calls on_desktop_grab / on_desktop_drop on the body's desktop_hook_target, and
+## on release it puts back the freeze the body had before the carry. A tray coin is
+## frozen, so without this hook a dropped coin would hang in the air, never read.
+## One small hook per coin, because the pointer passes itself, not the body.
+class _DesktopCoinHook extends RefCounted:
+	var _owner_ref: WeakRef
+	var _coin_ref: WeakRef
+
+	func _init(owner_node: Object, coin: RigidBody3D) -> void:
+		_owner_ref = weakref(owner_node)
+		_coin_ref = weakref(coin)
+
+	func on_desktop_grab(_pointer) -> void:
+		var o: Object = _owner_ref.get_ref()
+		var c: Object = _coin_ref.get_ref()
+		if o != null and c != null:
+			o.call("_on_coin_picked_up", null, c)
+
+	func on_desktop_drop(_pointer) -> void:
+		var o: Object = _owner_ref.get_ref()
+		var c: RigidBody3D = _coin_ref.get_ref() as RigidBody3D
+		if o == null or c == null:
+			return
+		c.freeze = false          # as the XR pickable's UNFROZEN release does
+		o.call("_on_coin_dropped", null, c)
+
+
+## The stillness window for one coin, kept in its state dictionary.
+func _coin_still(coin: RigidBody3D, state: Dictionary) -> bool:
+	var o: Vector3 = coin.global_position
+	var n: Vector3 = coin.global_transform.basis.y.normalized()
+	if not state.has("still_o"):
+		state["still_o"] = o
+		state["still_n"] = n
+		return false
+	var tipped: bool = absf(n.y) < 0.8
+	if o.distance_to(state["still_o"]) > 0.01 or n.angle_to(state["still_n"]) > 0.35 or tipped:
+		state["still_o"] = o
+		state["still_n"] = n
+		return false
+	return true
+
+
 func _on_coin_picked_up(_pickable, coin: RigidBody3D) -> void:
 	if not is_instance_valid(coin):
 		return
