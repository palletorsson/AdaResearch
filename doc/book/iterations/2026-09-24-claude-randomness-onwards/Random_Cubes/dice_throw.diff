+const SETTLE_TOP_DOT := 0.95      # the top face within about 18 degrees of up
+const SETTLE_HEIGHT_M := 0.01     # and the centre held within 1 cm of height
+var _still_armed: bool = false
+var _still_face: int = -1
+var _still_y: float = 0.0
+
+
+## True while the same face has stayed on top, near vertical, at a steady height.
+## Rocking and turning that keep the top face within about 18 degrees of up are
+## ignored: they cannot change the reported face, and at 60 Hz a landed die on
+## this felt keeps rocking (measured 2026-09-24: about 5 rad/s about a mostly
+## horizontal axis, top face within 2.5-6 degrees of up, never sleeping).
+## Restarts the window whenever the top face, its tilt or the height changes.
+func _still_window(_delta: float) -> bool:
+	var xf: Transform3D = _dice_body.global_transform
+	var best_face := 0
+	var best_dot := -2.0
+	for i in range(6):
+		var d: float = (xf.basis * FACE_NORMALS[i]).normalized().dot(Vector3.UP)
+		if d > best_dot:
+			best_dot = d
+			best_face = i
+	var moved: bool = absf(xf.origin.y - _still_y) > SETTLE_HEIGHT_M
+	if not _still_armed or best_face != _still_face or best_dot < SETTLE_TOP_DOT or moved:
+		_still_armed = true
+		_still_face = best_face
+		_still_y = xf.origin.y
+		return false
+	return true
+
+
 func _on_dice_dropped(_pickable) -> void:
 	_is_rolling = true
 	_settle_timer = 0.0
+	_still_armed = false
 
 
 func _on_dice_picked_up(_pickable) -> void:
 	# Stop any settle sampling while the player is holding the die
 	_is_rolling = false
 	_settle_timer = 0.0
+	_still_armed = false
+
+
+## Desktop carry: the same handlers the XR signals reach. The carry lets go with
+## no velocity, so a desktop "throw" is a drop from the held orientation.
+func on_desktop_grab(_pointer) -> void:
+	_on_dice_picked_up(null)
+
+
+func on_desktop_drop(_pointer) -> void:
+	_on_dice_dropped(null)
 
 
