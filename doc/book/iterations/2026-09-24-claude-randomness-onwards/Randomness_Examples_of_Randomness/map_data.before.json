	  "estimated_time": "6-8 minutes",
	  "learning_objectives": [
		"Identify the choices and constraints in a Pollock-inspired generative painting",
		"Estimate a circle's area fraction by uniform point sampling",
		"Distinguish bounded pipe growth from a self-avoiding or guaranteed space-filling path",
        "Compare five particle update rules without treating them as one independent random process"
	  ]
