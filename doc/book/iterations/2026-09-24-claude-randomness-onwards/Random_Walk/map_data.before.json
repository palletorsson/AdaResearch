  "map_info": {
    "name": "Random Walk",
    "title": "The trail is already elsewhere",
    "lookup_name": "Random_Walk",
    "description": "A seeded glass walk exposes step proposals, reflected endpoints, retained trails and two clocks. A raised-cell terrain and a held drawing point show what happens when the same family of rules meets ground or hand.",
