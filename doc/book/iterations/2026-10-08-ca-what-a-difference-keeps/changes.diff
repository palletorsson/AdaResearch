+
+func make_display() -> void:
+	box(self, Vector3(2.95, 0.08, 1.5), Vector3(0, 1.0, 0), Color("e4dfd4"), true)
+	for side in 2:
+		var cx := -0.85 if side == 0 else 0.85
+		box(self, Vector3(0.6, 0.96, 0.6), Vector3(cx, 0.48, 0), Color("e4dfd4"))
