    "The interpolation": {
      "act": "III - the skin",
      "truth": "WHERE between two corners does the surface cross? Snap to the midpoint and it is blocky; interpolate on the field values and it is smooth. Same cases, different world.",
      "tiers": {
        "small": [],
        "medium": [],
        "large": [],
        "applied": []
      },
      "count": 0,
      "thin": true
    },
    "The normal from the field": {
      "act": "III - the skin",
      "truth": "the gradient of the field IS the surface normal - lighting comes free from the same function that made the shape, because a field knows which way it thickens.",
      "tiers": {
        "small": [],
        "medium": [],
        "large": [],
        "applied": []
      },
      "count": 0,
      "thin": true
    },
    "Metaballs & implicit sums": {
      "act": "IV - what fields can be",
      "truth": "sum a few smooth fields and where they cross the threshold they MERGE: two blobs become one skin with no seam, which no mesh operation gives you.",
      "tiers": {
