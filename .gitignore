tools/claude_http_context.json

# Next.js build artifacts (nested encyclopedia clone)
ada_encyclopedia/

# Scratch + per-render staging dirs (auto-generated config outputs of
# mesh_grammar / substrate / artifact research pipelines)
_tmp_*
tmp_*
**/_staging/

# Auto-regenerated report — changes on every analysis run
doc/HEAT_MAP.json

# Auto-generated gallery / research outputs (per-render outputs of
# build_gallery_best_of_manifest and similar tools)
commons/generated/

# Generated capture images — these are written by Godot capture scripts
# and Python research tools, then served by the ada_encyclopedia
# (see tools/move_uncommitted_images.py for the one-time migration).
# Never commit them to this repo.
ada_run/captures/
commons/maps/*/map_iso.png
commons/maps/*/map_top.png
commons/maps/*/*.jpg
doc/reports/map_comparisons/
doc/reports/map_strategies/

# Chamber research material (proposals, patches, captures) lives in
# ada_encyclopedia/public/chamber-runs/, NOT here. This guard catches
# accidental writes to the Godot repo in case chamber.py is run with a
# misconfigured ADA_ENCYCLOPEDIA_PATH.
/data/chamber/
backups/
commons/maps/FoldStudio_Preview/

# =============================================================================
# Generated evidence images live in ada_encyclopedia/public/, never on GitHub here.
# This repo had 6,010 tracked images (68 MB) under doc/ before this rule; the sweep
# and capture tools keep WRITING locally (the bite tooling reads sheets beside their
# _bite.json), but the images themselves are published in the encyclopedia:
#   doc/reports/*.png            -> public/doc-reports/
#   doc/placement_research/*.svg -> public/placement-research/
doc/reports/*.png
doc/reports/**/*.png
doc/reports/*.jpg
doc/placement_research/*.svg
doc/placement_research/*.png
ada_run/*.png
ada_run/_trial_em_overrides.json

# commons/data/museum/ is the museum's HOME (2026-10-08): em_plan.json, em_bake.json and
# em_overrides.json are tracked, generated-but-committed. What still only travels there
# by tools/em_ship.py stays out: the live channel, the engine's own walk record (rewritten
# on every walk), the hand's dealing, the trunk copy and the compiled cartridges.
commons/data/museum/em_control.json
commons/data/museum/em_layout_walk.json
commons/data/museum/necklace_hand.json
commons/data/museum/trunk_branches.json
commons/data/museum/cartridges/
commons/data/museum/.gdignore

# The necklace's dealing order (tools/necklace_order.py). Of its three files
# exactly ONE is a source: commons/data/spine_order_ops.json, the hand, 1 KB of
# ordered edits, and it is TRACKED — tracked is what makes an undo real, and it
# was the only untracked one of the three while being the only irreplaceable one.
# The other two are derived by `--apply` and rebuilt from the ops in seconds:
#   spine_order_effective.json    838 KB, read by the Godot necklace scene
#   spine_artifact_order_hand.json  the museum's copy, written only when the
#                                   hand has something to say (endless_museum.gd
#                                   reads that path FIRST when it exists, so an
#                                   empty-handed commit of it would freeze the
#                                   museum on the artifacts that existed that day)
# .bak/.tmp are the atomic writer's residue: the previous good hand, and an
# interrupted write. Local recovery material, never history.
commons/data/spine_order_effective.json
commons/data/spine_artifact_order_hand.json
commons/data/spine_order_ops.json.bak
commons/data/spine_order_ops.json.tmp

# The museum walk order (tools/museum_necklace.py --apply). Derived from the
# 207 hall maps and ada_run/em_pack_report.json in 0.16 s, 1.1 MB, and rebuilt
# by --apply. Same rule as the spine order beside it: the SOURCE is the tool,
# not its output.
commons/data/museum_order_effective.json

# -- EVIDENCE IMAGES DO NOT ENTER GIT (2026-09-14) -----------------------------
# Palle: "we also need to ... redirect to ada encyclopedia so we do not [get] more of
# the images etc in the repo." Evidence lives in ada_encyclopedia/captures/ now
# (tools/evidence_root.py, commons/testing/evidence_root.gd, tools/sweep_evidence.py).
#
# Not every writer can follow. The WCN probes save their screenshots to the evidence
# root; the review builders cannot, because they stage a Godot scene under
# res://ada_run/<run>/ and Godot loads scenes only from inside the project. So git
# refuses the images instead, for every writer at once, whatever path it still uses.
# Already-tracked files stay tracked.
#
# Checked before writing: no game file (commons/, algorithms/, addons/ outside
# commons/testing) names an image under ada_run/ -- every one is a probe screenshot --
# and em_cartridges/ holds no images. Game data here is JSON and scenes, untouched.
ada_run/**/*.png
ada_run/**/*.jpg
ada_run/**/*.jpeg
ada_run/**/*.webp
ada_run/**/*.gif
ada_run/**/*.exr
ada_run/**/*.png.import
ada_run/**/*.jpg.import
ada_run/**/*.webp.import
doc/reports/**/*.png
doc/reports/**/*.jpg
doc/reports/**/*.jpeg
doc/reports/**/*.webp
doc/reports/**/*.gif
doc/reports/**/*.png.import
doc/reports/**/*.jpg.import

# Local Claude checkouts are worktrees, not distributable submodules.
/.claude/worktrees/

# Ada's surface-grip extension overlays XR Tools 4.5.1. Keep the small overlay
# and upstream license, while continuing to ignore the installed addon bundle.
!/addons/godot-xr-tools/
/addons/godot-xr-tools/*
!/addons/godot-xr-tools/LICENSE
!/addons/godot-xr-tools/hands/
/addons/godot-xr-tools/hands/*
!/addons/godot-xr-tools/hands/hand.gd
!/addons/godot-xr-tools/hands/surface_grip.gd
!/addons/godot-xr-tools/hands/surface_grip_pose.gd
!/addons/godot-xr-tools/objects/
/addons/godot-xr-tools/objects/*
!/addons/godot-xr-tools/objects/grab_points/
/addons/godot-xr-tools/objects/grab_points/*
!/addons/godot-xr-tools/objects/grab_points/grab.gd
# Keep the per-instance viewport texture fix across XRTools reinstalls/reviews.
!/addons/godot-xr-tools/objects/viewport_2d_in_3d.tscn
/ada_run/auto-hand-2026-10-05/

# ada_run is DERIVED (CLAUDE.md): plans, bakes, probes, captures, feedback that
# spine_run, the Godot bake and the tools regenerate. Palle, 2026-10-08: it does
# not belong in the repo. The files stay on disk - the museum reads em_plan.json
# and em_bake.json from here at runtime and the export packs ada_run/*.json -
# they just never enter git again. The partial ada_run/ rules above are kept.
/ada_run/

# Images do not live in this repo (Palle, 2026-10-08: "I do not want images in the git repo. I
# want the images in ada encyclopedia"). The ones the book and the blog link to are copied to
# ada_encyclopedia/public/book-images/ and linked as /book-images/...; review evidence stays on
# disk under doc/ and is served locally by /book-review/, never committed. Game assets keep their
# .import sidecar and live outside doc/.
doc/**/*.png
doc/**/*.jpg
doc/**/*.jpeg
doc/**/*.gif
doc/**/*.webp
doc/**/*.bmp

