# =============================================================================
# Ada Research VR Project - Enhanced .gitignore
# =============================================================================

# Godot 4+ Core Files
# =============================================================================
.godot/
.import/
.nomedia

# Project Directories to Exclude
# =============================================================================
/addons/*
!/addons/audio_catalog_editor/
!/addons/audio_catalog_editor/**
!/addons/map_sequence_editor/
!/addons/map_sequence_editor/**
!/addons/element_editor/
!/addons/element_editor/**
!/addons/void_floor_editor/
!/addons/void_floor_editor/**
!/addons/quest_game_export/
/addons/quest_game_export/*
!/addons/quest_game_export/plugin.cfg
!/addons/quest_game_export/plugin.gd
!/addons/quest_game_export/exporter.gd
!/addons/quest_game_export/runtime-trial-files.json
/build/
/assets/
/android/

# Out-of-project archive — auto-research maps, captures, narrations, and
# other artifacts the Godot project produces but doesn't load. Files stay
# on disk for tooling (preset clusterer, etc.) but never enter the repo.
# See _archive/README.md for layout. Per-subdir .gdignore files tell
# Godot's importer to skip them as well.
/_archive/
/ada_run/captures/
/ada_run/narrations/
/ada_run/noc_vr_shots/
/ada_run/artifact_measurements.json
/ada_run/*.checkpoint.json
/ada_run/*.progress.txt
/ada_run/*.skip_list.txt
/ada_run/capture_daemon.pid
# THE MUSEUM'S OWN LAYOUT RECORD — 5.4 MB, and endless_museum.gd rewrites it
# every time it builds a hall, so tracking it would churn the repo on every walk.
# It is not lost: tools/long_museum.py folds it into commons/data/long_museum.json,
# which IS tracked and is what /wall-map and /long-museum read. Regenerate the raw
# record with `python tools/em_bake.py` (~6 min, 196 halls).
/ada_run/em_layout_walk.json

# Claude Code worktree leftovers — disposable session dirs.
/commons/maps/tmpclaude-*


# Godot Export & Build Files
# =============================================================================
export.cfg
export_credentials.cfg
*.tmp
*.bak
*.swp
*~.nib
local.properties
.buildpath
.project
.metadata
tmp/
*.tmp
*.bak
*.swp
*~.nib

# Imported translations (automatically generated from CSV files)
# =============================================================================
*.translation

# Mono/C# specific ignores
# =============================================================================
.mono/
# Anchored to the repo root ON PURPOSE. Unanchored, data_*/ matched every
# artifact folder named data_something at any depth -- and because git will
# not descend into an excluded DIRECTORY, the !*.gd / !*.tscn re-includes
# below cannot rescue what is inside one. It swallowed three artifacts
# (data_tree_walker, data_locality_caching, data_labor_counter) and broke
# five tracked maps for anybody but the author. Godot's C# build output
# lives at the root, so the root is where the rule belongs.
/data_*/
mono_crash.*.json
*.booproj
*.pidb
*.suo
*.user
*.userprefs
*.usertasks
*.DS_Store

